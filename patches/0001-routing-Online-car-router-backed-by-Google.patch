+
+// Roads are laid out in degrees around the equator, where 1e-4 deg is roughly 11 m in both axes.
+// Working in degrees (rather than metres) keeps the fixtures readable and lets the matcher's
+// mercator maths run for real.
+double constexpr kDeg = 1e-4;
+
+std::vector<m2::PointD> Reference(std::vector<std::pair<double, double>> const & lonLatDegrees)
+{
+  std::vector<m2::PointD> out;
+  out.reserve(lonLatDegrees.size());
+  for (auto const & p : lonLatDegrees)
+    out.push_back(mercator::FromLatLon(p.second * kDeg, p.first * kDeg));
+  return out;
+}
+
+RoadGeometry::Points Road(std::vector<std::pair<double, double>> const & lonLatDegrees)
+{
+  RoadGeometry::Points out;
+  for (auto const & p : lonLatDegrees)
+    out.emplace_back(mercator::FromLatLon(p.second * kDeg, p.first * kDeg));
+  return out;
+}
+
+// CarModel resolves types like hwtag/oneway through the classificator, so every fixture that builds
+// a car estimator has to load it first (same as astar_router_test and friends).
+std::unique_ptr<SingleVehicleWorldGraph> BuildGraph(std::unique_ptr<TestGeometryLoader> loader,
+                                                   std::vector<Joint> const & joints)
+{
+  classificator::Load();
+  return BuildWorldGraph(std::move(loader), CreateEstimatorForCar(traffic::TrafficCache()), joints);
+}
+
+CorridorMatchResult Match(std::unique_ptr<SingleVehicleWorldGraph> graph, FakeEnding const & start,
+                          FakeEnding const & finish, std::vector<m2::PointD> const & reference,
+                          CorridorMatchParams const & params = {})
+{
+  auto starter = MakeStarter(start, finish, *graph);
+  base::Cancellable const cancellable;
+  return MatchPolylineToGraph(*starter, reference, params, cancellable);
+}
+
+// --- 1. A straight road, reference laid along it -------------------------------------------------
+// The floor case. If this does not match exactly, nothing else is meaningful.
+
+UNIT_TEST(CorridorMatcher_StraightRoad_MatchesExactly)
+{
+  auto loader = std::make_unique<TestGeometryLoader>();
+  loader->AddRoad(0 /* featureId */, false /* oneWay */, 1.0 /* speed */,
+                  Road({{0, 0}, {10, 0}, {20, 0}, {30, 0}, {40, 0}}));
+
+  std::vector<Joint> const joints;
+  auto graph = BuildGraph(std::move(loader), joints);
+
+  auto const start = MakeFakeEnding(0 /* featureId */, 0 /* segmentIdx */, mercator::FromLatLon(0.0, 0.0), *graph);
+  auto const finish = MakeFakeEnding(0, 3, mercator::FromLatLon(0.0, 40 * kDeg), *graph);
+
+  auto const result = Match(std::move(graph), start, finish, Reference({{0, 0}, {40, 0}}));
+
+  TEST(result.m_ok, ("deviation", result.m_maxLateralDeviationM, "ratio", result.m_lengthRatio));
+  TEST_LESS(result.m_maxLateralDeviationM, 5.0, ());
+  TEST_LESS(result.m_lengthRatio, 1.05, ());
+}
+
+// --- 2. Divided road: two one-way carriageways ---------------------------------------------------
+// The failure that motivated this work. The reference travels the eastbound carriageway; the
+// westbound one runs ~11 m alongside. The old anchor-hop matcher would U-turn around the block
+// whenever a hop's pinned segment faced the wrong way, producing a path several times too long.
+// The length-ratio gate is what catches that, so assert on it directly.
+
+UNIT_TEST(CorridorMatcher_DividedOneWayPair_DoesNotUTurn)
+{
+  auto loader = std::make_unique<TestGeometryLoader>();
+  // Eastbound carriageway at lat 0, westbound at lat 1e-4 (~11 m north). Both one-way.
+  loader->AddRoad(0 /* featureId */, true /* oneWay */, 1.0 /* speed */, Road({{0, 0}, {20, 0}, {40, 0}}));
+  loader->AddRoad(1 /* featureId */, true /* oneWay */, 1.0 /* speed */, Road({{40, 1}, {20, 1}, {0, 1}}));
+  // Cross streets joining the carriageways at each end, so a U-turn is topologically possible.
+  loader->AddRoad(2 /* featureId */, false /* oneWay */, 1.0 /* speed */, Road({{0, 0}, {0, 1}}));
+  loader->AddRoad(3 /* featureId */, false /* oneWay */, 1.0 /* speed */, Road({{40, 0}, {40, 1}}));
+
+  std::vector<Joint> const joints = {
+      MakeJoint({{0, 0}, {2, 0}}),  // west end, eastbound carriageway
+      MakeJoint({{1, 2}, {2, 1}}),  // west end, westbound carriageway
+      MakeJoint({{0, 2}, {3, 0}}),  // east end, eastbound carriageway
+      MakeJoint({{1, 0}, {3, 1}}),  // east end, westbound carriageway
+  };
+  auto graph = BuildGraph(std::move(loader), joints);
+
+  auto const start = MakeFakeEnding(0, 0, mercator::FromLatLon(0.0, 0.0), *graph);
+  auto const finish = MakeFakeEnding(0, 1, mercator::FromLatLon(0.0, 40 * kDeg), *graph);
+
+  auto const result = Match(std::move(graph), start, finish, Reference({{0, 0}, {40, 0}}));
+
+  TEST(result.m_ok, ("deviation", result.m_maxLateralDeviationM, "ratio", result.m_lengthRatio));
+  // A block loop would be >= 2x. Anything near 1.0 means it drove straight down the carriageway.
+  TEST_LESS(result.m_lengthRatio, 1.15, ("Matched path doubled back"));
+}
+
+// --- 3. Parallel service road ---------------------------------------------------------------------
+// A frontage road ~22 m from the main road. The corridor must be tight enough that the matcher
+// stays on the road the reference actually describes.
+
+UNIT_TEST(CorridorMatcher_ParallelServiceRoad_PicksTheReferencedRoad)
+{
+  auto loader = std::make_unique<TestGeometryLoader>();
+  loader->AddRoad(0 /* featureId */, false, 1.0 /* speed */, Road({{0, 0}, {20, 0}, {40, 0}}));
+  // Service road 2e-4 deg (~22 m) north, deliberately faster so an unconstrained search prefers it.
+  loader->AddRoad(1 /* featureId */, false, 10.0 /* speed */, Road({{0, 2}, {20, 2}, {40, 2}}));
+  loader->AddRoad(2 /* featureId */, false, 1.0 /* speed */, Road({{0, 0}, {0, 2}}));
+  loader->AddRoad(3 /* featureId */, false, 1.0 /* speed */, Road({{40, 0}, {40, 2}}));
+
+  std::vector<Joint> const joints = {
+      MakeJoint({{0, 0}, {2, 0}}),
+      MakeJoint({{1, 0}, {2, 1}}),
+      MakeJoint({{0, 2}, {3, 0}}),
+      MakeJoint({{1, 2}, {3, 1}}),
+  };
+  auto graph = BuildGraph(std::move(loader), joints);
+
+  auto const start = MakeFakeEnding(0, 0, mercator::FromLatLon(0.0, 0.0), *graph);
+  auto const finish = MakeFakeEnding(0, 1, mercator::FromLatLon(0.0, 40 * kDeg), *graph);
+
+  CorridorMatchParams params;
+  params.m_corridorHalfWidthM = 15.0;  // narrower than the 22 m offset to the service road
+  auto const result = Match(std::move(graph), start, finish, Reference({{0, 0}, {40, 0}}), params);
+
+  TEST(result.m_ok, ("deviation", result.m_maxLateralDeviationM, "ratio", result.m_lengthRatio));
+  // Hopping onto the service road and back would show up as lateral deviation.
+  TEST_LESS(result.m_maxLateralDeviationM, 15.0, ("Strayed onto the service road"));
+}
+
+// --- 4. Long route ---------------------------------------------------------------------------------
+// The regression test for the p^N problem: the old design's success rate decayed with hop count, so
+// it worked for one or two blocks and failed for anything real. Success here must not depend on
+// length.
+
+UNIT_TEST(CorridorMatcher_LongRoute_SucceedsRegardlessOfLength)
+{
+  size_t constexpr kBlocks = 60;
+
+  auto loader = std::make_unique<TestGeometryLoader>();
+  std::vector<std::pair<double, double>> mainRoad;
+  for (size_t i = 0; i <= kBlocks; ++i)
+    mainRoad.emplace_back(static_cast<double>(i) * 10.0, 0.0);
+  loader->AddRoad(0 /* featureId */, false, 1.0 /* speed */, Road(mainRoad));
+
+  std::vector<Joint> const joints;
+  auto graph = BuildGraph(std::move(loader), joints);
+
+  auto const start = MakeFakeEnding(0, 0, mercator::FromLatLon(0.0, 0.0), *graph);
+  auto const finish = MakeFakeEnding(0, static_cast<uint32_t>(kBlocks - 1),
+                                     mercator::FromLatLon(0.0, static_cast<double>(kBlocks) * 10.0 * kDeg), *graph);
+
+  auto const reference = Reference({{0, 0}, {static_cast<double>(kBlocks) * 10.0, 0}});
+  auto const result = Match(std::move(graph), start, finish, reference);
+
+  TEST(result.m_ok, ("Long route failed:", "deviation", result.m_maxLateralDeviationM, "ratio", result.m_lengthRatio));
+  TEST_LESS(result.m_lengthRatio, 1.05, ());
+}
+
+// --- 5. Reference against a one-way ----------------------------------------------------------------
+// Genuinely unmatchable. The matcher must decline rather than invent a loop around the block; the
+// caller then falls back to raw geometry.
+
+UNIT_TEST(CorridorMatcher_AgainstOneWay_RejectsCleanly)
+{
+  auto loader = std::make_unique<TestGeometryLoader>();
+  // One-way running east; the reference asks to travel west along it.
+  loader->AddRoad(0 /* featureId */, true /* oneWay */, 1.0 /* speed */, Road({{0, 0}, {20, 0}, {40, 0}}));
+
+  std::vector<Joint> const joints;
+  auto graph = BuildGraph(std::move(loader), joints);
+
+  auto const start = MakeFakeEnding(0, 1, mercator::FromLatLon(0.0, 40 * kDeg), *graph);
+  auto const finish = MakeFakeEnding(0, 0, mercator::FromLatLon(0.0, 0.0), *graph);
+
+  auto const result = Match(std::move(graph), start, finish, Reference({{40, 0}, {0, 0}}));
+
+  TEST(!result.m_ok, ("Should not match against a one-way; ratio", result.m_lengthRatio));
+}
+
+// --- 6. Genuine self-revisit -----------------------------------------------------------------------
+// Not every doubling-back is an artifact: a reference may legitimately go out and come back (a
+// dead-end spur, a roundabout re-entry). The gate must not reject a path that faithfully follows
+// such a reference, so the ratio is computed against the reference's own length, not straight-line
+// distance.
+
+UNIT_TEST(CorridorMatcher_ReferenceRevisitsRoad_StillMatches)
+{
+  auto loader = std::make_unique<TestGeometryLoader>();
+  loader->AddRoad(0 /* featureId */, false /* oneWay */, 1.0 /* speed */, Road({{0, 0}, {20, 0}, {40, 0}}));
+
+  std::vector<Joint> const joints;
+  auto graph = BuildGraph(std::move(loader), joints);
+
+  // Out to the far end and back to the middle: the reference itself is the "detour".
+  auto const start = MakeFakeEnding(0, 0, mercator::FromLatLon(0.0, 0.0), *graph);
+  auto const finish = MakeFakeEnding(0, 0, mercator::FromLatLon(0.0, 20 * kDeg), *graph);
+
+  auto const result = Match(std::move(graph), start, finish, Reference({{0, 0}, {40, 0}, {20, 0}}));
+
+  // A* will take the direct sub-path, which is *shorter* than the reference. That is fine -- the
+  // gate exists to catch paths that are too long. Document the asymmetry rather than assert m_ok,
+  // which depends on how the caller wants to treat a shortcut.
+  TEST_LESS(result.m_lengthRatio, 1.15, ("Should not exceed the reference length"));
+}
+
+// --- 7. Road absent from the graph ------------------------------------------------------------------
+// Maps not downloaded, or Google routed over a road OSM does not have. Must decline, not match onto
+// whatever happens to be nearby.
+
+UNIT_TEST(CorridorMatcher_ReferenceOffGraph_Rejects)
+{
+  auto loader = std::make_unique<TestGeometryLoader>();
+  loader->AddRoad(0 /* featureId */, false, 1.0 /* speed */, Road({{0, 0}, {20, 0}, {40, 0}}));
+
+  std::vector<Joint> const joints;
+  auto graph = BuildGraph(std::move(loader), joints);
+
+  auto const start = MakeFakeEnding(0, 0, mercator::FromLatLon(0.0, 0.0), *graph);
+  auto const finish = MakeFakeEnding(0, 1, mercator::FromLatLon(0.0, 40 * kDeg), *graph);
+
+  // Reference runs ~110 m north of the only road, far outside any sane corridor.
+  auto const result = Match(std::move(graph), start, finish, Reference({{0, 10}, {40, 10}}));
+
+  TEST(!result.m_ok,
+       ("Should not match a reference that is nowhere near the graph; deviation", result.m_maxLateralDeviationM));
+}
+}  // namespace corridor_matcher_test
