diff --git a/libs/routing/polyline_matcher.cpp b/libs/routing/polyline_matcher.cpp
new file mode 100644
index 0000000000..49d4c672c5
--- /dev/null
+++ b/libs/routing/polyline_matcher.cpp
@@ -0,0 +1,58 @@
+#include "routing/polyline_matcher.hpp"
+
+#include "geometry/mercator.hpp"
+#include "geometry/parametrized_segment.hpp"
+
+#include "base/math.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+namespace routing
+{
+namespace
+{
+// Two mercator points closer than this are treated as coincident when deduplicating.
+double constexpr kSamePointMerc = 1e-9;
+
+// Distance in meters from |p| to the segment [a, b], both in mercator.
+double DistanceToSegmentM(m2::PointD const & p, m2::PointD const & a, m2::PointD const & b)
+{
+  m2::ParametrizedSegment<m2::PointD> const seg(a, b);
+  return mercator::DistanceOnEarth(p, seg.ClosestPointTo(p));
+}
+}  // namespace
+
+double MaxLateralDeviationM(std::vector<m2::PointD> const & path, std::vector<m2::PointD> const & guide)
+{
+  if (path.size() < 2 || guide.size() < 2)
+    return 0.0;
+
+  double maxDev = 0.0;
+  for (auto const & p : path)
+  {
+    double best = std::numeric_limits<double>::max();
+    for (size_t i = 0; i + 1 < guide.size(); ++i)
+      best = std::min(best, DistanceToSegmentM(p, guide[i], guide[i + 1]));
+    maxDev = std::max(maxDev, best);
+  }
+  return maxDev;
+}
+
+double PolylineLengthM(std::vector<m2::PointD> const & poly)
+{
+  double length = 0.0;
+  for (size_t i = 0; i + 1 < poly.size(); ++i)
+    length += mercator::DistanceOnEarth(poly[i], poly[i + 1]);
+  return length;
+}
+
+double MatchedLengthRatio(std::vector<m2::PointD> const & path, std::vector<m2::PointD> const & guide)
+{
+  double const guideLength = PolylineLengthM(guide);
+  if (guideLength <= 0.0)
+    return 0.0;
+  return PolylineLengthM(path) / guideLength;
+}
+}  // namespace routing
