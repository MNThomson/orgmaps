@@ -0,0 +1,30 @@
+#pragma once
+
+#include "geometry/point2d.hpp"
+
+#include <vector>
+
+namespace routing
+{
+// Data-independent geometry helpers used by IndexRouter::CalculateRouteAlongPolyline to map an
+// external (e.g. Google Routes API) route polyline onto the OSM road graph via corridor-constrained
+// matching. These operate purely on mercator geometry and have no dependency on the road graph, so
+// they are unit-testable without map data.
+
+// Maximum lateral deviation, in meters, of |path| from |guide|: the largest distance from any
+// vertex of |path| to the nearest segment of |guide|. Used as the corridor-fidelity gate for a
+// matched leg -- if the graph path A* chose strays farther than the allowed corridor half-width
+// from Google's polyline, the leg is rejected. Both polylines are in mercator. Returns 0 when
+// either input has fewer than two points (nothing meaningful to compare).
+double MaxLateralDeviationM(std::vector<m2::PointD> const & path, std::vector<m2::PointD> const & guide);
+
+// Geodesic length of |poly| in meters. Returns 0 for fewer than two points.
+double PolylineLengthM(std::vector<m2::PointD> const & poly);
+
+// |path| length divided by |guide| length -- the detour metric. Lateral deviation alone cannot see
+// an out-and-back excursion that stays near the guide (drive 400 m up the guide's own road, U-turn,
+// come back: every vertex is within a metre of the guide, yet the path is several times too long).
+// A faithful match sits just above 1.0; a hop that loops a block to turn around lands at 3-7.
+// Returns 0 when |guide| has no length, so callers can treat 0 as "not comparable".
+double MatchedLengthRatio(std::vector<m2::PointD> const & path, std::vector<m2::PointD> const & guide);
+}  // namespace routing
