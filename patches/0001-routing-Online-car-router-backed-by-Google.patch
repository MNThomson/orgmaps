+// Rescales the per-segment cumulative times of |route| so its total ETA equals |targetEtaSec|,
+// keeping OM's along-route time distribution but honouring the reference (Google) total. No-op if
+// the route has no positive computed time.
+void OverrideRouteEta(Route & route, double targetEtaSec)
+{
+  auto & segments = route.GetRouteSegments();
+  if (segments.empty())
+    return;
+
+  double const computedTotal = segments.back().GetTimeFromBeginningSec();
+  if (computedTotal <= 0.0)
+    return;
+
+  double const scale = targetEtaSec / computedTotal;
+  for (auto & s : segments)
+  {
+    s.SetDistancesAndTime(s.GetDistFromBeginningMeters(), s.GetDistFromBeginningMerc(),
+                          s.GetTimeFromBeginningSec() * scale);
+  }
+}
+}  // namespace
+
+RouterResultCode IndexRouter::CalculateRouteAlongPolyline(Checkpoints const & checkpoints,
+                                                          std::vector<std::vector<m2::PointD>> const & guideLegs,
+                                                          double referenceEtaSec, m2::PointD const & startDirection,
+                                                          RouterDelegate const & delegate, Route & route)
+{
+  CHECK_EQUAL(guideLegs.size(), checkpoints.GetNumSubroutes(), ());
+  // Matching relies on the car road graph (real segments, turn/lane annotations).
+  if (m_vehicleType != VehicleType::Car)
+  {
+    LOG(LWARNING, ("GoogleMatch: matcher is not a car router (type", m_vehicleType, ")."));
+    return RouterResultCode::InternalError;
+  }
+
+  LOG(LINFO, ("GoogleMatch: begin, legs", guideLegs.size(), "passedIdx", checkpoints.GetPassedIdx(), "corridorM",
+              kMatchCorridorHalfWidthM));
+
+  m_lastRoute.reset();
+
+  TrafficStash::Guard guard(m_trafficStash);
+  std::unique_ptr<WorldGraph> graph = MakeWorldGraph();
+
+  std::vector<Segment> segments;
+  std::vector<Route::SubrouteAttrs> subroutes;
+  PushPassedSubroutes(checkpoints, subroutes);
+
+  std::unique_ptr<IndexGraphStarter> starter;
+  auto progress = std::make_shared<AStarProgress>();
+
+  PointsOnEdgesSnapping snapping(*this, *graph);
+
+  size_t subrouteSegmentsBegin = 0;
+  size_t const subroutesCount = checkpoints.GetNumSubroutes();
+
+  for (size_t leg = checkpoints.GetPassedIdx(); leg < subroutesCount; ++leg)
+  {
+    auto const & reference = guideLegs[leg];
+    if (reference.size() < 2)
+    {
+      LOG(LWARNING, ("GoogleMatch: leg", leg, "has < 2 reference points; falling back."));
+      return RouterResultCode::RouteNotFound;
+    }
+
+    bool const isFirstLeg = (leg == checkpoints.GetPassedIdx());
+    bool const isLastLeg = (leg + 1 == subroutesCount);
+
+    // Snap once per leg, at the reference's own endpoints. Those are on-road (Google returns
+    // geometry already snapped near the request checkpoints), unlike the raw user pins, which can
+    // sit off-road and send the first or last stretch looping to reach the nearest real road.
+    FakeEnding startFakeEnding;
+    FakeEnding finishFakeEnding;
+    bool startIsCodirectional = false;
+    m2::PointD const dir = reference[1] - reference[0];
+
+    int const snapRes = snapping.Snap(reference.front(), reference.back(), dir, startFakeEnding, finishFakeEnding,
+                                      startIsCodirectional);
+    if (snapRes != 0)
+    {
+      LOG(LWARNING,
+          ("GoogleMatch: snap failed, code", snapRes, "leg", leg, "from", mercator::ToLatLon(reference.front()), "to",
+           mercator::ToLatLon(reference.back()), "- likely maps not downloaded for this area."));
+      if (snapRes == 1)
+        return RouterResultCode::StartPointNotFound;
+      return isLastLeg ? RouterResultCode::EndPointNotFound : RouterResultCode::IntermediatePointNotFound;
+    }
+
+    // Honour the caller's start direction only on the very first leg, where it reflects the user's
+    // actual heading; forcing it later would just constrain a continuation that is already pinned.
+    bool const strictForward = isFirstLeg && startIsCodirectional;
+    uint32_t const fakeNumerationStart = starter ? starter->GetNumFakeSegments() : 0;
+    IndexGraphStarter legStarter(startFakeEnding, finishFakeEnding, fakeNumerationStart, strictForward, *graph);
+
+    AStarSubProgress legProgress(mercator::ToLatLon(reference.front()), mercator::ToLatLon(reference.back()),
+                                 kAlmostZeroContribution);
+    progress->AppendSubProgress(legProgress);
+    SCOPE_GUARD(eraseProgress, [&progress]() { progress->PushAndDropLastSubProgress(); });
+
+    // One corridor-constrained search for the whole leg. The reference bounds where A* may go, so
+    // there are no per-hop boundaries to stitch and no way to loop a block to turn around.
+    CorridorMatchParams params;
+    params.m_corridorHalfWidthM = kMatchCorridorHalfWidthM;
+    params.m_maxLateralDeviationM = kMatchCorridorHalfWidthM;
+
+    auto const match = MatchPolylineToGraph(legStarter, reference, params, delegate.GetCancellable());
+    LOG(LINFO, ("GoogleMatch: leg", leg, "matched", match.m_ok, "with", match.m_geometry.size(), "points, deviation",
+                match.m_maxLateralDeviationM, "m, length ratio", match.m_lengthRatio));
+    if (!match.m_ok)
+    {
+      LOG(LWARNING, ("GoogleMatch: leg", leg, "could not be matched inside the corridor; falling back."));
+      return RouterResultCode::RouteNotFound;
+    }
+
+    if (delegate.IsCancelled())
+      return RouterResultCode::Cancelled;
+
+    IndexGraphStarter::CheckValidRoute(match.m_segments);
+
+    geometry::PointWithAltitude const legStartJunction = legStarter.GetStartJunction().ToPointWithAltitude();
+    geometry::PointWithAltitude const legFinishJunction = legStarter.GetFinishJunction().ToPointWithAltitude();
+
+    segments.insert(segments.end(), match.m_segments.begin(), match.m_segments.end());
+
+    // Pin the next leg's start to this leg's last real road so it cannot jump onto a parallel road
+    // at the shared checkpoint (the same technique multi-checkpoint routing uses).
+    Segment nextSegment;
+    if (!GetLastRealOrPart(legStarter, match.m_segments, nextSegment))
+    {
+      LOG(LWARNING, ("GoogleMatch: no real segment in matched leg", leg, "; falling back."));
+      return RouterResultCode::RouteNotFound;
+    }
+    snapping.SetNextStartSegment(nextSegment);
+
+    if (!starter)
+      starter = std::make_unique<IndexGraphStarter>(std::move(legStarter));
+    else
+      starter->Append(FakeEdgesContainer(std::move(legStarter)));
+
+    size_t const subrouteSegmentsEnd = segments.size();
+    subroutes.emplace_back(legStartJunction, legFinishJunction, subrouteSegmentsBegin, subrouteSegmentsEnd);
+    subrouteSegmentsBegin = subrouteSegmentsEnd;
+  }
+
+  if (!starter || segments.empty())
+    return RouterResultCode::RouteNotFound;
+
+  route.SetSubroutes(std::move(subroutes), checkpoints.GetPassedIdx());
+  IndexGraphStarter::CheckValidRoute(segments);
+
+  LOG(LINFO, ("GoogleMatch: all legs matched, total segments", segments.size(), "- redressing route."));
+  auto const redress = RedressRoute(segments, delegate.GetCancellable(), *starter, route);
+  if (redress != RouterResultCode::NoError)
+  {
+    LOG(LWARNING, ("GoogleMatch: RedressRoute failed, code", redress, "; falling back."));
+    return redress;
+  }
+
+  // Preserve Google's traffic-aware ETA (OM's per-segment speeds are traffic-unaware).
+  if (referenceEtaSec > 0.0)
+    OverrideRouteEta(route, referenceEtaSec);
+
+  LOG(LINFO, ("GoogleMatch: SUCCESS - length", route.GetTotalDistanceMeters(), "m, ETA", route.GetTotalTimeSec(),
+              "s (native OSM segments)."));
+  return RouterResultCode::NoError;
+}
