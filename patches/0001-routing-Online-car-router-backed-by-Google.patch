index 0000000000..e368746cf0
--- /dev/null
+++ b/libs/platform/platform_tests_support/android_test_stubs.cpp
@@ -0,0 +1,117 @@
+#include "platform/gui_thread.hpp"
+#include "platform/http_client.hpp"
+#include "platform/locale.hpp"
+#include "platform/localization.hpp"
+#include "platform/platform.hpp"
+
+#include <cstdlib>
+#include <functional>
+#include <string>
+#include <utility>
+
+// Standalone Android test binaries link libplatform without the app's JNI layer, where these are
+// normally defined (android/sdk/src/main/cpp/.../AndroidPlatform.cpp). Without them the platform
+// library has undefined references and no test executable can be linked for a device at all.
+//
+// The stubs are deliberately inert: a test that needs real Android platform behaviour (system
+// language, battery, JNI-supplied data paths) belongs in the instrumentation suite, not here. What
+// this unlocks is the large body of pure-logic tests -- routing, geometry, coding -- which only
+// need libplatform to link, not to work.
+//
+// Paths are left empty, matching Platform's no-op Android constructor: a test that reads data files
+// must set them up itself (see ScopedDir / ScopedFile).
+
+Platform & GetPlatform()
+{
+  static Platform platform;
+  static bool const initialized = []
+  {
+    // Android's Platform constructor is a no-op -- the app fills these in from Java. A device test
+    // binary has no Java side, so take the directories from the environment. Tests that load
+    // resources (classificator.txt and friends, via classificator::Load) need OMIM_RESOURCES_DIR to
+    // point at a pushed copy of the repo's data/ directory; tests that only exercise pure logic can
+    // leave it unset.
+    char const * resources = std::getenv("OMIM_RESOURCES_DIR");
+    char const * writable = std::getenv("OMIM_WRITABLE_DIR");
+    if (resources != nullptr)
+      platform.SetResourceDir(resources);
+    if (writable != nullptr)
+      platform.SetWritableDirForTests(writable);
+    else if (resources != nullptr)
+      platform.SetWritableDirForTests(resources);
+    return true;
+  }();
+  UNUSED_VALUE(initialized);
+  return platform;
+}
+
