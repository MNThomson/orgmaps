diff --git a/libs/routing/corridor_matcher.cpp b/libs/routing/corridor_matcher.cpp
new file mode 100644
index 0000000000..6d85c4737d
--- /dev/null
+++ b/libs/routing/corridor_matcher.cpp
@@ -0,0 +1,165 @@
+#include "routing/corridor_matcher.hpp"
+
+#include "routing/base/astar_algorithm.hpp"
+#include "routing/base/astar_graph.hpp"
+#include "routing/index_graph_starter.hpp"
+#include "routing/polyline_matcher.hpp"
+#include "routing/route_weight.hpp"
+
+#include "geometry/mercator.hpp"
+#include "geometry/parametrized_segment.hpp"
+
+#include "base/cancellable.hpp"
+#include "base/logging.hpp"
+
+#include <limits>
+#include <utility>
+
+namespace routing
+{
+namespace
+{
+// Aliased rather than used directly: routing::Edge (road_graph.hpp) is a different type and makes
+// an unqualified Edge ambiguous here.
+using MatchVertex = IndexGraphStarter::Vertex;
+using MatchEdge = IndexGraphStarter::Edge;
+using MatchWeight = IndexGraphStarter::Weight;
+using MatchAlgorithm = AStarAlgorithm<MatchVertex, MatchEdge, MatchWeight>;
+
+// Distance in meters from |p| to the polyline |poly|. Linear in |poly|; see the note on
+// CorridorGraph::IsInsideCorridor for why that is acceptable here.
+double DistanceToPolylineM(m2::PointD const & p, std::vector<m2::PointD> const & poly)
+{
+  double best = std::numeric_limits<double>::max();
+  for (size_t i = 0; i + 1 < poly.size(); ++i)
+  {
+    m2::ParametrizedSegment<m2::PointD> const seg(poly[i], poly[i + 1]);
+    best = std::min(best, mercator::DistanceOnEarth(p, seg.ClosestPointTo(p)));
+  }
+  return best;
+}
+
+// An IndexGraphStarter view that hides every edge leading outside the reference corridor. Everything
+// else forwards straight through, so the underlying weights, restrictions and heuristic are
+// untouched -- and because filtering only *removes* options, the heuristic stays admissible and A*
+// stays correct.
+class CorridorGraph : public AStarGraph<MatchVertex, MatchEdge, MatchWeight>
+{
+public:
+  CorridorGraph(IndexGraphStarter & starter, std::vector<m2::PointD> const & reference, double halfWidthM)
+    : m_starter(starter)
+    , m_reference(reference)
+    , m_halfWidthM(halfWidthM)
+  {}
+
+  MatchWeight HeuristicCostEstimate(MatchVertex const & from, MatchVertex const & to) override
+  {
+    return m_starter.HeuristicCostEstimate(from, to);
+  }
+
+  void GetOutgoingEdgesList(astar::VertexData<MatchVertex, MatchWeight> const & vertexData, EdgeListT & edges) override
+  {
+    m_starter.GetOutgoingEdgesList(vertexData, edges);
+    FilterToCorridor(edges);
+  }
+
+  void GetIngoingEdgesList(astar::VertexData<MatchVertex, MatchWeight> const & vertexData, EdgeListT & edges) override
+  {
+    m_starter.GetIngoingEdgesList(vertexData, edges);
+    FilterToCorridor(edges);
+  }
+
+  void SetAStarParents(bool forward, Parents & parents) override { m_starter.SetAStarParents(forward, parents); }
+  void DropAStarParents() override { m_starter.DropAStarParents(); }
+
+  bool AreWavesConnectible(Parents & forwardParents, MatchVertex const & commonVertex,
+                           Parents & backwardParents) override
+  {
+    return m_starter.AreWavesConnectible(forwardParents, commonVertex, backwardParents);
+  }
+
+  MatchWeight GetAStarWeightEpsilon() override { return m_starter.GetAStarWeightEpsilon(); }
+
+private:
+  // Fake segments (the start/finish leaders the starter synthesises) are always admitted: they are
+  // how the search enters and leaves the graph, and rejecting them would strand it. Real segments
+  // are judged by their target junction, which is the point the edge actually takes us to.
+  bool IsInsideCorridor(MatchVertex const & vertex)
+  {
+    if (!vertex.IsRealSegment())
+      return true;
+
+    auto const point = mercator::FromLatLon(m_starter.GetPoint(vertex, true /* front */));
+    return DistanceToPolylineM(point, m_reference) <= m_halfWidthM;
+  }
+
+  void FilterToCorridor(EdgeListT & edges)
+  {
+    size_t kept = 0;
+    for (size_t i = 0; i < edges.size(); ++i)
+    {
+      if (!IsInsideCorridor(edges[i].GetTarget()))
+        continue;
+      if (kept != i)
+        edges[kept] = edges[i];
+      ++kept;
+    }
+    edges.resize(kept);
+  }
+
+  IndexGraphStarter & m_starter;
+  std::vector<m2::PointD> const & m_reference;
+  double const m_halfWidthM;
+};
+}  // namespace
+
+CorridorMatchResult MatchPolylineToGraph(IndexGraphStarter & starter, std::vector<m2::PointD> const & reference,
+                                         CorridorMatchParams const & params, base::Cancellable const & cancellable)
+{
+  CorridorMatchResult result;
+  if (reference.size() < 2)
+  {
+    LOG(LWARNING, ("CorridorMatch: reference has", reference.size(), "points; nothing to match."));
+    return result;
+  }
+
+  CorridorGraph graph(starter, reference, params.m_corridorHalfWidthM);
+
+  MatchAlgorithm::Params<> aStarParams(graph, starter.GetStartSegment(), starter.GetFinishSegment(), cancellable);
+
+  RoutingResult<MatchVertex, MatchWeight> routingResult;
+  auto const status = MatchAlgorithm().FindPathBidirectional(aStarParams, routingResult);
+  if (status != MatchAlgorithm::Result::OK)
+  {
+    LOG(LINFO, ("CorridorMatch: no path inside the", params.m_corridorHalfWidthM, "m corridor."));
+    return result;
+  }
+
+  result.m_segments = std::move(routingResult.m_path);
+
+  result.m_geometry.reserve(result.m_segments.size() + 1);
+  for (size_t i = 0; i <= result.m_segments.size(); ++i)
+    result.m_geometry.push_back(mercator::FromLatLon(starter.GetRouteJunction(result.m_segments, i).GetLatLon()));
+
+  result.m_maxLateralDeviationM = MaxLateralDeviationM(result.m_geometry, reference);
+  result.m_lengthRatio = MatchedLengthRatio(result.m_geometry, reference);
+
+  // Both gates, for the reasons in CorridorMatchParams. Report which one failed: "strays onto
+  // another road" and "doubles back on the right road" call for different investigation.
+  if (result.m_maxLateralDeviationM > params.m_maxLateralDeviationM)
+  {
+    LOG(LWARNING, ("CorridorMatch: rejected, deviation", result.m_maxLateralDeviationM, "m >",
+                   params.m_maxLateralDeviationM, "m."));
+    return result;
+  }
+  if (result.m_lengthRatio > params.m_maxLengthRatio)
+  {
+    LOG(LWARNING,
+        ("CorridorMatch: rejected, length ratio", result.m_lengthRatio, ">", params.m_maxLengthRatio, "- detour."));
+    return result;
+  }
+
+  result.m_ok = true;
+  return result;
+}
+}  // namespace routing
diff --git a/libs/routing/corridor_matcher.hpp b/libs/routing/corridor_matcher.hpp
new file mode 100644
index 0000000000..5a2ed19a31
--- /dev/null
+++ b/libs/routing/corridor_matcher.hpp
@@ -0,0 +1,70 @@
+#pragma once
+
+#include "routing/segment.hpp"
+
+#include "geometry/point2d.hpp"
+
+#include <vector>
+
+namespace base
+{
+class Cancellable;
+}
+
+namespace routing
+{
+class IndexGraphStarter;
+
+// Corridor-constrained matching of an external reference polyline (e.g. a Google Routes API route)
+// onto the OSM road graph.
+//
+// The reference constrains the *search* rather than acting as a chain of waypoints: one A* runs from
+// the leg's start to its finish, and edges lying outside a tube of |m_corridorHalfWidthM| around the
+// reference are never explored.
+//
+// This replaces an earlier design that resampled the reference into ~120 m anchors and ran an
+// independent A* per anchor pair. That approach failed on anything longer than a couple of blocks
+// for two compounding reasons:
+//   * Each hop pinned its start segment but not a usable traversal direction, so whenever the
+//     pinned segment's available direction opposed travel, A* had to loop a whole block to turn
+//     around -- observed in the field as a 757 m path across a 101 m anchor gap.
+//   * A single bad hop failed the whole leg, so the success rate decayed as p^N in the hop count.
+// A hard corridor removes both: a block loop leaves the tube and is therefore unreachable, and
+// there are no hop boundaries left to stitch.
+struct CorridorMatchParams
+{
+  // Half-width of the search tube. Must comfortably exceed the largest legitimate disagreement
+  // between the reference and OSM geometry -- divided carriageways are typically drawn 5-20 m
+  // apart -- while staying under the distance to genuinely different roads (a frontage road is
+  // usually 20-40 m off). Too wide and the block-loop escape route reopens.
+  double m_corridorHalfWidthM = 30.0;
+
+  // Acceptance gates on the finished path. Both are needed and neither subsumes the other:
+  // deviation catches "matched the wrong road", the length ratio catches "matched the right road
+  // but drove too much of it" (an out-and-back excursion has ~0 deviation, see MatchedLengthRatio).
+  double m_maxLateralDeviationM = 30.0;
+  double m_maxLengthRatio = 1.15;
+};
+
+struct CorridorMatchResult
+{
+  // True only when a path was found *and* it passed both acceptance gates. Callers fall back to
+  // their own geometry when this is false.
+  bool m_ok = false;
+
+  std::vector<Segment> m_segments;
+  // Junction points of |m_segments|, in mercator. Populated even when a gate rejected the path, so
+  // callers can log what was rejected.
+  std::vector<m2::PointD> m_geometry;
+
+  double m_maxLateralDeviationM = 0.0;
+  double m_lengthRatio = 0.0;
+};
+
+// Matches |reference| (mercator, at least two points) using |starter|, whose start and finish
+// endings the caller has already snapped onto the graph near the reference's own endpoints.
+// Never throws; a search failure is reported as !m_ok rather than an error code, because every
+// caller's response is the same -- fall back.
+CorridorMatchResult MatchPolylineToGraph(IndexGraphStarter & starter, std::vector<m2::PointD> const & reference,
+                                         CorridorMatchParams const & params, base::Cancellable const & cancellable);
+}  // namespace routing
diff --git a/libs/routing/google_router.cpp b/libs/routing/google_router.cpp
new file mode 100644
index 0000000000..b88c67413d
--- /dev/null
+++ b/libs/routing/google_router.cpp
@@ -0,0 +1,748 @@
+#include "routing/google_router.hpp"
+
+#include "routing/index_router.hpp"
+#include "routing/route.hpp"
+#include "routing/routing_helpers.hpp"
+
+#include "routing_common/num_mwm_id.hpp"
+
+#include "platform/http_client.hpp"
+#include "platform/settings.hpp"
+
+#include "coding/serdes_json.hpp"
+
+#include "geometry/mercator.hpp"
+#include "geometry/point_with_altitude.hpp"
+
+#include "base/exception.hpp"
+#include "base/logging.hpp"
+#include "base/math.hpp"
+#include "base/visitor.hpp"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <iomanip>
+#include <iterator>
+#include <limits>
+#include <sstream>
+#include <string>
+#include <unordered_map>
+#include <utility>
+
+namespace routing
+{
+namespace
+{
+std::string const kRoutesApiUrl = "https://routes.googleapis.com/directions/v2:computeRoutes";
+
+// Routes API defaults to TRAFFIC_UNAWARE, which yields free-flow ETAs noticeably shorter than the
+// ones google.com/maps shows. TRAFFIC_AWARE_OPTIMAL matches the web client most closely; the
+// cheaper TRAFFIC_AWARE uses the same live traffic data but trades accuracy for latency. Both bill
+// at a higher SKU than the traffic-unaware default. Departure time is left unset, i.e. "now".
+char const kRoutingPreference[] = "TRAFFIC_AWARE_OPTIMAL";
+
+// Only the fields GoogleRouter consumes are requested; the Routes API requires an explicit mask.
+// routes.staticDuration is needed alongside routes.duration to derive the traffic factor, see
+// TrafficScale(). The leg polyline is requested purely as the index space for
+// legs.travelAdvisory.speedReadingIntervals (traffic is not offered at step level); route geometry
+// still comes from the per-step polylines, which carry the maneuvers.
+std::string const kFieldMask =
+    "routes.duration,routes.staticDuration,routes.distanceMeters,routes.legs.steps.navigationInstruction,"
+    "routes.legs.steps.polyline.encodedPolyline,routes.legs.steps.staticDuration,"
+    "routes.legs.polyline.encodedPolyline,routes.legs.travelAdvisory.speedReadingIntervals";
+
+// Two mercator points are considered the same route vertex below this threshold. Consecutive
+// Routes API steps share their boundary vertex, so this de-duplicates the join.
+double constexpr kSamePointEps = 1e-7;
+
+// --- Routes API response model (subset matching kFieldMask) ---------------------------------
+// Genuinely-optional fields use the 3-arg visitor form (value, default, name) so a missing key
+// yields the default instead of throwing; obligatory containers (legs/steps) throw on absence,
+// which CalculateRoute treats as "no route".
+
+struct ApiPolyline
+{
+  DECLARE_VISITOR(visitor(m_encodedPolyline, std::string{}, "encodedPolyline"))
+  std::string m_encodedPolyline;
+};
+
+struct ApiNavigationInstruction
+{
+  DECLARE_VISITOR(visitor(m_maneuver, std::string{}, "maneuver"), visitor(m_instructions, std::string{}, "instructions"))
+  std::string m_maneuver;
+  std::string m_instructions;
+};
+
+struct ApiStep
+{
+  DECLARE_VISITOR(visitor(m_polyline, ApiPolyline{}, "polyline"),
+                  visitor(m_navigationInstruction, ApiNavigationInstruction{}, "navigationInstruction"),
+                  visitor(m_staticDuration, std::string{}, "staticDuration"))
+  ApiPolyline m_polyline;
+  ApiNavigationInstruction m_navigationInstruction;
+  std::string m_staticDuration;  // e.g. "834s"
+};
+
+// travelAdvisory.speedReadingIntervals entry. Indices are into the enclosing leg's polyline;
+// endPolylinePointIndex is exclusive, and an absent startPolylinePointIndex means 0 (proto3 omits
+// default-valued fields).
+struct ApiSpeedReadingInterval
+{
+  DECLARE_VISITOR(visitor(m_startPolylinePointIndex, 0, "startPolylinePointIndex"),
+                  visitor(m_endPolylinePointIndex, 0, "endPolylinePointIndex"),
+                  visitor(m_speed, std::string{}, "speed"))
+  int32_t m_startPolylinePointIndex = 0;
+  int32_t m_endPolylinePointIndex = 0;
+  std::string m_speed;  // "NORMAL" | "SLOW" | "TRAFFIC_JAM"
+};
+
+struct ApiLegTravelAdvisory
+{
+  DECLARE_VISITOR(visitor(m_speedReadingIntervals, std::vector<ApiSpeedReadingInterval>{}, "speedReadingIntervals"))
+  std::vector<ApiSpeedReadingInterval> m_speedReadingIntervals;
+};
+
+struct ApiLeg
+{
+  DECLARE_VISITOR(visitor(m_steps, "steps"), visitor(m_polyline, ApiPolyline{}, "polyline"),
+                  visitor(m_travelAdvisory, ApiLegTravelAdvisory{}, "travelAdvisory"))
+  std::vector<ApiStep> m_steps;
+  ApiPolyline m_polyline;  // index space for m_travelAdvisory's intervals, not used for geometry
+  ApiLegTravelAdvisory m_travelAdvisory;
+};
+
+struct ApiRoute
+{
+  DECLARE_VISITOR(visitor(m_duration, std::string{}, "duration"),
+                  visitor(m_staticDuration, std::string{}, "staticDuration"),
+                  visitor(m_distanceMeters, 0.0, "distanceMeters"), visitor(m_legs, "legs"))
+  std::string m_duration;        // traffic-aware, see kRoutingPreference
+  std::string m_staticDuration;  // free-flow, ignores traffic
+  double m_distanceMeters = 0.0;
+  std::vector<ApiLeg> m_legs;
+};
+
+struct ApiResponse
+{
+  DECLARE_VISITOR(visitor(m_routes, "routes"))
+  std::vector<ApiRoute> m_routes;
+};
+
+void AppendLocation(std::ostringstream & ss, ms::LatLon const & ll)
+{
+  ss << "{\"location\":{\"latLng\":{\"latitude\":" << ll.m_lat << ",\"longitude\":" << ll.m_lon << "}}}";
+}
+
+// Builds the computeRoutes request body for the active (non-passed) checkpoints:
+// origin = first active checkpoint, destination = last, intermediates = the rest.
+std::string BuildRequestBody(Checkpoints const & checkpoints)
+{
+  auto const & points = checkpoints.GetPoints();
+  size_t const from = checkpoints.GetPassedIdx();
+  size_t const to = points.size() - 1;
+
+  std::ostringstream ss;
+  ss << std::setprecision(8) << std::fixed;
+  ss << "{\"origin\":";
+  AppendLocation(ss, mercator::ToLatLon(points[from]));
+  ss << ",\"destination\":";
+  AppendLocation(ss, mercator::ToLatLon(points[to]));
+
+  bool const hasIntermediates = to - from > 1;
+  if (hasIntermediates)
+  {
+    ss << ",\"intermediates\":[";
+    for (size_t i = from + 1; i < to; ++i)
+    {
+      if (i > from + 1)
+        ss << ',';
+      AppendLocation(ss, mercator::ToLatLon(points[i]));
+    }
+    ss << ']';
+  }
+
+  // TRAFFIC_ON_POLYLINE populates legs.travelAdvisory.speedReadingIntervals, which drives the
+  // per-segment traffic colouring. It requires a traffic-aware routingPreference (satisfied above)
+  // and is billed at a higher rate than a plain traffic-aware request.
+  ss << ",\"travelMode\":\"DRIVE\",\"routingPreference\":\"" << kRoutingPreference
+     << "\",\"extraComputations\":[\"TRAFFIC_ON_POLYLINE\"],\"polylineEncoding\":\"ENCODED_POLYLINE\"";
+
+  // The Routes API returns no alternatives for requests with intermediate waypoints, so asking for
+  // them there would just cost latency. Up to three routes come back, ordered "most recommended"
+  // first; GoogleRouter keeps that order and makes the first one active.
+  ss << ",\"computeAlternativeRoutes\":" << (hasIntermediates ? "false" : "true") << '}';
+  return ss.str();
+}
+
+bool SamePoint(m2::PointD const & a, m2::PointD const & b)
+{
+  return AlmostEqualAbs(a.x, b.x, kSamePointEps) && AlmostEqualAbs(a.y, b.y, kSamePointEps);
+}
+
+// A maneuver placed on the route polyline at |m_pointIdx| (index into the assembled geometry).
+struct Maneuver
+{
+  size_t m_pointIdx = 0;
+  turns::CarDirection m_dir = turns::CarDirection::None;
+  std::string m_instruction;
+};
+
+// Concatenates the per-step polylines of a Routes API leg into a single mercator polyline,
+// de-duplicating the vertex shared by consecutive steps. Returns fewer than two points when the leg
+// carries no usable geometry.
+std::vector<m2::PointD> DecodeLegPolyline(ApiLeg const & leg)
+{
+  std::vector<m2::PointD> poly;
+  for (auto const & step : leg.m_steps)
+  {
+    auto const stepPts = DecodeGooglePolyline(step.m_polyline.m_encodedPolyline);
+    for (auto const & ll : stepPts)
+    {
+      m2::PointD const pt = mercator::FromLatLon(ll);
+      if (poly.empty() || !SamePoint(poly.back(), pt))
+        poly.push_back(pt);
+    }
+  }
+  return poly;
+}
+
+// The reference polyline the API's speed intervals index into, with every leg concatenated and each
+// leg's intervals rebased onto the combined index space. Boundary vertices are deliberately NOT
+// de-duplicated (unlike DecodeLegPolyline): the interval indices are leg-local, so dropping a point
+// would shift every index after it. Duplicated points are harmless for nearest-point lookup.
+struct TrafficGuide
+{
+  std::vector<m2::PointD> m_polyline;
+  std::vector<SpeedInterval> m_intervals;
+};
+
+TrafficGuide BuildTrafficGuide(ApiRoute const & apiRoute)
+{
+  TrafficGuide guide;
+  for (auto const & leg : apiRoute.m_legs)
+  {
+    auto const pts = DecodeGooglePolyline(leg.m_polyline.m_encodedPolyline);
+    size_t const offset = guide.m_polyline.size();
+    for (auto const & ll : pts)
+      guide.m_polyline.push_back(mercator::FromLatLon(ll));
+
+    for (auto const & interval : leg.m_travelAdvisory.m_speedReadingIntervals)
+    {
+      auto const group = SpeedToSpeedGroup(interval.m_speed);
+      // Free-flowing and unrecognised stretches are not drawn, so carrying them adds no information.
+      if (group == traffic::SpeedGroup::G5 || group == traffic::SpeedGroup::Unknown)
+        continue;
+
+      auto const begin = static_cast<size_t>(std::max(0, interval.m_startPolylinePointIndex));
+      auto const end = static_cast<size_t>(std::max(0, interval.m_endPolylinePointIndex));
+      if (end <= begin || begin >= pts.size())
+        continue;
+
+      guide.m_intervals.push_back({offset + begin, offset + std::min(end, pts.size()), group});
+    }
+  }
+  return guide;
+}
+
+// Stamps Google's traffic densities onto |segments| so RoutingManager can colour the route line
+// (see FillTrafficForRendering). Each segment takes the density at its own junction point. A no-op
+// when the response carried no congested stretches, leaving every segment SpeedGroup::Unknown.
+void ApplyTrafficToSegments(ApiRoute const & apiRoute, std::vector<RouteSegment> & segments)
+{
+  size_t rawIntervals = 0;
+  for (auto const & leg : apiRoute.m_legs)
+    rawIntervals += leg.m_travelAdvisory.m_speedReadingIntervals.size();
+
+  auto const guide = BuildTrafficGuide(apiRoute);
+  LOG(LINFO, ("GoogleTraffic: legs", apiRoute.m_legs.size(), "raw intervals", rawIntervals, "congested intervals",
+              guide.m_intervals.size(), "guide points", guide.m_polyline.size(), "route segments", segments.size()));
+
+  if (guide.m_intervals.empty() || segments.empty())
+    return;
+
+  std::vector<m2::PointD> junctions;
+  junctions.reserve(segments.size());
+  for (auto const & segment : segments)
+    junctions.push_back(segment.GetJunction().GetPoint());
+
+  auto const groups = MapSpeedIntervalsToPath(junctions, guide.m_polyline, guide.m_intervals);
+  CHECK_EQUAL(groups.size(), segments.size(), ());
+
+  size_t coloured = 0;
+  for (size_t i = 0; i < segments.size(); ++i)
+  {
+    segments[i].SetTraffic(groups[i]);
+    if (groups[i] != traffic::SpeedGroup::Unknown)
+      ++coloured;
+  }
+  LOG(LINFO, ("GoogleTraffic: coloured", coloured, "of", segments.size(), "segments."));
+}
+
+// Turns one Routes API route into an OM Route: prefer a native match onto the OSM road graph (real
+// street names, lane guidance, speed cameras) and fall back to the raw-geometry overlay when
+// |matcher| is null or matching fails (maps not downloaded, or Google chose a road missing from
+// OSM). |tag| identifies the route in logs. Declared before BuildGeometryOverlayRoute's definition
+// via the forward declaration below.
+RouterResultCode BuildGeometryOverlayRoute(Checkpoints const & checkpoints, ApiRoute const & apiRoute, Route & route);
+
+RouterResultCode BuildOneRoute(IndexRouter * matcher, ApiRoute const & apiRoute, Checkpoints const & checkpoints,
+                               m2::PointD const & startDirection, RouterDelegate const & delegate,
+                               std::string const & tag, Route & route)
+{
+  if (matcher)
+  {
+    size_t const passedIdx = checkpoints.GetPassedIdx();
+    size_t const legsExpected = checkpoints.GetNumSubroutes() - passedIdx;
+    LOG(LINFO, ("GoogleMatch:", tag, "matcher present; API legs", apiRoute.m_legs.size(), "expected", legsExpected,
+                "passedIdx", passedIdx));
+
+    // The Routes API returns one leg per active checkpoint pair (see BuildRequestBody).
+    if (apiRoute.m_legs.size() != legsExpected)
+    {
+      LOG(LWARNING, ("GoogleMatch:", tag, "leg-count mismatch (API", apiRoute.m_legs.size(), "vs expected",
+                     legsExpected, ") - using raw-geometry overlay."));
+    }
+    else
+    {
+      // guideLegs is indexed by absolute leg index; passed legs stay empty and are skipped.
+      std::vector<std::vector<m2::PointD>> guideLegs(checkpoints.GetNumSubroutes());
+      bool geometryOk = true;
+      for (size_t k = 0; k < apiRoute.m_legs.size(); ++k)
+      {
+        auto poly = DecodeLegPolyline(apiRoute.m_legs[k]);
+        LOG(LINFO, ("GoogleMatch:", tag, "decoded leg", k, "->", poly.size(), "points."));
+        if (poly.size() < 2)
+        {
+          LOG(LWARNING, ("GoogleMatch:", tag, "leg", k, "decoded to < 2 points - using raw-geometry overlay."));
+          geometryOk = false;
+          break;
+        }
+        guideLegs[passedIdx + k] = std::move(poly);
+      }
+
+      if (geometryOk)
+      {
+        double const referenceEtaSec = ParseDurationSeconds(apiRoute.m_duration);
+        Route matched;
+        auto code = RouterResultCode::InternalError;
+        try
+        {
+          code = matcher->CalculateRouteAlongPolyline(checkpoints, guideLegs, referenceEtaSec, startDirection, delegate,
+                                                      matched);
+        }
+        catch (RootException const & e)
+        {
+          LOG(LWARNING, ("GoogleMatch:", tag, "exception during matching:", e.Msg(), "- using raw-geometry overlay."));
+        }
+
+        if (code == RouterResultCode::NoError)
+        {
+          LOG(LINFO, ("GoogleMatch:", tag, "using native matched route."));
+          // OM's own traffic source is disabled (CreateTrafficStash returns nullptr), so the matched
+          // segments carry no densities until Google's are stamped on here.
+          ApplyTrafficToSegments(apiRoute, matched.GetRouteSegments());
+          route = std::move(matched);
+          return RouterResultCode::NoError;
+        }
+        if (code == RouterResultCode::Cancelled)
+          return code;
+        LOG(LINFO, ("GoogleMatch:", tag, "matching returned", code, "- using raw-geometry overlay."));
+      }
+    }
+  }
+  else
+  {
+    LOG(LINFO, ("GoogleMatch:", tag, "no matcher configured - using raw-geometry overlay."));
+  }
+
+  return BuildGeometryOverlayRoute(checkpoints, apiRoute, route);
+}
+
+// Builds a Route directly from Google's polyline as an overlay of fake (off-graph) segments. Used
+// as the fallback when the polyline cannot be matched onto the OSM road graph. The resulting route
+// carries Google's geometry, ETA and turn maneuvers, but no OSM-derived street names/lanes, and it
+// renders in the "fake" style (see routing_manager). On success |route| holds the built route.
+RouterResultCode BuildGeometryOverlayRoute(Checkpoints const & checkpoints, ApiRoute const & apiRoute, Route & route)
+{
+  // Assemble a single route by concatenating the per-step polylines. Each step's maneuver is
+  // placed on its first (boundary) vertex; consecutive steps share that vertex.
+  std::vector<m2::PointD> geometry;
+  std::vector<double> pointTimes;
+  std::vector<Maneuver> maneuvers;
+  std::vector<Route::SubrouteAttrs> subroutes;
+
+  // Passed subroutes for already-completed legs (see IndexRouter::PushPassedSubroutes).
+  for (size_t i = 0; i < checkpoints.GetPassedIdx(); ++i)
+  {
+    subroutes.emplace_back(geometry::PointWithAltitude(checkpoints.GetPoint(i), 0),
+                           geometry::PointWithAltitude(checkpoints.GetPoint(i + 1), 0), 0 /* begin */, 0 /* end */);
+  }
+
+  double const trafficScale = TrafficScale(apiRoute.m_duration, apiRoute.m_staticDuration);
+  double cumulativeSec = 0.0;
+  for (auto const & leg : apiRoute.m_legs)
+  {
+    size_t legStartIdx = geometry.empty() ? 0 : geometry.size();  // updated to the real join on the 1st step
+    bool legStartCaptured = false;
+
+    for (auto const & step : leg.m_steps)
+    {
+      auto const stepPts = DecodeGooglePolyline(step.m_polyline.m_encodedPolyline);
+      if (stepPts.empty())
+        continue;
+
+      double const stepDur = ParseDurationSeconds(step.m_staticDuration) * trafficScale;
+      size_t joinIdx = 0;
+      size_t startK = 1;
+
+      m2::PointD const firstPt = mercator::FromLatLon(stepPts.front());
+      if (geometry.empty())
+      {
+        joinIdx = 0;
+        geometry.push_back(firstPt);
+        pointTimes.push_back(0.0);
+      }
+      else if (SamePoint(geometry.back(), firstPt))
+      {
+        joinIdx = geometry.size() - 1;  // shared boundary vertex
+      }
+      else
+      {
+        joinIdx = geometry.size();
+        geometry.push_back(firstPt);
+        pointTimes.push_back(cumulativeSec);
+      }
+
+      if (!legStartCaptured)
+      {
+        legStartIdx = joinIdx;
+        legStartCaptured = true;
+      }
+
+      // Record the maneuver (skip the depart vertex 0, which has no preceding segment).
+      auto const dir = ManeuverToCarDirection(step.m_navigationInstruction.m_maneuver);
+      if (joinIdx >= 1 && dir != turns::CarDirection::None)
+        maneuvers.push_back({joinIdx, dir, step.m_navigationInstruction.m_instructions});
+
+      size_t const newCount = stepPts.size() - startK;
+      for (size_t k = startK; k < stepPts.size(); ++k)
+      {
+        geometry.push_back(mercator::FromLatLon(stepPts[k]));
+        pointTimes.push_back(cumulativeSec + stepDur * static_cast<double>(k - startK + 1) / newCount);
+      }
+      cumulativeSec += stepDur;
+    }
+
+    if (!legStartCaptured || geometry.size() < 2)
+      continue;
+
+    subroutes.emplace_back(geometry::PointWithAltitude(geometry[legStartIdx], 0),
+                           geometry::PointWithAltitude(geometry.back(), 0), legStartIdx, geometry.size() - 1);
+  }
+
+  size_t const pointsCount = geometry.size();
+  if (pointsCount < 2 || subroutes.empty())
+    return RouterResultCode::RouteNotFound;
+
+  std::unordered_map<size_t, Maneuver const *> maneuverAt;
+  for (auto const & m : maneuvers)
+    maneuverAt[m.m_pointIdx] = &m;
+
+  Segment const fakeSegment(kFakeNumMwmId, 0 /* featureId */, 0 /* segmentIdx */, false /* forward */);
+
+  std::vector<RouteSegment> routeSegments;
+  routeSegments.reserve(pointsCount - 1);
+  std::vector<double> times;
+  times.reserve(pointsCount - 1);
+
+  for (size_t i = 0; i + 1 < pointsCount; ++i)
+  {
+    size_t const junctionIdx = i + 1;  // segment junction is its far point; m_turn.m_index == i + 1.
+    geometry::PointWithAltitude const junction(geometry[junctionIdx], 0);
+
+    turns::CarDirection dir = turns::CarDirection::None;
+    RouteSegment::RoadNameInfo roadNameInfo;
+    if (junctionIdx + 1 == pointsCount)
+    {
+      dir = turns::CarDirection::ReachedYourDestination;
+    }
+    else if (auto const it = maneuverAt.find(junctionIdx); it != maneuverAt.end())
+    {
+      dir = it->second->m_dir;
+      roadNameInfo.m_name = it->second->m_instruction;
+    }
+
+    turns::TurnItem const turn(static_cast<uint32_t>(junctionIdx), dir);
+    routeSegments.emplace_back(fakeSegment, turn, junction, roadNameInfo);
+    times.push_back(pointTimes[junctionIdx]);
+  }
+
+  ApplyTrafficToSegments(apiRoute, routeSegments);
+
+  FillSegmentInfo(times, routeSegments);
+  route.SetRouteSegments(std::move(routeSegments));
+  route.SetSubroutes(std::move(subroutes), checkpoints.GetPassedIdx());
+  route.SetGeometry(geometry.begin(), geometry.end());
+
+  return RouterResultCode::NoError;
+}
+}  // namespace
+
+double ParseDurationSeconds(std::string const & duration)
+{
+  if (duration.empty())
+    return 0.0;
+  // Strip a trailing 's' if present.
+  std::string const num = (duration.back() == 's') ? duration.substr(0, duration.size() - 1) : duration;
+  char * end = nullptr;
+  double const sec = std::strtod(num.c_str(), &end);
+  return (end == num.c_str() || sec < 0.0) ? 0.0 : sec;
+}
+
+double TrafficScale(std::string const & trafficDuration, std::string const & staticDuration)
+{
+  double const trafficSec = ParseDurationSeconds(trafficDuration);
+  double const staticSec = ParseDurationSeconds(staticDuration);
+  if (trafficSec <= 0.0 || staticSec <= 0.0)
+    return 1.0;
+  return trafficSec / staticSec;
+}
+
+traffic::SpeedGroup SpeedToSpeedGroup(std::string const & speed)
+{
+  if (speed == "TRAFFIC_JAM")
+    return traffic::SpeedGroup::G0;
+  if (speed == "SLOW")
+    return traffic::SpeedGroup::G2;
+  if (speed == "NORMAL")
+    return traffic::SpeedGroup::G5;
+  return traffic::SpeedGroup::Unknown;
+}
+
+std::vector<traffic::SpeedGroup> MapSpeedIntervalsToPath(std::vector<m2::PointD> const & path,
+                                                         std::vector<m2::PointD> const & guide,
+                                                         std::vector<SpeedInterval> const & intervals)
+{
+  std::vector<traffic::SpeedGroup> result(path.size(), traffic::SpeedGroup::Unknown);
+  if (path.empty() || guide.empty() || intervals.empty())
+    return result;
+
+  // Flatten the intervals into a per-guide-point lookup so the sweep below is a single indexed read.
+  std::vector<traffic::SpeedGroup> guideGroups(guide.size(), traffic::SpeedGroup::Unknown);
+  for (auto const & interval : intervals)
+  {
+    size_t const end = std::min(interval.m_end, guide.size());
+    for (size_t i = std::min(interval.m_begin, end); i < end; ++i)
+      guideGroups[i] = interval.m_group;
+  }
+
+  // Forward-only nearest-point sweep. The window bounds the cost at O(path * kLookAhead) and, more
+  // importantly, stops a route that revisits the same road (loops, out-and-back legs) from matching
+  // against the earlier or later pass. It has to be generous because the two polylines are sampled
+  // independently: the guide can be far denser than the matched OSM path, or vice versa.
+  size_t constexpr kLookAhead = 64;
+  size_t cursor = 0;
+  for (size_t i = 0; i < path.size(); ++i)
+  {
+    size_t best = cursor;
+    double bestDist = std::numeric_limits<double>::max();
+    size_t const limit = std::min(guide.size(), cursor + kLookAhead + 1);
+    for (size_t k = cursor; k < limit; ++k)
+    {
+      double const dist = path[i].SquaredLength(guide[k]);
+      if (dist < bestDist)
+      {
+        bestDist = dist;
+        best = k;
+      }
+    }
+    cursor = best;
+    result[i] = guideGroups[best];
+  }
+  return result;
+}
+
+std::vector<ms::LatLon> DecodeGooglePolyline(std::string const & encoded)
+{
+  std::vector<ms::LatLon> poly;
+  size_t const len = encoded.size();
+  size_t index = 0;
+  int32_t lat = 0;
+  int32_t lng = 0;
+
+  auto const nextDelta = [&](int32_t & out) -> bool
+  {
+    int32_t shift = 0;
+    int32_t result = 0;
+    int32_t b = 0;
+    do
+    {
+      if (index >= len)
+        return false;
+      b = static_cast<int32_t>(encoded[index++]) - 63;
+      result |= (b & 0x1f) << shift;
+      shift += 5;
+    } while (b >= 0x20);
+    out += (result & 1) ? ~(result >> 1) : (result >> 1);
+    return true;
+  };
+
+  while (index < len)
+  {
+    if (!nextDelta(lat) || !nextDelta(lng))
+      break;
+    poly.emplace_back(lat * 1e-5, lng * 1e-5);
+  }
+  return poly;
+}
+
+turns::CarDirection ManeuverToCarDirection(std::string const & m)
+{
+  using turns::CarDirection;
+  if (m == "TURN_LEFT")
+    return CarDirection::TurnLeft;
+  if (m == "TURN_RIGHT")
+    return CarDirection::TurnRight;
+  if (m == "TURN_SHARP_LEFT")
+    return CarDirection::TurnSharpLeft;
+  if (m == "TURN_SHARP_RIGHT")
+    return CarDirection::TurnSharpRight;
+  if (m == "TURN_SLIGHT_LEFT")
+    return CarDirection::TurnSlightLeft;
+  if (m == "TURN_SLIGHT_RIGHT")
+    return CarDirection::TurnSlightRight;
+  if (m == "UTURN_LEFT")
+    return CarDirection::UTurnLeft;
+  if (m == "UTURN_RIGHT")
+    return CarDirection::UTurnRight;
+  if (m == "ROUNDABOUT_LEFT" || m == "ROUNDABOUT_RIGHT")
+    return CarDirection::EnterRoundAbout;
+  if (m == "RAMP_LEFT" || m == "FORK_LEFT")
+    return CarDirection::ExitHighwayToLeft;
+  if (m == "RAMP_RIGHT" || m == "FORK_RIGHT")
+    return CarDirection::ExitHighwayToRight;
+  if (m == "DESTINATION" || m == "DESTINATION_LEFT" || m == "DESTINATION_RIGHT")
+    return CarDirection::ReachedYourDestination;
+  // STRAIGHT, MERGE, NAME_CHANGE, DEPART, MANEUVER_UNSPECIFIED, unknown, empty.
+  return CarDirection::GoStraight;
+}
+
+GoogleRouter::GoogleRouter(std::unique_ptr<IndexRouter> matcher) : m_matcher(std::move(matcher)) {}
+
+GoogleRouter::~GoogleRouter() = default;
+
+RouterResultCode GoogleRouter::CalculateRoute(Checkpoints const & checkpoints, m2::PointD const & startDirection,
+                                              bool /* adjustToPrevRoute */, RouterDelegate const & delegate,
+                                              RoutesResult & result)
+{
+  std::string apiKey;
+  if (!settings::Get(kGoogleApiKeySetting, apiKey) || apiKey.empty())
+  {
+    LOG(LWARNING, ("Google routing: API key is not set."));
+    return RouterResultCode::InternalError;
+  }
+
+  if (delegate.IsCancelled())
+    return RouterResultCode::Cancelled;
+
+  // Fetch the route from the Routes API. RunHttpRequest() blocks, which is fine on the AsyncRouter
+  // worker thread this runs on.
+  platform::HttpClient request(kRoutesApiUrl);
+  request.SetBodyData(BuildRequestBody(checkpoints), "application/json", "POST");
+  request.SetRawHeader("X-Goog-Api-Key", apiKey);
+  request.SetRawHeader("X-Goog-FieldMask", kFieldMask);
+
+  if (!request.RunHttpRequest() || request.ErrorCode() != 200)
+  {
+    LOG(LWARNING, ("Google routing request failed:", request.ErrorCode(), request.ServerResponse()));
+    return RouterResultCode::RouteNotFound;
+  }
+
+  if (delegate.IsCancelled())
+    return RouterResultCode::Cancelled;
+
+  // Temporary diagnostic: separates "Google sent no traffic" from "we failed to parse it".
+  {
+    auto const & raw = request.ServerResponse();
+    LOG(LINFO, ("GoogleTraffic: response bytes", raw.size(), "has speedReadingIntervals",
+                raw.find("speedReadingIntervals") != std::string::npos, "has travelAdvisory",
+                raw.find("travelAdvisory") != std::string::npos, "has TRAFFIC_JAM",
+                raw.find("TRAFFIC_JAM") != std::string::npos, "has SLOW", raw.find("\"SLOW\"") != std::string::npos));
+  }
+
+  ApiResponse response;
+  try
+  {
+    coding::DeserializerJson des(request.ServerResponse());
+    des(response);
+  }
+  catch (RootException const & e)
+  {
+    LOG(LWARNING, ("Google routing: failed to parse response:", e.Msg()));
+    return RouterResultCode::RouteNotFound;
+  }
+
+  if (response.m_routes.empty())
+    return RouterResultCode::RouteNotFound;
+
+  // Build every route the API returned (up to three when alternatives were requested). A single
+  // failed alternative is not fatal — it is dropped and the rest are still offered.
+  std::vector<Route> routes;
+  routes.reserve(response.m_routes.size());
+  for (size_t i = 0; i < response.m_routes.size(); ++i)
+  {
+    // Matching runs the A* corridor search per route, so re-check between them: a user who cancels
+    // should not wait for the remaining alternatives.
+    if (delegate.IsCancelled())
+      return RouterResultCode::Cancelled;
+
+    std::string const tag = "route " + std::to_string(i) + ":";
+    Route built;
+    auto const code =
+        BuildOneRoute(m_matcher.get(), response.m_routes[i], checkpoints, startDirection, delegate, tag, built);
+    if (code == RouterResultCode::Cancelled)
+      return code;
+
+    if (code != RouterResultCode::NoError || !built.IsValid())
+    {
+      LOG(LWARNING, ("GoogleMatch:", tag, "could not be built (code", code, ") - dropping it."));
+      continue;
+    }
+    routes.push_back(std::move(built));
+  }
+
+  if (routes.empty())
+    return RouterResultCode::RouteNotFound;
+
+  // Google orders routes "most recommended first" and that ordering is preserved here: it accounts
+  // for road class, turn complexity and the undesirability of cutting through residential streets,
+  // none of which show up in the ETA. Sorting by ETA instead would promote rat-runs that save a
+  // handful of seconds over a long highway drive. The other routes stay available as alternatives,
+  // with their ETAs shown, so a faster-but-worse option remains one tap away.
+  LOG(LINFO, ("GoogleMatch: built", routes.size(), "route(s); active is Google's recommended at",
+              routes[0].GetTotalTimeSec(), "s."));
+
+  // MakeFrom seats the active route at index 0; alternatives follow. Their divergence midpoints
+  // anchor the ETA balloons where each alternative actually differs from the active route
+  // (RoutingManager::CreateRouteAltMarks). Compare by geometry rather than feature identity: the
+  // overlay fallback's segments are all fake (featureId 0), so identity-based diffing finds nothing.
+  result.MakeFrom(GetName(), std::move(routes[0]));
+  for (size_t i = 1; i < routes.size(); ++i)
+  {
+    auto & alt = routes[i];
+    if (auto const diffMidpoint = alt.FindMaxDiffMidpointByGeometry(result.GetActive().GetRouteSegments()))
+      alt.SetDiffMidpoint(*diffMidpoint);
+    result.m_routes.emplace_back(std::move(static_cast<RouteBase &>(alt)));
+  }
+
+  return RouterResultCode::NoError;
+}
