index 0000000000..f9bdfd5791
--- /dev/null
+++ b/libs/routing/routing_tests/polyline_matcher_test.cpp
@@ -0,0 +1,102 @@
+#include "testing/testing.hpp"
+
+#include "routing/polyline_matcher.hpp"
+
+#include "geometry/mercator.hpp"
+#include "geometry/point2d.hpp"
+
+#include <vector>
+
+namespace polyline_matcher_test
+{
+using namespace routing;
+
+// Builds a mercator polyline from (lat, lon) pairs for readability.
+std::vector<m2::PointD> FromLatLon(std::vector<std::pair<double, double>> const & lls)
+{
+  std::vector<m2::PointD> pts;
+  pts.reserve(lls.size());
+  for (auto const & [lat, lon] : lls)
+    pts.push_back(mercator::FromLatLon(lat, lon));
+  return pts;
+}
+
+UNIT_TEST(PolylineMatcher_Deviation_Zero_WhenPathOnGuide)
+{
+  auto const guide = FromLatLon({{0.0, 0.0}, {0.0, 0.01}});
+  // A path lying exactly on the guide line (a midpoint plus the endpoints).
+  auto const path = FromLatLon({{0.0, 0.0}, {0.0, 0.005}, {0.0, 0.01}});
+  double const dev = MaxLateralDeviationM(path, guide);
+  TEST_LESS(dev, 1.0, ("On-line path has ~0 deviation, got", dev));
+}
+
+UNIT_TEST(PolylineMatcher_Deviation_MeasuresPerpendicularOffset)
+{
+  // Guide runs east along the equator; path is parallel but offset ~111 m north.
+  auto const guide = FromLatLon({{0.0, 0.0}, {0.0, 0.01}});
+  auto const path = FromLatLon({{0.001, 0.0}, {0.001, 0.01}});  // 0.001 deg lat ~= 111 m
+  double const dev = MaxLateralDeviationM(path, guide);
+  TEST(dev > 90.0 && dev < 130.0, ("Expected ~111 m offset, got", dev));
+}
+
+UNIT_TEST(PolylineMatcher_Deviation_DegenerateInputsReturnZero)
+{
+  auto const guide = FromLatLon({{0.0, 0.0}, {0.0, 0.01}});
+  std::vector<m2::PointD> const single = {mercator::FromLatLon(0.0, 0.0)};
+  TEST_EQUAL(MaxLateralDeviationM(single, guide), 0.0, ());
+  TEST_EQUAL(MaxLateralDeviationM(guide, single), 0.0, ());
+}
+
+UNIT_TEST(PolylineMatcher_LengthRatio_FaithfulMatchIsNearOne)
+{
+  auto const guide = FromLatLon({{0.0, 0.0}, {0.0, 0.01}});
+  // Same corridor, sampled at three points instead of two: same length, so ratio ~1.
+  auto const path = FromLatLon({{0.0, 0.0}, {0.0, 0.005}, {0.0, 0.01}});
+  double const ratio = MatchedLengthRatio(path, guide);
+  TEST(ratio > 0.99 && ratio < 1.01, ("Expected ~1.0, got", ratio));
+}
+
+UNIT_TEST(PolylineMatcher_LengthRatio_CatchesOutAndBackDetour)
+{
+  // The failure lateral deviation cannot see: the path runs to the end of the guide, doubles back
+  // to the midpoint and returns. Every vertex lies *on* the guide, so deviation reports a perfect
+  // match, while the path is twice the length it should be. Note the excursion has to stay within
+  // the guide's extent to be invisible -- overshooting past its end would show up as deviation,
+  // since beyond the last vertex the nearest point on the guide is that endpoint.
+  auto const guide = FromLatLon({{0.0, 0.0}, {0.0, 0.01}});
+  auto const path = FromLatLon({{0.0, 0.0}, {0.0, 0.01}, {0.0, 0.005}, {0.0, 0.01}});
+
+  TEST_LESS(MaxLateralDeviationM(path, guide), 1.0, ("Detour stays on the guide line"));
+  double const ratio = MatchedLengthRatio(path, guide);
+  TEST(ratio > 1.9 && ratio < 2.1, ("Expected ~2.0, got", ratio));
+}
+
+UNIT_TEST(PolylineMatcher_LengthRatio_RealDetourArtifactFromDevice)
+{
+  // Abridged from a logged "DETOUR ARTIFACT" hop: the matcher was asked to cover ~101 m between two
+  // anchors and produced a ~757 m block loop. Both endpoints are right on the reference, so only the
+  // length ratio catches it. Guards the metric that gates the new matcher.
+  auto const guide = FromLatLon({{49.278450, -123.128190}, {49.277810, -123.127200}});
+  auto const path = FromLatLon({{49.278450, -123.128190},
+                                {49.279331, -123.126850},
+                                {49.280474, -123.125104},
+                                {49.280203, -123.124519},
+                                {49.279328, -123.124892},
+                                {49.278420, -123.126263},
+                                {49.277810, -123.127200}});
+
+  double const ratio = MatchedLengthRatio(path, guide);
+  TEST(ratio > 3.0, ("The logged loop is several times the anchor gap, got ratio", ratio));
+}
+
+UNIT_TEST(PolylineMatcher_LengthRatio_DegenerateGuideReturnsZero)
+{
+  auto const guide = FromLatLon({{0.0, 0.0}, {0.0, 0.01}});
+  std::vector<m2::PointD> const single = {mercator::FromLatLon(0.0, 0.0)};
+  // No guide length -> not comparable.
+  TEST_EQUAL(MatchedLengthRatio(guide, single), 0.0, ());
+  TEST_EQUAL(MatchedLengthRatio(guide, {}), 0.0, ());
+  // Empty path against a real guide is 0 length, ratio 0 -- not an error, just nothing matched.
+  TEST_EQUAL(MatchedLengthRatio({}, guide), 0.0, ());
+}
+}  // namespace polyline_matcher_test
