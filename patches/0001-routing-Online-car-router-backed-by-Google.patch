+
+// Online car router backed by the Google Maps Routes API
+// (https://routes.googleapis.com/directions/v2:computeRoutes).
+//
+// Unlike IndexRouter it reads no offline map data: it POSTs the checkpoints, receives an
+// encoded polyline + per-step maneuvers, and assembles a Route from them (compare RulerRouter,
+// which likewise builds a Route from externally-supplied geometry). Requires network access and
+// a valid API key in settings (see kGoogleApiKeySetting); returns an error code otherwise.
+class GoogleRouter : public IRouter
+{
+public:
+  // |matcher| is a car IndexRouter used to map the Google polyline onto the OSM road graph for
+  // native turn-by-turn (names, lanes, speed cameras); it may be null. When it is null, or when
+  // matching fails (e.g. maps not downloaded for the area, or Google chose a road that isn't in
+  // OSM), the router falls back to a raw-geometry overlay of Google's polyline.
+  // No default argument: it would force unique_ptr<IndexRouter>'s destructor to instantiate here,
+  // where IndexRouter is only forward-declared. Pass nullptr explicitly for the no-matcher case.
+  explicit GoogleRouter(std::unique_ptr<IndexRouter> matcher);
+  ~GoogleRouter() override;
+
+  std::string GetName() const override { return "google"; }
+  void ClearState() override {}
+  void SetGuides(GuidesTracks && /* guides */) override {}
+
+  RouterResultCode CalculateRoute(Checkpoints const & checkpoints, m2::PointD const & startDirection,
+                                  bool adjustToPrevRoute, RouterDelegate const & delegate,
+                                  RoutesResult & result) override;
+
+  bool FindClosestProjectionToRoad(m2::PointD const & point, m2::PointD const & direction, double radius,
+                                   EdgeProj & proj) override;
+
+private:
+  std::unique_ptr<IndexRouter> m_matcher;
+};
+
+// Decodes a Google "encoded polyline" string into a list of geographic points (WGS84).
+// This is Google's polyline algorithm (base64-ish 5-bit chunks, zigzag deltas, 1e-5 precision),
+// which is unrelated to Organic Maps' own coding::DecodePolyline delta format.
+// Malformed/truncated input yields the prefix decoded so far.
+std::vector<ms::LatLon> DecodeGooglePolyline(std::string const & encoded);
+
+// Parses a Routes API duration string ("834s") into seconds. Returns 0 on empty/invalid input.
+double ParseDurationSeconds(std::string const & duration);
+
+// Ratio of a route's traffic-aware duration to its free-flow duration, e.g. ~1.13 for a route that
+// takes 34 min in traffic and 30 min without. Routes API RouteLegStep carries staticDuration only,
+// so per-step timings must be scaled by this to add up to the traffic-aware total. Returns 1 when
+// either duration is missing or unparsable, which leaves the timings free-flow rather than
+// collapsing them to zero.
+double TrafficScale(std::string const & trafficDuration, std::string const & staticDuration);
+
+// Maps a Google Routes API NavigationInstruction.maneuver enum value (e.g. "TURN_LEFT",
+// "ROUNDABOUT_LEFT", "MERGE") to the closest routing::turns::CarDirection.
+// Unknown/empty values fall back to CarDirection::GoStraight.
+turns::CarDirection ManeuverToCarDirection(std::string const & maneuver);
+
+// A run of consecutive reference-polyline points sharing one traffic density, derived from a Routes
+// API travelAdvisory.speedReadingIntervals entry. |m_end| is exclusive, matching the API.
+struct SpeedInterval
+{
+  size_t m_begin = 0;
+  size_t m_end = 0;
+  traffic::SpeedGroup m_group = traffic::SpeedGroup::Unknown;
+};
+
+// Maps a Routes API SpeedReadingInterval.speed enum value to the closest traffic::SpeedGroup.
+// Google exposes only three densities, and Organic Maps draws G3..G5 fully transparent (see
+// RouteTrafficG3-opacity in the styles), so only the two congested levels get a visible group:
+//   TRAFFIC_JAM -> G0 (darkest red), SLOW -> G2 (red), NORMAL -> G5 (invisible, plain route color).
+// Unknown/empty values fall back to SpeedGroup::Unknown, which is likewise not drawn.
+traffic::SpeedGroup SpeedToSpeedGroup(std::string const & speed);
+
+// Assigns a SpeedGroup to every point of |path| from |intervals|, which are expressed as index
+// ranges over |guide| (the Routes API reference polyline). Both polylines are in mercator and are
+// assumed to run in the same direction; each path point takes the group of its nearest guide point,
+// found by a forward-only sweep so a route that revisits the same road cannot match backwards.
+// Points not covered by any interval, and every point when |intervals| is empty, get
+// SpeedGroup::Unknown. The result is parallel to |path|.
+std::vector<traffic::SpeedGroup> MapSpeedIntervalsToPath(std::vector<m2::PointD> const & path,
+                                                         std::vector<m2::PointD> const & guide,
+                                                         std::vector<SpeedInterval> const & intervals);
+}  // namespace routing
