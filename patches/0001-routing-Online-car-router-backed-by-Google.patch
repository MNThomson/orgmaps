+bool GoogleRouter::FindClosestProjectionToRoad(m2::PointD const & /* point */, m2::PointD const & /* direction */,
+                                               double /* radius */, EdgeProj & /* proj */)
+{
+  // No connection to the road graph.
+  return false;
+}
