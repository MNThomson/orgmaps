--- /dev/null
+++ b/libs/map/google_places.cpp
@@ -0,0 +1,605 @@
+#include "map/google_places.hpp"
+
+#include "routing/google_router.hpp"
+
+#include "platform/http_client.hpp"
+#include "platform/platform.hpp"
+#include "platform/settings.hpp"
+
+#include "coding/serdes_json.hpp"
+#include "coding/writer.hpp"
+
+#include "indexer/feature_utils.hpp"
+
+#include "geometry/latlon.hpp"
+#include "geometry/mercator.hpp"
+
+#include "base/exception.hpp"
+#include "base/logging.hpp"
+#include "base/string_utils.hpp"
+#include "base/visitor.hpp"
+
+#include <array>
+#include <iomanip>
+#include <random>
+#include <sstream>
+#include <string_view>
+#include <utility>
+
+namespace search
+{
+namespace
+{
+std::string const kAutocompleteUrl = "https://places.googleapis.com/v1/places:autocomplete";
+std::string const kDetailsUrlPrefix = "https://places.googleapis.com/v1/places/";
+
+// Only the fields GooglePlaces consumes are requested; the Places API requires an explicit mask on the
+// details endpoint. The autocomplete endpoint is not field-masked.
+//
+// A details call is billed at the tier of the most expensive field in its mask, and everything after
+// websiteUri here is Enterprise ($20 per 1000 calls, 1000 free per month) rather than the Pro tier the
+// first five would bill at. That buys the opening hours, phone and website that make the place page
+// look like an ordinary POI page; it is charged per place opened, not per keystroke.
+char const kDetailsFieldMask[] =
+    "id,displayName,primaryTypeDisplayName,formattedAddress,location,"
+    "regularOpeningHours,internationalPhoneNumber,websiteUri,"
+    "rating,userRatingCount,priceLevel";
+
+// Radius of the circle the predictions are biased towards. Large enough to cover a metro area, so a query
+// typed while looking at a city still reaches its suburbs; the bias is a preference, not a filter, so
+// out-of-radius matches are still returned when nothing closer fits.
+double constexpr kLocationBiasRadiusM = 50000.0;
+
+// --- Request model (serialized; SerializerJson has no 3-arg visitor, hence separate from the
+// --- response model below, whose fields must all be optional) ------------------------------------
+
+struct ApiRequestLatLng
+{
+  DECLARE_VISITOR(visitor(m_latitude, "latitude"), visitor(m_longitude, "longitude"))
+  double m_latitude = 0.0;
+  double m_longitude = 0.0;
+};
+
+struct ApiRequestCircle
+{
+  DECLARE_VISITOR(visitor(m_center, "center"), visitor(m_radius, "radius"))
+  ApiRequestLatLng m_center;
+  double m_radius = kLocationBiasRadiusM;
+};
+
+struct ApiRequestLocationBias
+{
+  DECLARE_VISITOR(visitor(m_circle, "circle"))
+  ApiRequestCircle m_circle;
+};
+
+struct ApiAutocompleteRequest
+{
+  DECLARE_VISITOR(visitor(m_input, "input"), visitor(m_languageCode, "languageCode"),
+                  visitor(m_sessionToken, "sessionToken"), visitor(m_origin, "origin"),
+                  visitor(m_locationBias, "locationBias"))
+  std::string m_input;
+  std::string m_languageCode;
+  std::string m_sessionToken;
+  ApiRequestLatLng m_origin;
+  ApiRequestLocationBias m_locationBias;
+};
+
+// --- Response model (subset of what the endpoints return) ----------------------------------------
+// Every field uses the 3-arg visitor form (value, default, name) so that a missing key yields the
+// default instead of throwing: the API omits proto3 default values and drops fields we did not ask for.
+
+struct ApiText
+{
+  DECLARE_VISITOR(visitor(m_text, std::string{}, "text"))
+  std::string m_text;
+};
+
+struct ApiStructuredFormat
+{
+  DECLARE_VISITOR(visitor(m_mainText, ApiText{}, "mainText"), visitor(m_secondaryText, ApiText{}, "secondaryText"))
+  ApiText m_mainText;       // the place name, e.g. "Blue Bottle Coffee"
+  ApiText m_secondaryText;  // the address remainder, e.g. "300 Webster St, Oakland, CA, USA"
+};
+
+struct ApiPlacePrediction
+{
+  DECLARE_VISITOR(visitor(m_placeId, std::string{}, "placeId"), visitor(m_text, ApiText{}, "text"),
+                  visitor(m_structuredFormat, ApiStructuredFormat{}, "structuredFormat"))
+  std::string m_placeId;
+  ApiText m_text;  // the whole prediction as one string; fallback title when structuredFormat is absent
+  ApiStructuredFormat m_structuredFormat;
+};
+
+struct ApiSuggestion
+{
+  DECLARE_VISITOR(visitor(m_placePrediction, ApiPlacePrediction{}, "placePrediction"))
+  // A suggestion is either a placePrediction or a queryPrediction ("coffee near me"), which addresses no
+  // place and is therefore left unparsed - it decodes to an empty placeId and is skipped.
+  ApiPlacePrediction m_placePrediction;
+};
+
+struct ApiAutocompleteResponse
+{
+  DECLARE_VISITOR(visitor(m_suggestions, std::vector<ApiSuggestion>{}, "suggestions"))
+  std::vector<ApiSuggestion> m_suggestions;
+};
+
+struct ApiLatLng
+{
+  DECLARE_VISITOR(visitor(m_latitude, 0.0, "latitude"), visitor(m_longitude, 0.0, "longitude"))
+  double m_latitude = 0.0;
+  double m_longitude = 0.0;
+};
+
+// regularOpeningHours.periods[].open / .close
+struct ApiTimePoint
+{
+  DECLARE_VISITOR(visitor(m_day, 0, "day"), visitor(m_hour, 0, "hour"), visitor(m_minute, 0, "minute"))
+  int32_t m_day = 0;
+  int32_t m_hour = 0;
+  int32_t m_minute = 0;
+};
+
+// An always-open place is reported as a single period with an open point and no close key at all. A
+// missing close therefore decodes to the same all-zero point as its open, and that equality is what
+// IsAlwaysOpen() below tests: a real period never opens and closes at the same instant, since even a
+// full day is reported as open on one day and close on the next.
+struct ApiPeriod
+{
+  DECLARE_VISITOR(visitor(m_open, ApiTimePoint{}, "open"), visitor(m_close, ApiTimePoint{}, "close"))
+  ApiTimePoint m_open;
+  ApiTimePoint m_close;
+
+  bool IsAlwaysOpen() const
+  {
+    return m_close.m_day == m_open.m_day && m_close.m_hour == m_open.m_hour && m_close.m_minute == m_open.m_minute;
+  }
+};
+
+struct ApiOpeningHours
+{
+  DECLARE_VISITOR(visitor(m_periods, std::vector<ApiPeriod>{}, "periods"))
+  std::vector<ApiPeriod> m_periods;
+};
+
+// The details response is decoded in two passes, and this is the first: everything needed to put a pin
+// on the map and name it. Deliberately kept to flat, long-standing fields so that a change in the shape
+// of a richer one cannot cost the user the place they tapped.
+struct ApiPlaceCore
+{
+  DECLARE_VISITOR(visitor(m_id, std::string{}, "id"), visitor(m_displayName, ApiText{}, "displayName"),
+                  visitor(m_formattedAddress, std::string{}, "formattedAddress"),
+                  visitor(m_location, ApiLatLng{}, "location"))
+  std::string m_id;
+  ApiText m_displayName;
+  std::string m_formattedAddress;
+  ApiLatLng m_location;
+};
+
+// Second pass: everything that only enriches the place page. Decoded separately so a failure here is
+// recoverable - the place still opens, just with fewer rows.
+struct ApiPlaceExtra
+{
+  DECLARE_VISITOR(visitor(m_primaryTypeDisplayName, ApiText{}, "primaryTypeDisplayName"),
+                  visitor(m_regularOpeningHours, ApiOpeningHours{}, "regularOpeningHours"),
+                  visitor(m_internationalPhoneNumber, std::string{}, "internationalPhoneNumber"),
+                  visitor(m_websiteUri, std::string{}, "websiteUri"), visitor(m_rating, 0.0, "rating"),
+                  visitor(m_userRatingCount, 0, "userRatingCount"), visitor(m_priceLevel, std::string{}, "priceLevel"))
+  ApiText m_primaryTypeDisplayName;  // already localized by languageCode, e.g. "Bakery"
+  ApiOpeningHours m_regularOpeningHours;
+  std::string m_internationalPhoneNumber;
+  std::string m_websiteUri;
+  double m_rating = 0.0;
+  int32_t m_userRatingCount = 0;
+  std::string m_priceLevel;
+};
+
+// Maps a PriceLevel enum value to the dollar-sign shorthand every maps app uses. Unspecified and free
+// yield nothing: "$" for a free place would be wrong, and a word would need localizing.
+std::string_view PriceLevelToSymbols(std::string const & priceLevel)
+{
+  if (priceLevel == "PRICE_LEVEL_INEXPENSIVE")
+    return "$";
+  if (priceLevel == "PRICE_LEVEL_MODERATE")
+    return "$$";
+  if (priceLevel == "PRICE_LEVEL_EXPENSIVE")
+    return "$$$";
+  if (priceLevel == "PRICE_LEVEL_VERY_EXPENSIVE")
+    return "$$$$";
+  return {};
+}
+
+// Place type, rating and price level, joined the way the place page joins a POI's own subtitle parts.
+// Every piece comes from the API already localized, so this needs no strings bundle and can run on the
+// network thread with the rest of the parsing.
+std::string FormatSubtitle(ApiPlaceExtra const & place)
+{
+  std::string result;
+  auto const append = [&result](std::string_view sv)
+  {
+    if (sv.empty())
+      return;
+    if (!result.empty())
+      result += feature::kFieldsSeparator;
+    result += sv;
+  };
+
+  append(place.m_primaryTypeDisplayName.m_text);
+
+  if (place.m_rating > 0.0)
+  {
+    std::ostringstream rating;
+    rating << "★ " << std::fixed << std::setprecision(1) << place.m_rating;
+    if (place.m_userRatingCount > 0)
+      rating << " (" << place.m_userRatingCount << ')';
+    append(rating.str());
+  }
+
+  append(PriceLevelToSymbols(place.m_priceLevel));
+  return result;
+}
+
+// OSM weekday abbreviations, indexed the way OSM orders a week (Monday first).
+constexpr std::string_view kOsmWeekdays[] = {"Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"};
+size_t constexpr kDaysInWeek = 7;
+
+// The API numbers days from Sunday; OSM writes them from Monday.
+size_t ApiDayToOsmIndex(int32_t apiDay)
+{
+  return static_cast<size_t>((apiDay + 6) % 7);
+}
+
+std::string FormatHhMm(int32_t hour, int32_t minute)
+{
+  std::ostringstream os;
+  os << std::setfill('0') << std::setw(2) << hour << ':' << std::setw(2) << minute;
+  return os.str();
+}
+
+// Default when the platform gives us nothing usable. The API rejects an empty languageCode outright.
+char const kFallbackLanguageCode[] = "en";
+
+// 128 bits of hex, the shape the Places API expects of an autocomplete session token. It only has to be
+// unique per session, not unguessable.
+std::string GenerateSessionToken()
+{
+  std::random_device rd;
+  std::mt19937_64 gen(rd());
+  std::uniform_int_distribution<uint64_t> dist;
+
+  std::ostringstream os;
+  os << std::hex << std::setfill('0') << std::setw(16) << dist(gen) << std::setw(16) << dist(gen);
+  return os.str();
+}
+}  // namespace
+
+GooglePlaces::GooglePlaces(RunUITaskFn runUITask) : m_runUITask(std::move(runUITask)) {}
+
+bool GooglePlaces::Autocomplete(std::string const & query, std::string const & locale, m2::PointD const & origin,
+                                OnResults onResults)
+{
+  std::string apiKey;
+  if (!settings::Get(routing::kGoogleApiKeySetting, apiKey) || apiKey.empty())
+  {
+    LOG(LWARNING, ("GooglePlaces: API key is not set."));
+    return false;
+  }
+
+  if (m_sessionToken.empty())
+    m_sessionToken = GenerateSessionToken();
+
+  // Remembered so the details call that ends this session asks for the same language.
+  m_languageCode = NormalizeLanguageCode(locale);
+
+  auto const requestId = ++m_requestId;
+  auto const body = BuildAutocompleteBody(query, m_languageCode, m_sessionToken, origin);
+
+  GetPlatform().RunTask(Platform::Thread::Network,
+                        [this, requestId, apiKey, body, origin, onResults = std::move(onResults)]()
+  {
+    platform::HttpClient request(kAutocompleteUrl);
+    request.SetBodyData(body, "application/json", "POST");
+    request.SetRawHeader("X-Goog-Api-Key", apiKey);
+
+    std::string response;
+    if (request.RunHttpRequest() && request.ErrorCode() == 200)
+      response = request.ServerResponse();
+    else
+      LOG(LWARNING, ("GooglePlaces: autocomplete failed:", request.ErrorCode(), request.ServerResponse()));
+
+    std::vector<std::string> placeIds;
+    auto results = ParseAutocompleteResponse(response, origin, placeIds);
+    // One response carries everything, so this emit is also the end of the search.
+    results.SetEndMarker(false /* cancelled */);
+
+    m_runUITask([this, requestId, results = std::move(results), placeIds = std::move(placeIds), onResults]() mutable
+    {
+      // A newer query was started, or the search was cancelled, while this one was in flight.
+      if (requestId != m_requestId)
+        return;
+
+      m_placeIds = std::move(placeIds);
+      std::vector<ProductInfo> productInfo(results.GetCount());
+      onResults(std::move(results), std::move(productInfo));
+    });
+  });
+
+  return true;
+}
+
+bool GooglePlaces::HasPrediction(size_t index) const
+{
+  return index < m_placeIds.size() && !m_placeIds[index].empty();
+}
+
+void GooglePlaces::GetPlaceDetails(size_t index, OnPlace onPlace)
+{
+  CHECK(HasPrediction(index), (index, m_placeIds.size()));
+
+  std::string apiKey;
+  if (!settings::Get(routing::kGoogleApiKeySetting, apiKey) || apiKey.empty())
+  {
+    LOG(LWARNING, ("GooglePlaces: API key is not set."));
+    return;
+  }
+
+  // The details call closes the billing session opened by the autocomplete calls; the next query starts a
+  // new one. Place ids, session tokens and language codes are all URL-safe, so none need escaping.
+  auto const language = m_languageCode.empty() ? kFallbackLanguageCode : m_languageCode;
+  auto const url =
+      kDetailsUrlPrefix + m_placeIds[index] + "?languageCode=" + language + "&sessionToken=" + m_sessionToken;
+  m_sessionToken.clear();
+
+  // Deliberately not guarded by m_requestId: selecting a result cancels the search that produced it, and
+  // the user still expects the place they tapped to open.
+  GetPlatform().RunTask(Platform::Thread::Network, [this, url, apiKey, onPlace = std::move(onPlace)]()
+  {
+    platform::HttpClient request(url);
+    request.SetRawHeader("X-Goog-Api-Key", apiKey);
+    request.SetRawHeader("X-Goog-FieldMask", kDetailsFieldMask);
+
+    std::string response;
+    if (request.RunHttpRequest() && request.ErrorCode() == 200)
+      response = request.ServerResponse();
+    else
+      LOG(LWARNING, ("GooglePlaces: details failed:", request.ErrorCode(), request.ServerResponse()));
+
+    auto const details = ParsePlaceDetailsResponse(response);
+    if (!details.m_valid)
+      return;
+
+    m_runUITask([details, onPlace]() { onPlace(details); });
+  });
+}
+
+void GooglePlaces::Cancel()
+{
+  ++m_requestId;
+  m_placeIds.clear();
+}
+
+std::string BuildAutocompleteBody(std::string const & query, std::string const & locale,
+                                  std::string const & sessionToken, m2::PointD const & origin)
+{
+  auto const ll = mercator::ToLatLon(origin);
+
+  ApiAutocompleteRequest request;
+  request.m_input = query;
+  request.m_languageCode = locale;
+  request.m_sessionToken = sessionToken;
+  request.m_origin.m_latitude = ll.m_lat;
+  request.m_origin.m_longitude = ll.m_lon;
+  request.m_locationBias.m_circle.m_center = request.m_origin;
+
+  std::string body;
+  {
+    using Sink = MemWriter<std::string>;
+    Sink sink(body);
+    coding::SerializerJson<Sink> ser(sink);
+    ser(request);
+  }
+  return body;
+}
+
+Results ParseAutocompleteResponse(std::string const & json, m2::PointD const & origin,
+                                  std::vector<std::string> & placeIds)
+{
+  Results results;
+  if (json.empty())
+    return results;
+
+  ApiAutocompleteResponse response;
+  try
+  {
+    coding::DeserializerJson des(json);
+    des(response);
+  }
+  catch (RootException const & e)
+  {
+    LOG(LWARNING, ("GooglePlaces: failed to parse autocomplete response:", e.Msg()));
+    return results;
+  }
+
+  for (auto const & suggestion : response.m_suggestions)
+  {
+    auto const & prediction = suggestion.m_placePrediction;
+    if (prediction.m_placeId.empty())
+      continue;
+
+    auto const & title = prediction.m_structuredFormat.m_mainText.m_text.empty()
+                           ? prediction.m_text.m_text
+                           : prediction.m_structuredFormat.m_mainText.m_text;
+    if (title.empty())
+      continue;
+
+    Result result(origin, title);
+    result.SetType(Result::Type::LatLon);
+    result.SetAddress(std::string(prediction.m_structuredFormat.m_secondaryText.m_text));
+    // AddResult() would run the feature dedup path, which asserts on a valid FeatureID.
+    results.AddResultNoChecks(std::move(result));
+    placeIds.push_back(prediction.m_placeId);
+  }
+
+  return results;
+}
+
+std::string NormalizeLanguageCode(std::string const & locale)
+{
+  // The platform hands over a Java Locale.toString(), which is not BCP-47: it separates subtags with
+  // '_' and can append a Unicode extension, e.g. "en_CA_#u-fw-mon-ms-metric-mu-celsius" on a phone
+  // whose region settings have been customized. The API rejects the whole request over it (HTTP 400
+  // INVALID_ARGUMENT), so keep only the language and region subtags it understands.
+  auto const extension = locale.find('#');
+  std::string_view head(locale);
+  if (extension != std::string::npos)
+    head = head.substr(0, extension);
+
+  std::string result;
+  size_t subtags = 0;
+  for (size_t begin = 0; begin < head.size() && subtags < 2;)
+  {
+    auto end = head.find_first_of("_-", begin);
+    if (end == std::string_view::npos)
+      end = head.size();
+
+    auto const subtag = head.substr(begin, end - begin);
+    if (!subtag.empty())
+    {
+      if (!result.empty())
+        result += '-';
+      result += subtag;
+      ++subtags;
+    }
+    begin = end + 1;
+  }
+
+  return result.empty() ? kFallbackLanguageCode : result;
+}
+
+std::string OpeningPeriodsToOsm(std::vector<OpeningPeriod> const & periods)
+{
+  if (periods.empty())
+    return {};
+
+  // A single period without a close point is how the API says "never closes".
+  if (periods.size() == 1 && !periods.front().m_hasClose)
+    return "24/7";
+
+  // Intervals of each day, already formatted, in the order the API listed them.
+  std::array<std::vector<std::string>, kDaysInWeek> byDay;
+  for (auto const & p : periods)
+  {
+    if (!p.m_hasClose)
+      continue;
+
+    // An interval that runs past midnight is written on the day it starts - "Mo 20:00-02:00" already
+    // means "until 2 am on Tuesday" in OSM. Closing exactly at midnight is spelled 24:00 for the same
+    // reason: 00:00 as an end time reads as an empty interval.
+    bool const overnight = p.m_closeDay != p.m_openDay;
+    auto const close = (overnight && p.m_closeHour == 0 && p.m_closeMinute == 0)
+                         ? std::string("24:00")
+                         : FormatHhMm(p.m_closeHour, p.m_closeMinute);
+
+    byDay[ApiDayToOsmIndex(p.m_openDay)].push_back(FormatHhMm(p.m_openHour, p.m_openMinute) + '-' + close);
+  }
+
+  // Merge runs of consecutive days that share the same intervals, so the place page renders one row
+  // per range instead of one per day.
+  std::string result;
+  for (size_t day = 0; day < kDaysInWeek;)
+  {
+    if (byDay[day].empty())
+    {
+      ++day;
+      continue;
+    }
+
+    size_t last = day;
+    while (last + 1 < kDaysInWeek && byDay[last + 1] == byDay[day])
+      ++last;
+
+    if (!result.empty())
+      result += "; ";
+    result += kOsmWeekdays[day];
+    if (last != day)
+    {
+      result += '-';
+      result += kOsmWeekdays[last];
+    }
+    result += ' ';
+    result += strings::JoinStrings(byDay[day], ",");
+
+    day = last + 1;
+  }
+
+  return result;
+}
+
+PlaceDetails ParsePlaceDetailsResponse(std::string const & json)
+{
+  PlaceDetails details;
+  if (json.empty())
+    return details;
+
+  ApiPlaceCore core;
+  try
+  {
+    coding::DeserializerJson des(json);
+    des(core);
+  }
+  catch (RootException const & e)
+  {
+    LOG(LWARNING, ("GooglePlaces: failed to parse details response:", e.Msg(), "in", json));
+    return details;
+  }
+
+  if (core.m_id.empty())
+    return details;
+
+  details.m_point = mercator::FromLatLon(core.m_location.m_latitude, core.m_location.m_longitude);
+  details.m_name = core.m_displayName.m_text;
+  details.m_address = core.m_formattedAddress;
+  // From here on the place is showable; anything that fails below only costs it a row.
+  details.m_valid = true;
+
+  ApiPlaceExtra place;
+  try
+  {
+    coding::DeserializerJson des(json);
+    des(place);
+  }
+  catch (RootException const & e)
+  {
+    LOG(LWARNING, ("GooglePlaces: showing", details.m_name, "without its details:", e.Msg(), "in", json));
+    return details;
+  }
+
+  details.m_subtitle = FormatSubtitle(place);
+
+  std::vector<OpeningPeriod> periods;
+  periods.reserve(place.m_regularOpeningHours.m_periods.size());
+  for (auto const & p : place.m_regularOpeningHours.m_periods)
+  {
+    OpeningPeriod period;
+    period.m_openDay = p.m_open.m_day;
+    period.m_openHour = p.m_open.m_hour;
+    period.m_openMinute = p.m_open.m_minute;
+    period.m_hasClose = !p.IsAlwaysOpen();
+    if (period.m_hasClose)
+    {
+      period.m_closeDay = p.m_close.m_day;
+      period.m_closeHour = p.m_close.m_hour;
+      period.m_closeMinute = p.m_close.m_minute;
+    }
+    periods.push_back(period);
+  }
+
+  // Metadata::Set ignores empty values, so absent fields simply leave their place-page row hidden.
+  details.m_metadata.Set(feature::Metadata::FMD_OPEN_HOURS, OpeningPeriodsToOsm(periods));
+  details.m_metadata.Set(feature::Metadata::FMD_PHONE_NUMBER, place.m_internationalPhoneNumber);
+  details.m_metadata.Set(feature::Metadata::FMD_WEBSITE, place.m_websiteUri);
+
+  return details;
+}
+}  // namespace search
