+#pragma once
+
+#include "map/search_product_info.hpp"
+
+#include "search/result.hpp"
+
+#include "indexer/feature_meta.hpp"
+
+#include "geometry/point2d.hpp"
+
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace search
+{
+// Online place search backed by the Google Places API (New):
+//   POST https://places.googleapis.com/v1/places:autocomplete  -> predictions (no coordinates)
+//   GET  https://places.googleapis.com/v1/places/{placeId}     -> coordinates for the selected one
+//
+// Shares the user-entered API key with GoogleRouter (routing::kGoogleApiKeySetting, "GoogleApiKey" in
+// settings.ini); without a key nothing is requested.
+//
+// Autocomplete carries no coordinates, so a prediction is emitted as a Result::Type::LatLon centred on the
+// query origin - a placeholder, not the place. Two obligations follow for the caller:
+//   1. selection must go through HasPrediction() + GetPlaceDetails() instead of the result's own centre;
+//   2. predictions must not be turned into map marks (Framework runs no viewport search in this mode).
+// The placeholder is deliberate: it keeps predictions inside the ordinary search::Results pipeline, which
+// the platform UI already indexes by position. It is safe because the results are delivered with
+// hasPosition == false, so no distance is derived from it either.
+//
+// All public methods must be called on the GUI thread. HTTP runs on Platform::Thread::Network and results
+// are posted back through the RunUITaskFn given to the constructor.
+struct PlaceDetails;
+
+class GooglePlaces
+{
+public:
+  using OnResults = std::function<void(Results, std::vector<ProductInfo>)>;
+  // Invoked on the GUI thread, only when the details request succeeded.
+  using OnPlace = std::function<void(PlaceDetails const & place)>;
+  using RunUITaskFn = std::function<void(std::function<void()>)>;
+
+  explicit GooglePlaces(RunUITaskFn runUITask);
+
+  // Starts an autocomplete request for |query|, biased towards |origin| (mercator). |onResults| is called
+  // exactly once, on the GUI thread, with the whole result set and the end marker already set - the API
+  // returns everything in one response, so there is nothing to stream. Returns false, without calling
+  // |onResults|, when no API key is set.
+  bool Autocomplete(std::string const & query, std::string const & locale, m2::PointD const & origin,
+                    OnResults onResults);
+
+  // True while |index| addresses a prediction of the current result set.
+  bool HasPrediction(size_t index) const;
+
+  // Resolves the prediction at |index| to a real place and calls |onPlace| on the GUI thread. Does nothing
+  // when the request fails. Precondition: HasPrediction(index).
+  void GetPlaceDetails(size_t index, OnPlace onPlace);
+
+  // Drops the current predictions and makes an in-flight autocomplete response a no-op. Must be called
+  // whenever results from another source replace ours, otherwise a stale placeId would be attached to
+  // someone else's result at the same index.
+  void Cancel();
+
+private:
+  RunUITaskFn const m_runUITask;
+
+  // Bumped by every Autocomplete() and Cancel(); a response whose id no longer matches is discarded.
+  // GUI thread only.
+  uint64_t m_requestId = 0;
+  // Place ids of the current predictions, parallel to the delivered Results. GUI thread only.
+  std::vector<std::string> m_placeIds;
+  // Groups the autocomplete calls of one search with the details call that ends it, which is what the
+  // Places API bills as a single autocomplete session. Empty until the next autocomplete starts one.
+  std::string m_sessionToken;
+  // Language of the current session, so the details call answers in the same one as the predictions.
+  std::string m_languageCode;
+};
+
+// A place as returned by the details endpoint, in the shape the place page wants it.
+// |m_valid| is false for an empty or unparsable response.
+//
+// |m_metadata| holds the fields Organic Maps already knows how to draw for any POI - opening hours
+// (in OSM syntax, see OpeningPeriodsToOsm), phone number and website. They travel to the platform UI
+// through the ordinary InjectMetadata path, so no new place-page section is needed for them.
+struct PlaceDetails
+{
+  m2::PointD m_point;
+  std::string m_name;
+  // Place type, rating and price level joined with feature::kFieldsSeparator, e.g.
+  // "Bakery • ★ 4.5 (2431) • $$". Empty when the API returned none of them.
+  std::string m_subtitle;
+  std::string m_address;
+  feature::Metadata m_metadata;
+  bool m_valid = false;
+};
+
+// --- Pieces exposed for testing -----------------------------------------------------------------
+
+// One entry of regularOpeningHours.periods. Days are the API's own numbering, 0 = Sunday.
+// A period with no close (m_hasClose == false) means the place never closes.
+struct OpeningPeriod
+{
+  int32_t m_openDay = 0;
+  int32_t m_openHour = 0;
+  int32_t m_openMinute = 0;
+  bool m_hasClose = false;
+  int32_t m_closeDay = 0;
+  int32_t m_closeHour = 0;
+  int32_t m_closeMinute = 0;
+};
+
+// Converts a platform locale into the BCP-47 language code the API accepts: "en_CA_#u-fw-mon" and
+// "en_CA" both become "en-CA". Falls back to "en" when nothing usable is left.
+std::string NormalizeLanguageCode(std::string const & locale);
+
+// Renders |periods| as an OSM opening_hours value, e.g. "Mo-Fr 07:00-21:00; Sa,Su 08:00-21:00".
+// Consecutive days with identical intervals are merged into ranges because the place page groups its
+// weekly rows by what a single parsed rule covers - one rule per day would render as seven rows.
+// Days with no interval are simply omitted, which OSM (and the place page) read as closed.
+// Returns "24/7" for an always-open place and an empty string for no periods at all.
+std::string OpeningPeriodsToOsm(std::vector<OpeningPeriod> const & periods);
+
+// Body of the places:autocomplete request. |origin| is mercator and is sent both as the distance origin
+// and as the centre of the location bias.
+std::string BuildAutocompleteBody(std::string const & query, std::string const & locale,
+                                  std::string const & sessionToken, m2::PointD const & origin);
+
+// Converts a places:autocomplete response into results centred on |origin|, appending one place id per
+// result to |placeIds|. Suggestions without a place id (queryPrediction entries) are skipped, so the two
+// stay aligned. An empty or malformed response yields no results rather than throwing.
+Results ParseAutocompleteResponse(std::string const & json, m2::PointD const & origin,
+                                  std::vector<std::string> & placeIds);
+
+// Converts a places/{placeId} response. Returns an invalid PlaceDetails on empty or malformed input.
+PlaceDetails ParsePlaceDetailsResponse(std::string const & json);
+}  // namespace search
