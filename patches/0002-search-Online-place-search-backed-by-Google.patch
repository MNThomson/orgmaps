+void Framework::ShowPlace(search::PlaceDetails const & place)
+{
+  place_page::BuildInfo info;
+  info.m_source = place_page::BuildInfo::Source::Search;
+  info.m_needAnimationOnSelection = false;
+  info.m_mercator = place.m_point;
+  // Nothing here matches a feature in the map data, so don't let the place page snap to a nearby one.
+  info.m_match = place_page::BuildInfo::Match::Nothing;
+
+  m_currentPlacePageInfo = BuildPlacePageInfo(info);
+  m_currentPlacePageInfo->SetCustomNames(place.m_name, place.m_subtitle);
+  m_currentPlacePageInfo->SetUiAddress(place.m_address);
+  m_currentPlacePageInfo->SetMetadata(place.m_metadata);
+
+  if (m_drapeEngine)
+    m_drapeEngine->SetModelViewCenter(m_currentPlacePageInfo->GetMercator(), scales::GetUpperComfortScale(),
+                                      true /* isAnim */, true /* trackVisibleViewport */);
+
+  ActivateMapSelection();
+}
