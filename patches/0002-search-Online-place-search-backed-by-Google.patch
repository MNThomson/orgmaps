new file mode 100644
index 0000000000..f3ac244ee9
--- /dev/null
+++ b/libs/map/map_tests/google_places_tests.cpp
@@ -0,0 +1,261 @@
+#include "testing/testing.hpp"
+
+#include "map/google_places.hpp"
+
+#include "geometry/mercator.hpp"
+
+#include <string>
+#include <vector>
+
+namespace google_places_tests
+{
+using namespace search;
+
+m2::PointD const kOrigin = mercator::FromLatLon(37.7749, -122.4194);
+
+// A trimmed places:autocomplete response: one place prediction, one query prediction (which addresses no
+// place and must be dropped), and one place prediction without a structuredFormat.
+char const kAutocompleteJson[] = R"({
+  "suggestions": [
+    {
+      "placePrediction": {
+        "place": "places/ChIJ_bluebottle",
+        "placeId": "ChIJ_bluebottle",
+        "text": {"text": "Blue Bottle Coffee, Webster Street, Oakland, CA, USA"},
+        "structuredFormat": {
+          "mainText": {"text": "Blue Bottle Coffee"},
+          "secondaryText": {"text": "300 Webster St, Oakland, CA, USA"}
+        },
+        "distanceMeters": 1234
+      }
+    },
+    {
+      "queryPrediction": {
+        "text": {"text": "coffee near me"}
+      }
+    },
+    {
+      "placePrediction": {
+        "placeId": "ChIJ_philz",
+        "text": {"text": "Philz Coffee"}
+      }
+    }
+  ]
+})";
+
+char const kDetailsJson[] = R"({
+  "id": "ChIJ_bluebottle",
+  "displayName": {"text": "Blue Bottle Coffee", "languageCode": "en"},
+  "primaryTypeDisplayName": {"text": "Coffee shop", "languageCode": "en"},
+  "formattedAddress": "300 Webster St, Oakland, CA 94607, USA",
+  "location": {"latitude": 37.8009, "longitude": -122.2745},
+  "rating": 4.5,
+  "userRatingCount": 2431,
+  "priceLevel": "PRICE_LEVEL_MODERATE",
+  "internationalPhoneNumber": "+1 510-653-3394",
+  "websiteUri": "https://bluebottlecoffee.com/",
+  "regularOpeningHours": {
+    "openNow": true,
+    "periods": [
+      {"open": {"day": 1, "hour": 7, "minute": 0}, "close": {"day": 1, "hour": 18, "minute": 0}},
+      {"open": {"day": 2, "hour": 7, "minute": 0}, "close": {"day": 2, "hour": 18, "minute": 0}},
+      {"open": {"day": 3, "hour": 7, "minute": 0}, "close": {"day": 3, "hour": 18, "minute": 0}},
+      {"open": {"day": 4, "hour": 7, "minute": 0}, "close": {"day": 4, "hour": 18, "minute": 0}},
+      {"open": {"day": 5, "hour": 7, "minute": 0}, "close": {"day": 5, "hour": 18, "minute": 0}},
+      {"open": {"day": 6, "hour": 8, "minute": 30}, "close": {"day": 6, "hour": 17, "minute": 0}},
+      {"open": {"day": 0, "hour": 8, "minute": 30}, "close": {"day": 0, "hour": 17, "minute": 0}}
+    ]
+  }
+})";
+
+OpeningPeriod Period(int32_t openDay, int32_t openHour, int32_t openMinute, int32_t closeDay, int32_t closeHour,
+                     int32_t closeMinute)
+{
+  OpeningPeriod p;
+  p.m_openDay = openDay;
+  p.m_openHour = openHour;
+  p.m_openMinute = openMinute;
+  p.m_hasClose = true;
+  p.m_closeDay = closeDay;
+  p.m_closeHour = closeHour;
+  p.m_closeMinute = closeMinute;
+  return p;
+}
+
+UNIT_TEST(GooglePlaces_ParseAutocomplete)
+{
+  std::vector<std::string> placeIds;
+  auto const results = ParseAutocompleteResponse(kAutocompleteJson, kOrigin, placeIds);
+
+  TEST_EQUAL(results.GetCount(), 2, ());
+  TEST_EQUAL(placeIds.size(), results.GetCount(), ("Place ids must stay aligned with the results."));
+  TEST_EQUAL(placeIds[0], "ChIJ_bluebottle", ());
+  TEST_EQUAL(placeIds[1], "ChIJ_philz", ());
+
+  TEST_EQUAL(results[0].GetString(), "Blue Bottle Coffee", ());
+  TEST_EQUAL(results[0].GetAddress(), "300 Webster St, Oakland, CA, USA", ());
+  TEST_EQUAL(results[0].GetResultType(), Result::Type::LatLon, ());
+  TEST_EQUAL(results[0].GetFeatureCenter(), kOrigin, ("Predictions carry the query origin as a placeholder."));
+
+  // No structuredFormat: the whole prediction text becomes the title and there is no address.
+  TEST_EQUAL(results[1].GetString(), "Philz Coffee", ());
+  TEST(results[1].GetAddress().empty(), (results[1].GetAddress()));
+}
+
+UNIT_TEST(GooglePlaces_ParseAutocompleteEmpty)
+{
+  std::vector<std::string> placeIds;
+
+  TEST_EQUAL(ParseAutocompleteResponse("", kOrigin, placeIds).GetCount(), 0, ("Empty body, e.g. after HTTP 403."));
+  TEST_EQUAL(ParseAutocompleteResponse("{}", kOrigin, placeIds).GetCount(), 0, ("No matches at all."));
+  TEST_EQUAL(ParseAutocompleteResponse(R"({"suggestions": []})", kOrigin, placeIds).GetCount(), 0, ());
+  TEST_EQUAL(
+      ParseAutocompleteResponse(R"({"suggestions": [{"queryPrediction": {"text": {"text": "x"}}}]})", kOrigin, placeIds)
+          .GetCount(),
+      0, ("A query prediction addresses no place."));
+  TEST(placeIds.empty(), (placeIds.size()));
+}
+
+UNIT_TEST(GooglePlaces_ParseAutocompleteMalformed)
+{
+  std::vector<std::string> placeIds;
+
+  // Truncated and outright invalid bodies must degrade to "nothing found", not throw.
+  TEST_EQUAL(
+      ParseAutocompleteResponse(R"({"suggestions": [{"placePrediction": {"placeId":)", kOrigin, placeIds).GetCount(), 0,
+      ());
+  TEST_EQUAL(ParseAutocompleteResponse("not json at all", kOrigin, placeIds).GetCount(), 0, ());
+  TEST(placeIds.empty(), (placeIds.size()));
+}
+
+UNIT_TEST(GooglePlaces_ParseDetails)
+{
+  auto const details = ParsePlaceDetailsResponse(kDetailsJson);
+
+  TEST(details.m_valid, ());
+  TEST_EQUAL(details.m_name, "Blue Bottle Coffee", ());
+  TEST_EQUAL(details.m_address, "300 Webster St, Oakland, CA 94607, USA", ());
+  TEST_EQUAL(details.m_subtitle, "Coffee shop • ★ 4.5 (2431) • $$", ());
+
+  auto const ll = mercator::ToLatLon(details.m_point);
+  TEST_ALMOST_EQUAL_ABS(ll.m_lat, 37.8009, 1e-6, ());
+  TEST_ALMOST_EQUAL_ABS(ll.m_lon, -122.2745, 1e-6, ());
+
+  using MD = feature::Metadata;
+  TEST_EQUAL(details.m_metadata.Get(MD::FMD_PHONE_NUMBER), "+1 510-653-3394", ());
+  TEST_EQUAL(details.m_metadata.Get(MD::FMD_WEBSITE), "https://bluebottlecoffee.com/", ());
+  // Sunday closes the OSM week, so a weekend pair is one range rather than two days.
+  TEST_EQUAL(details.m_metadata.Get(MD::FMD_OPEN_HOURS), "Mo-Fr 07:00-18:00; Sa-Su 08:30-17:00", ());
+}
+
+UNIT_TEST(GooglePlaces_ParseDetailsPartial)
+{
+  // formattedAddress is optional (a plus-code place has none); the place is still usable.
+  auto const noAddress = ParsePlaceDetailsResponse(
+      R"({"id": "ChIJ_x", "displayName": {"text": "Somewhere"}, "location": {"latitude": 1.0, "longitude": 2.0}})");
+  TEST(noAddress.m_valid, ());
+  TEST(noAddress.m_address.empty(), (noAddress.m_address));
+  // Nothing to build a subtitle from, and no metadata rows to draw.
+  TEST(noAddress.m_subtitle.empty(), (noAddress.m_subtitle));
+  TEST(noAddress.m_metadata.Empty(), ());
+
+  // A rating with no vote count and no price level still makes a subtitle.
+  auto const ratingOnly = ParsePlaceDetailsResponse(R"({"id": "ChIJ_x", "rating": 4.0})");
+  TEST_EQUAL(ratingOnly.m_subtitle, "★ 4.0", ());
+
+  // Without an id there is no place, whatever else the body contains.
+  TEST(!ParsePlaceDetailsResponse(R"({"error": {"code": 404}})").m_valid, ());
+  TEST(!ParsePlaceDetailsResponse("").m_valid, ());
+  TEST(!ParsePlaceDetailsResponse("}{").m_valid, ());
+}
+
+UNIT_TEST(GooglePlaces_ParseDetailsAlwaysOpen)
+{
+  // An always-open place has one period with an open point and no close key at all.
+  auto const details = ParsePlaceDetailsResponse(R"({
+    "id": "ChIJ_24h",
+    "displayName": {"text": "Night Owl"},
+    "location": {"latitude": 1.0, "longitude": 2.0},
+    "regularOpeningHours": {"openNow": true, "periods": [{"open": {"day": 0, "hour": 0, "minute": 0}}]}
+  })");
+
+  TEST(details.m_valid, ());
+  TEST_EQUAL(details.m_metadata.Get(feature::Metadata::FMD_OPEN_HOURS), "24/7", ());
+}
+
+UNIT_TEST(GooglePlaces_ParseDetailsSurvivesBadExtras)
+{
+  // Regression: modelling periods[].close as an array made the whole parse throw, so tapping a
+  // result with opening hours silently did nothing. A field we cannot read must never cost the user
+  // the place - name, address and coordinates come from a separate pass.
+  auto const details = ParsePlaceDetailsResponse(R"({
+    "id": "ChIJ_bad",
+    "displayName": {"text": "Somewhere"},
+    "formattedAddress": "1 Main St",
+    "location": {"latitude": 1.0, "longitude": 2.0},
+    "regularOpeningHours": {"periods": "not an array"}
+  })");
+
+  TEST(details.m_valid, ());
+  TEST_EQUAL(details.m_name, "Somewhere", ());
+  TEST_EQUAL(details.m_address, "1 Main St", ());
+  TEST(details.m_metadata.Empty(), ("Unreadable extras are dropped, not guessed at."));
+}
+
+UNIT_TEST(GooglePlaces_OpeningPeriodsToOsm)
+{
+  TEST_EQUAL(OpeningPeriodsToOsm({}), "", ("A place whose hours Google does not know."));
+
+  // Always open: one period, no close point at all.
+  TEST_EQUAL(OpeningPeriodsToOsm({OpeningPeriod{}}), "24/7", ());
+
+  // Runs of identical consecutive days merge; a lone day stands alone. Day 0 is Sunday, and Sunday
+  // must come last because OSM writes a week from Monday.
+  TEST_EQUAL(OpeningPeriodsToOsm({Period(1, 9, 0, 1, 17, 0), Period(2, 9, 0, 2, 17, 0), Period(3, 9, 0, 3, 17, 0),
+                                  Period(0, 10, 0, 0, 16, 0)}),
+             "Mo-We 09:00-17:00; Su 10:00-16:00", ());
+
+  // Days Google omits are closed, and stay omitted rather than breaking the run either side of them.
+  TEST_EQUAL(OpeningPeriodsToOsm({Period(1, 9, 0, 1, 17, 0), Period(5, 9, 0, 5, 17, 0)}),
+             "Mo 09:00-17:00; Fr 09:00-17:00", ());
+
+  // A split day keeps both intervals, comma-separated, in the order the API listed them.
+  TEST_EQUAL(OpeningPeriodsToOsm({Period(1, 9, 0, 1, 12, 0), Period(1, 13, 30, 1, 17, 0)}),
+             "Mo 09:00-12:00,13:30-17:00", ());
+
+  // An interval past midnight belongs to the day it starts on; closing at midnight is written 24:00,
+  // because 00:00 as an end time reads as an empty interval.
+  TEST_EQUAL(OpeningPeriodsToOsm({Period(5, 20, 0, 6, 2, 0)}), "Fr 20:00-02:00", ());
+  TEST_EQUAL(OpeningPeriodsToOsm({Period(5, 20, 0, 6, 0, 0)}), "Fr 20:00-24:00", ());
+}
+
+UNIT_TEST(GooglePlaces_NormalizeLanguageCode)
+{
+  // Regression: a phone with customized region settings reports its locale with a Unicode extension,
+  // and sending that verbatim made every autocomplete request fail with HTTP 400 INVALID_ARGUMENT.
+  TEST_EQUAL(NormalizeLanguageCode("en_CA_#u-fw-mon-ms-metric-mu-celsius"), "en-CA", ());
+
+  TEST_EQUAL(NormalizeLanguageCode("en"), "en", ());
+  TEST_EQUAL(NormalizeLanguageCode("en_US"), "en-US", ());
+  TEST_EQUAL(NormalizeLanguageCode("pt-BR"), "pt-BR", ("Already BCP-47, must survive untouched."));
+  TEST_EQUAL(NormalizeLanguageCode("th_TH_TH"), "th-TH", ("A variant subtag is not part of BCP-47 here."));
+  TEST_EQUAL(NormalizeLanguageCode("zh__#Hans"), "zh", ("An empty region must not leave a dangling dash."));
+  TEST_EQUAL(NormalizeLanguageCode(""), "en", ());
+  TEST_EQUAL(NormalizeLanguageCode("_"), "en", ());
+}
+
+UNIT_TEST(GooglePlaces_BuildAutocompleteBody)
+{
+  auto const body = BuildAutocompleteBody("cafe", "en", "deadbeef", kOrigin);
+
+  TEST(body.find(R"("input":"cafe")") != std::string::npos, (body));
+  TEST(body.find(R"("languageCode":"en")") != std::string::npos, (body));
+  TEST(body.find(R"("sessionToken":"deadbeef")") != std::string::npos, (body));
+  TEST(body.find("locationBias") != std::string::npos, (body));
+  TEST(body.find("37.77") != std::string::npos, ("The origin must be sent in WGS84, not mercator.", body));
+
+  // The query goes into JSON verbatim, so anything the user can type must be escaped by the serializer.
+  auto const quoted = BuildAutocompleteBody(R"(say "hi"\)", "en", "t", kOrigin);
+  TEST(quoted.find(R"("input":"say \"hi\"\\")") != std::string::npos, (quoted));
+}
+}  // namespace google_places_tests
