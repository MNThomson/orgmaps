+// A Google prediction only knows its place id, so the coordinates are fetched before the place page can
+// be opened. Returns true when |index| is such a prediction and the fetch was started, i.e. when the
+// caller must not fall through to the offline path (g_results[index] holds a placeholder centre there).
+bool ResolveGooglePrediction(jint index)
+{
+  auto & places = g_framework->NativeFramework()->GetGooglePlaces();
+  if (!places.HasPrediction(static_cast<size_t>(index)))
+    return false;
+
+  places.GetPlaceDetails(static_cast<size_t>(index),
+                         [](search::PlaceDetails const & place) { g_framework->NativeFramework()->ShowPlace(place); });
+  return true;
+}
 }  // namespace
 
