+JNIEXPORT jboolean Java_app_organicmaps_sdk_search_SearchEngine_nativeRunGoogleSearch(JNIEnv * env, jclass clazz,
+                                                                                      jbyteArray bytes, jstring lang,
+                                                                                      jlong timestamp,
+                                                                                      jboolean hasPosition, jdouble lat,
+                                                                                      jdouble lon)
+{
+  auto * fr = g_framework->NativeFramework();
+
+  // Bias the predictions towards the user, or towards whatever part of the world they are looking at.
+  auto const origin = hasPosition ? mercator::FromLatLon(lat, lon) : fr->GetCurrentViewport().Center();
+
+  // Predictions carry no coordinates of their own, so pass hasPosition == false: ToJavaResult would
+  // otherwise measure the distance to the placeholder centre and show a made-up number.
+  // isMapAndTable is false as well - there is no viewport search to poke in this mode.
+  auto const started = fr->GetGooglePlaces().Autocomplete(
+      jni::ToNativeString(env, bytes), jni::ToNativeString(env, lang), origin,
+      std::bind(&OnResults, _1, _2, timestamp, false /* isMapAndTable */, false /* hasPosition */, 0.0, 0.0));
+
+  if (started)
+    g_queryTimestamp = timestamp;
+  return started;
+}
