index 0000000000..a4e15f1b40
--- /dev/null
+++ b/android/libs/garmin/src/main/java/app/organicmaps/garmin/GarminNavState.java
@@ -0,0 +1,268 @@
+package app.organicmaps.garmin;
+
+import android.content.Context;
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import app.organicmaps.sdk.routing.LaneInfo;
+import app.organicmaps.sdk.routing.LaneWay;
+import app.organicmaps.sdk.routing.RoutingInfo;
+import app.organicmaps.sdk.util.Distance;
+import java.util.ArrayList;
+import java.util.Calendar;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/**
+ * A snapshot of navigation state, small enough to push over a Bluetooth Low Energy link to a Garmin
+ * watch. Garmin measures under 1 KB/s of throughput with multi-second latency, so the wire format
+ * uses single-character keys and {@link #toMessage} omits the slow-changing fields whenever they
+ * have not changed since the previous message.
+ * <p>
+ * Distances are sent twice over: pre-formatted for display, so the watch needs no locale or unit
+ * handling of its own, and as plain metres, so the watch can decide when to buzz without parsing
+ * anything.
+ */
+public final class GarminNavState
+{
+  /** Turn direction, an {@code app.organicmaps.sdk.routing.CarDirection} ordinal. */
+  public static final String KEY_TURN = "t";
+  /** Roundabout exit number, 0 when not applicable. */
+  public static final String KEY_EXIT = "x";
+  /** Distance to the next turn, formatted for display, e.g. {@code "250 m"}. */
+  public static final String KEY_DIST_TO_TURN = "d";
+  /** Distance to the next turn in metres, for the watch's vibration thresholds. */
+  public static final String KEY_DIST_TO_TURN_M = "m";
+  /** Name of the street being turned onto. */
+  public static final String KEY_NEXT_STREET = "s";
+  /** Distance remaining to the destination, formatted for display. */
+  public static final String KEY_DIST_REMAINING = "r";
+  /**
+   * Clock time of arrival, as minutes since local midnight, or {@link #ARRIVAL_UNKNOWN}. Absolute
+   * rather than "seconds remaining" so that the watch has nothing to recompute: a remaining time goes
+   * stale the moment it lands, whereas an arrival time only changes when the estimate itself does.
+   */
+  public static final String KEY_ARRIVAL_MINUTE = "a";
+  /** {@link #KEY_ARRIVAL_MINUTE} value for a route with no usable estimate yet. */
+  public static final int ARRIVAL_UNKNOWN = -1;
+  /** Minutes in a day, the modulus for {@link #KEY_ARRIVAL_MINUTE}. */
+  static final int MINUTES_PER_DAY = 24 * 60;
+  /**
+   * Lane guidance: one integer per lane, left to right. The low four bits are a
+   * {@code app.organicmaps.sdk.routing.LaneWay} ordinal — the direction to draw for that lane — and
+   * {@link #LANE_ACTIVE_FLAG} marks the lanes to actually be in. Empty when there is no guidance,
+   * which is most of the time: the core only fills lanes in as a turn gets close.
+   */
+  public static final String KEY_LANES = "l";
+  /** Set on a lane that serves the upcoming manoeuvre. */
+  public static final int LANE_ACTIVE_FLAG = 16;
+  /** Present only on the final message of a session; see {@link #finished}. */
+  public static final String KEY_FINISHED = "f";
+  /** {@link #KEY_FINISHED} value for a route that ran to its end. */
+  public static final int FINISHED_ARRIVED = 1;
+  /** {@link #KEY_FINISHED} value for a route that was cancelled or reset part way. */
+  public static final int FINISHED_CANCELLED = 2;
+
+  private static final int SECONDS_PER_MINUTE = 60;
+
+  private static final double FEET_PER_METRE = 0.3048;
+  private static final double METRES_PER_MILE = 1609.344;
+  private static final double METRES_PER_KILOMETRE = 1000.0;
+
+  public final int turn;
+  public final int exitNum;
+  @NonNull
+  public final String distToTurn;
+  public final int distToTurnMeters;
+  @NonNull
+  public final String nextStreet;
+  @NonNull
+  public final String distToTarget;
+  /** See {@link #KEY_ARRIVAL_MINUTE}. */
+  public final int arrivalMinute;
+  @NonNull
+  public final List<Integer> lanes;
+
+  public GarminNavState(int turn, int exitNum, @NonNull String distToTurn, int distToTurnMeters,
+                        @NonNull String nextStreet, @NonNull String distToTarget, int arrivalMinute,
+                        @NonNull List<Integer> lanes)
+  {
+    this.turn = turn;
+    this.exitNum = exitNum;
+    this.distToTurn = distToTurn;
+    this.distToTurnMeters = distToTurnMeters;
+    this.nextStreet = nextStreet;
+    this.distToTarget = distToTarget;
+    this.arrivalMinute = arrivalMinute;
+    this.lanes = lanes;
+  }
+
+  @NonNull
+  public static GarminNavState from(@NonNull Context context, @NonNull RoutingInfo info)
+  {
+    final Calendar now = Calendar.getInstance();
+    final int secondsOfDay =
+        now.get(Calendar.HOUR_OF_DAY) * 3600 + now.get(Calendar.MINUTE) * SECONDS_PER_MINUTE + now.get(Calendar.SECOND);
+
+    return new GarminNavState(info.carDirection.ordinal(), info.exitNum, info.distToTurn.toString(context),
+                              toMeters(info.distToTurn), info.nextStreet == null ? "" : info.nextStreet,
+                              info.distToTarget.toString(context),
+                              arrivalMinute(secondsOfDay, info.totalTimeInSeconds), encodeLanes(info.lanes));
+  }
+
+  /**
+   * Turns a remaining time into the clock minute of arrival, wrapping past midnight. Truncated rather
+   * than rounded, to match what the phone shows in its own navigation menu.
+   *
+   * @param secondsOfDay  seconds since local midnight, right now.
+   * @param etaSeconds    seconds remaining to the destination, or a non-positive value when the core
+   *                      has no estimate yet.
+   */
+  static int arrivalMinute(int secondsOfDay, int etaSeconds)
+  {
+    if (etaSeconds <= 0)
+      return ARRIVAL_UNKNOWN;
+
+    return ((secondsOfDay + etaSeconds) / SECONDS_PER_MINUTE) % MINUTES_PER_DAY;
+  }
+
+  /**
+   * Flattens lane guidance to one integer per lane. The choice of which arrow to draw is made here
+   * rather than on the watch, because the watch only sees what it is sent.
+   */
+  @NonNull
+  static List<Integer> encodeLanes(@Nullable LaneInfo[] lanes)
+  {
+    if (lanes == null || lanes.length == 0)
+      return Collections.emptyList();
+
+    final List<Integer> encoded = new ArrayList<>(lanes.length);
+    for (final LaneInfo lane : lanes)
+    {
+      final boolean active = lane.mActiveLaneWay != null && lane.mActiveLaneWay != LaneWay.None;
+      // An active lane draws the direction you would actually take in it; the rest just show what
+      // they are for, so you can count across to the one you want.
+      final LaneWay way = active ? lane.mActiveLaneWay : representativeWay(lane.mLaneWays);
+      encoded.add(way.ordinal() | (active ? LANE_ACTIVE_FLAG : 0));
+    }
+    return encoded;
+  }
+
+  @NonNull
+  private static LaneWay representativeWay(@Nullable LaneWay[] ways)
+  {
+    if (ways == null)
+      return LaneWay.Through;
+
+    // Prefer Through: a lane that also goes straight on reads more clearly as "not your lane" than
+    // whichever turn it happens to permit as well.
+    for (final LaneWay way : ways)
+      if (way == LaneWay.Through)
+        return way;
+    for (final LaneWay way : ways)
+      if (way != LaneWay.None)
+        return way;
+    return LaneWay.Through;
+  }
+
+  /**
+   * The message that tells the watch this navigation session is over, so it stops showing a stale
+   * countdown. Not a {@link GarminNavState} because none of the fields mean anything any more.
+   * <p>
+   * Carries why it ended: arriving deserves an arrival screen and an alert, whereas cancelling a
+   * route half way through should quietly return the watch to its idle screen.
+   */
+  @NonNull
+  public static Map<String, Object> finished(boolean arrived)
+  {
+    final Map<String, Object> message = new HashMap<>(1);
+    message.put(KEY_FINISHED, arrived ? FINISHED_ARRIVED : FINISHED_CANCELLED);
+    return message;
+  }
+
+  /**
+   * Builds the message to send, given the last state the watch was told about. Only keys whose
+   * values have changed are included, because the watch keeps its previous value for any absent key.
+   * An empty result therefore means there is nothing worth spending a transfer on.
+   *
+   * @param previous the last state the watch is known to have received, or null to send everything,
+   *                 which is what happens on the first message of a session, after a failed send,
+   *                 and whenever the watch app asks to be resynchronised.
+   */
+  @NonNull
+  public Map<String, Object> toMessage(@Nullable GarminNavState previous)
+  {
+    final Map<String, Object> message = new HashMap<>();
+
+    if (previous == null || turn != previous.turn)
+      message.put(KEY_TURN, turn);
+    if (previous == null || exitNum != previous.exitNum)
+      message.put(KEY_EXIT, exitNum);
+    if (previous == null || !distToTurn.equals(previous.distToTurn))
+      message.put(KEY_DIST_TO_TURN, distToTurn);
+    if (previous == null || distToTurnMeters != previous.distToTurnMeters)
+      message.put(KEY_DIST_TO_TURN_M, distToTurnMeters);
+    if (previous == null || !nextStreet.equals(previous.nextStreet))
+      message.put(KEY_NEXT_STREET, nextStreet);
+    if (previous == null || !distToTarget.equals(previous.distToTarget))
+      message.put(KEY_DIST_REMAINING, distToTarget);
+    // Changes roughly once a minute at most, and only when the estimate really moves, so it needs no
+    // tolerance of its own.
+    if (previous == null || arrivalMinute != previous.arrivalMinute)
+      message.put(KEY_ARRIVAL_MINUTE, arrivalMinute);
+    // Sent even when it becomes empty, so the watch clears the strip once the turn is behind us.
+    if (previous == null || !lanes.equals(previous.lanes))
+      message.put(KEY_LANES, lanes);
+
+    return message;
+  }
+
+  /**
+   * Converts a display distance to metres. {@link Distance#mDistance} is expressed in
+   * {@link Distance#mUnits}, which follows the user's measurement setting.
+   */
+  @SuppressWarnings("WeakerAccess") // Package-private for testing.
+  static int toMeters(@NonNull Distance distance)
+  {
+    if (!distance.isValid())
+      return 0;
+
+    final double meters = switch (distance.mUnits)
+    {
+      case Meters -> distance.mDistance;
+      case Kilometers -> distance.mDistance * METRES_PER_KILOMETRE;
+      case Feet -> distance.mDistance * FEET_PER_METRE;
+      case Miles -> distance.mDistance * METRES_PER_MILE;
+    };
+    return (int) Math.round(meters);
+  }
+
+  @Override
+  public boolean equals(@Nullable Object other)
+  {
+    if (this == other)
+      return true;
+    if (!(other instanceof GarminNavState that))
+      return false;
+
+    return turn == that.turn && exitNum == that.exitNum && distToTurnMeters == that.distToTurnMeters
+ && arrivalMinute == that.arrivalMinute && distToTurn.equals(that.distToTurn) && nextStreet.equals(that.nextStreet)
+ && distToTarget.equals(that.distToTarget) && lanes.equals(that.lanes);
+  }
+
+  @Override
+  public int hashCode()
+  {
+    return Objects.hash(turn, exitNum, distToTurn, distToTurnMeters, nextStreet, distToTarget, arrivalMinute, lanes);
+  }
+
+  @NonNull
+  @Override
+  public String toString()
+  {
+    return "GarminNavState{turn=" + turn + ", exit=" + exitNum + ", distToTurn=" + distToTurn + " (" + distToTurnMeters
+  + " m), nextStreet=" + nextStreet + ", distToTarget=" + distToTarget + ", arrivalMinute=" + arrivalMinute + "}";
+  }
+}
diff --git a/android/libs/garmin/src/main/java/app/organicmaps/garmin/GarminSender.java b/android/libs/garmin/src/main/java/app/organicmaps/garmin/GarminSender.java
new file mode 100644
index 0000000000..1f5caad2ba
--- /dev/null
+++ b/android/libs/garmin/src/main/java/app/organicmaps/garmin/GarminSender.java
@@ -0,0 +1,203 @@
+package app.organicmaps.garmin;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import java.util.Map;
+
+/**
+ * Rations navigation updates down to what a Bluetooth Low Energy link to a watch can actually carry.
+ * <p>
+ * Garmin caps concurrent transfers at three and warns that exceeding it produces queue-full errors,
+ * so this keeps exactly one transfer in flight. Updates that arrive meanwhile overwrite a single
+ * pending slot rather than queueing, so the watch always receives the newest state instead of
+ * working through a backlog of stale ones. Anything that would tell the watch nothing new is dropped
+ * outright.
+ * <p>
+ * Deliberately free of Android dependencies so it can be unit tested, which is also why the timeout
+ * on an unacknowledged transfer is driven by the timestamps passed in rather than by a timer.
+ * Not thread safe: every entry point must be called on the same thread.
+ */
+public final class GarminSender
+{
+  /**
+   * Minimum gap between transfers. Sending faster than the link drains simply grows latency, which
+   * matters more than freshness here because the watch counts down turn distances itself.
+   */
+  static final long MIN_INTERVAL_MS = 1500;
+
+  /**
+   * How long to wait for the Connect IQ SDK to report the outcome of a transfer before giving up on
+   * it. Observed on real hardware: when the watch drops off Bluetooth mid-transfer, neither the
+   * success nor the failure callback ever arrives. Without this the single in-flight slot would stay
+   * occupied forever and no further update would ever be sent. Generous, because Garmin measures
+   * seven seconds or more for even a small message.
+   */
+  static final long SEND_TIMEOUT_MS = 15000;
+
+  public interface Transport
+  {
+    /**
+     * Hands a message to the Connect IQ SDK. The implementation should call
+     * {@link GarminSender#onSendFinished} with this token once the outcome is known, but is not
+     * required to: an outcome that never arrives is timed out.
+     */
+    void send(@NonNull Map<String, Object> message, long token);
+  }
+
+  @NonNull
+  private final Transport mTransport;
+
+  // The newest state not yet sent, or null when the watch is up to date. Overwritten, never queued.
+  @Nullable
+  private GarminNavState mPending;
+  // The last state the watch is known to have received. Advanced only when a send succeeds, so a
+  // failed, abandoned or lost transfer causes the next message to carry every field again.
+  @Nullable
+  private GarminNavState mLastSent;
+  // The state currently being transferred, promoted to mLastSent once it is acknowledged.
+  @Nullable
+  private GarminNavState mInFlight;
+  // Whether the message in flight carries every field. Only a complete message can re-establish the
+  // baseline after the watch has forgotten it.
+  private boolean mInFlightIsComplete;
+  // Set while the watch is known to have discarded its state and no complete message has landed
+  // since. Outlives a single send, unlike simply clearing mLastSent, because a transfer started
+  // before the reset can still be acknowledged afterwards.
+  private boolean mResyncing;
+  private long mInFlightToken;
+  private long mNextToken;
+  private long mLastSendAtMs;
+  private int mDropped;
+  private int mAbandoned;
+
+  public GarminSender(@NonNull Transport transport)
+  {
+    mTransport = transport;
+  }
+
+  /**
+   * Offers the latest navigation state. Sends it, coalesces it into the pending slot, or drops it.
+   */
+  public void offer(@NonNull GarminNavState state, long nowMs)
+  {
+    if (state.equals(mLastSent))
+    {
+      // Nothing has moved since the watch was last updated.
+      mPending = null;
+      return;
+    }
+
+    mPending = state;
+    flush(nowMs);
+  }
+
+  /**
+   * Reports the outcome of the transfer started by {@link Transport#send}, and starts the next one if
+   * state has moved on in the meantime. Outcomes for transfers already timed out are ignored.
+   */
+  public void onSendFinished(long token, boolean success, long nowMs)
+  {
+    if (mInFlight == null || token != mInFlightToken)
+      return;
+
+    // A diff acknowledged during a resync says nothing about what the watch holds: it was serialised
+    // against a baseline the watch has since thrown away. Promoting it would make the next message a
+    // diff too, and the fields neither message carried would never reach the blank screen.
+    if (success && (!mResyncing || mInFlightIsComplete))
+      mLastSent = mInFlight;
+    if (success && mInFlightIsComplete)
+      mResyncing = false;
+    mInFlight = null;
+    flush(nowMs);
+  }
+
+  /**
+   * Forgets what the watch is believed to know, so the next message carries the complete state.
+   * Called when the watch app (re)starts, since it comes up with an empty screen. Stays in force
+   * until a complete message is acknowledged, so a transfer already on the wire cannot restore the
+   * baseline the watch just discarded.
+   */
+  public void resetSentState()
+  {
+    mLastSent = null;
+    mResyncing = true;
+  }
+
+  /**
+   * Clears all state for a new navigation session.
+   */
+  public void reset()
+  {
+    mPending = null;
+    mLastSent = null;
+    mInFlight = null;
+    mInFlightIsComplete = false;
+    mResyncing = false;
+    mLastSendAtMs = 0;
+    mDropped = 0;
+    mAbandoned = 0;
+  }
+
+  /**
+   * Number of updates discarded so far, for tuning {@link #MIN_INTERVAL_MS}.
+   */
+  public int getDroppedCount()
+  {
+    return mDropped;
+  }
+
+  /**
+   * Number of transfers the SDK never reported an outcome for.
+   */
+  public int getAbandonedCount()
+  {
+    return mAbandoned;
+  }
+
+  public boolean isSending()
+  {
+    return mInFlight != null;
+  }
+
+  private void flush(long nowMs)
+  {
+    if (mInFlight != null)
+    {
+      if (nowMs - mLastSendAtMs < SEND_TIMEOUT_MS)
+        return;
+
+      // The SDK never told us what happened. Give up on it and carry on; because mLastSent was not
+      // advanced, the next message repeats everything this one was carrying.
+      ++mAbandoned;
+      mInFlight = null;
+    }
+
+    if (mPending == null)
+      return;
+
+    if (mLastSendAtMs != 0 && nowMs - mLastSendAtMs < MIN_INTERVAL_MS)
+    {
+      // Too soon. The state stays pending and the next offer or completion will retry it.
+      ++mDropped;
+      return;
+    }
+
+    final Map<String, Object> message = mPending.toMessage(mLastSent);
+    if (message.isEmpty())
+    {
+      // Every field matches what the watch already has; nothing to spend a transfer on.
+      mPending = null;
+      ++mDropped;
+      return;
+    }
+
+    // mLastSent is null exactly when toMessage was given no previous state, so this message holds
+    // every field.
+    mInFlightIsComplete = mLastSent == null;
+    mInFlight = mPending;
+    mInFlightToken = ++mNextToken;
+    mPending = null;
+    mLastSendAtMs = nowMs;
+    mTransport.send(message, mInFlightToken);
+  }
+}
diff --git a/android/libs/garmin/src/test/java/app/organicmaps/garmin/GarminNavStateTest.java b/android/libs/garmin/src/test/java/app/organicmaps/garmin/GarminNavStateTest.java
new file mode 100644
index 0000000000..d5fd3590d6
--- /dev/null
+++ b/android/libs/garmin/src/test/java/app/organicmaps/garmin/GarminNavStateTest.java
@@ -0,0 +1,252 @@
+package app.organicmaps.garmin;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotEquals;
+import static org.junit.Assert.assertTrue;
+
+import app.organicmaps.sdk.routing.CarDirection;
+import app.organicmaps.sdk.routing.LaneInfo;
+import app.organicmaps.sdk.routing.LaneWay;
+import app.organicmaps.sdk.util.Distance;
+import java.util.List;
+import java.util.Map;
+import org.junit.Test;
+
+public class GarminNavStateTest
+{
+  private static GarminNavState state(int turn, String distToTurn, int meters, String street, String target,
+                                      int arrivalMinute)
+  {
+    return new GarminNavState(turn, 0, distToTurn, meters, street, target, arrivalMinute, List.of());
+  }
+
+  /**
+   * The watch app hard-codes these numbers in {@code garmin/om-nav/source/TurnGlyphs.mc}, because
+   * {@link GarminNavState#KEY_TURN} carries a {@link CarDirection} ordinal. Inserting or reordering a
+   * value here would silently point the watch at the wrong arrow, so pin them down.
+   */
+  @Test
+  public void carDirectionOrdinalsMatchTheWatchApp()
+  {
+    assertEquals(0, CarDirection.NoTurn.ordinal());
+    assertEquals(1, CarDirection.GoStraight.ordinal());
+    assertEquals(2, CarDirection.TurnRight.ordinal());
+    assertEquals(3, CarDirection.TurnSharpRight.ordinal());
+    assertEquals(4, CarDirection.TurnSlightRight.ordinal());
+    assertEquals(5, CarDirection.TurnLeft.ordinal());
+    assertEquals(6, CarDirection.TurnSharpLeft.ordinal());
+    assertEquals(7, CarDirection.TurnSlightLeft.ordinal());
+    assertEquals(8, CarDirection.UTurnLeft.ordinal());
+    assertEquals(9, CarDirection.UTurnRight.ordinal());
+    assertEquals(10, CarDirection.EnterRoundAbout.ordinal());
+    assertEquals(11, CarDirection.LeaveRoundAbout.ordinal());
+    assertEquals(12, CarDirection.StayOnRoundAbout.ordinal());
+    assertEquals(13, CarDirection.StartAtEndOfStreet.ordinal());
+    assertEquals(14, CarDirection.ReachedYourDestination.ordinal());
+    assertEquals(15, CarDirection.ExitHighwayToLeft.ordinal());
+    assertEquals(16, CarDirection.ExitHighwayToRight.ordinal());
+
+    assertEquals("A new CarDirection needs a glyph in garmin/om-nav/source/TurnGlyphs.mc", 17,
+                 CarDirection.values().length);
+  }
+
+  @Test
+  public void firstMessageCarriesEverything()
+  {
+    final Map<String, Object> message = state(5, "250 m", 250, "High Street", "5.2 km", 900).toMessage(null);
+
+    assertEquals(5, message.get(GarminNavState.KEY_TURN));
+    assertEquals(0, message.get(GarminNavState.KEY_EXIT));
+    assertEquals("250 m", message.get(GarminNavState.KEY_DIST_TO_TURN));
+    assertEquals(250, message.get(GarminNavState.KEY_DIST_TO_TURN_M));
+    assertEquals("High Street", message.get(GarminNavState.KEY_NEXT_STREET));
+    assertEquals("5.2 km", message.get(GarminNavState.KEY_DIST_REMAINING));
+    assertEquals(900, message.get(GarminNavState.KEY_ARRIVAL_MINUTE));
+  }
+
+  @Test
+  public void unchangedFieldsAreOmitted()
+  {
+    final GarminNavState previous = state(5, "250 m", 250, "High Street", "5.2 km", 900);
+    final Map<String, Object> message = state(5, "200 m", 200, "High Street", "5.2 km", 900).toMessage(previous);
+
+    assertEquals(200, message.get(GarminNavState.KEY_DIST_TO_TURN_M));
+    assertEquals("200 m", message.get(GarminNavState.KEY_DIST_TO_TURN));
+    assertFalse(message.containsKey(GarminNavState.KEY_TURN));
+    assertFalse(message.containsKey(GarminNavState.KEY_NEXT_STREET));
+    assertFalse(message.containsKey(GarminNavState.KEY_DIST_REMAINING));
+    assertFalse(message.containsKey(GarminNavState.KEY_ARRIVAL_MINUTE));
+  }
+
+  @Test
+  public void identicalStateProducesNothingToSend()
+  {
+    final GarminNavState previous = state(5, "250 m", 250, "High Street", "5.2 km", 900);
+    assertTrue(state(5, "250 m", 250, "High Street", "5.2 km", 900).toMessage(previous).isEmpty());
+  }
+
+  /**
+   * The arrival time is absolute, so it stays right however long the watch waits for its next message
+   * and only needs re-sending when the estimate really moves to another minute.
+   */
+  @Test
+  public void arrivalMinuteIsSentOnlyWhenItChanges()
+  {
+    final GarminNavState previous = state(5, "250 m", 250, "High Street", "5.2 km", 900);
+
+    assertFalse(state(5, "200 m", 200, "High Street", "5.2 km", 900)
+                    .toMessage(previous)
+                    .containsKey(GarminNavState.KEY_ARRIVAL_MINUTE));
+    assertEquals(901,
+                 state(5, "250 m", 250, "High Street", "5.2 km", 901)
+                     .toMessage(previous)
+                     .get(GarminNavState.KEY_ARRIVAL_MINUTE));
+  }
+
+  /**
+   * Truncated rather than rounded, to match the arrival time the phone shows in its own menu.
+   */
+  @Test
+  public void arrivalMinuteIsTheClockMinuteTheRouteEndsIn()
+  {
+    // 09:30:00 plus 25 minutes.
+    assertEquals(9 * 60 + 55, GarminNavState.arrivalMinute(9 * 3600 + 30 * 60, 25 * 60));
+    // 09:30:40 plus 25m50s lands at 09:56:30, which reads as 09:56.
+    assertEquals(9 * 60 + 56, GarminNavState.arrivalMinute(9 * 3600 + 30 * 60 + 40, 25 * 60 + 50));
+  }
+
+  @Test
+  public void arrivalMinuteWrapsPastMidnight()
+  {
+    // 23:50 plus 20 minutes.
+    assertEquals(10, GarminNavState.arrivalMinute(23 * 3600 + 50 * 60, 20 * 60));
+    // A route long enough to run past more than one midnight still lands on the right clock minute.
+    assertEquals(10, GarminNavState.arrivalMinute(23 * 3600 + 50 * 60, 20 * 60 + 2 * 24 * 3600));
+  }
+
+  /**
+   * The core reports no time at all until it has a route, and the watch must then show a blank rather
+   * than midnight.
+   */
+  @Test
+  public void arrivalMinuteIsUnknownWithoutAnEstimate()
+  {
+    assertEquals(GarminNavState.ARRIVAL_UNKNOWN, GarminNavState.arrivalMinute(9 * 3600, 0));
+    assertEquals(GarminNavState.ARRIVAL_UNKNOWN, GarminNavState.arrivalMinute(9 * 3600, -1));
+    assertTrue("The watch must be able to tell this apart from a real minute of the day",
+               GarminNavState.ARRIVAL_UNKNOWN < 0 || GarminNavState.ARRIVAL_UNKNOWN >= GarminNavState.MINUTES_PER_DAY);
+  }
+
+  @Test
+  public void turnAndExitChangesAreSent()
+  {
+    final GarminNavState previous = new GarminNavState(10, 2, "250 m", 250, "High Street", "5.2 km", 900, List.of());
+    final Map<String, Object> message =
+        new GarminNavState(11, 3, "250 m", 250, "High Street", "5.2 km", 900, List.of()).toMessage(previous);
+
+    assertEquals(11, message.get(GarminNavState.KEY_TURN));
+    assertEquals(3, message.get(GarminNavState.KEY_EXIT));
+  }
+
+  /**
+   * The watch must be able to tell arriving from cancelling, or abandoning a route half way through
+   * claims you arrived.
+   */
+  @Test
+  public void finishedMessageDistinguishesArrivalFromCancellation()
+  {
+    final Map<String, Object> arrived = GarminNavState.finished(true);
+    assertEquals(1, arrived.size());
+    assertEquals(GarminNavState.FINISHED_ARRIVED, arrived.get(GarminNavState.KEY_FINISHED));
+
+    final Map<String, Object> cancelled = GarminNavState.finished(false);
+    assertEquals(1, cancelled.size());
+    assertEquals(GarminNavState.FINISHED_CANCELLED, cancelled.get(GarminNavState.KEY_FINISHED));
+
+    assertNotEquals(GarminNavState.FINISHED_ARRIVED, GarminNavState.FINISHED_CANCELLED);
+  }
+
+  /**
+   * An active lane draws the direction you would take in it; the rest show what they are for, so you
+   * can count across. The flag has to be outside the four bits the way ordinal occupies.
+   */
+  @Test
+  public void lanesEncodeTheDirectionToDrawAndWhichLanesToBeIn()
+  {
+    final List<Integer> encoded = GarminNavState.encodeLanes(
+        new LaneInfo[] {new LaneInfo(new LaneWay[] {LaneWay.Left}, LaneWay.None),
+                        new LaneInfo(new LaneWay[] {LaneWay.Through, LaneWay.Right}, LaneWay.Right),
+                        new LaneInfo(new LaneWay[] {LaneWay.Through}, LaneWay.None)});
+
+    assertEquals(3, encoded.size());
+    assertEquals(LaneWay.Left.ordinal(), (int) encoded.get(0));
+    assertEquals(LaneWay.Right.ordinal() | GarminNavState.LANE_ACTIVE_FLAG, (int) encoded.get(1));
+    assertEquals(LaneWay.Through.ordinal(), (int) encoded.get(2));
+
+    assertTrue("The flag must not collide with a LaneWay ordinal",
+               GarminNavState.LANE_ACTIVE_FLAG > LaneWay.values().length - 1);
+  }
+
+  /**
+   * A lane that also goes straight on reads more clearly as "not yours" than whichever turn it
+   * happens to permit as well.
+   */
+  @Test
+  public void anInactiveLanePrefersThroughAsItsRepresentativeDirection()
+  {
+    final List<Integer> encoded = GarminNavState.encodeLanes(
+        new LaneInfo[] {new LaneInfo(new LaneWay[] {LaneWay.SharpRight, LaneWay.Through}, LaneWay.None)});
+
+    assertEquals(LaneWay.Through.ordinal(), (int) encoded.get(0));
+  }
+
+  @Test
+  public void absentLaneGuidanceEncodesAsEmpty()
+  {
+    assertTrue(GarminNavState.encodeLanes(null).isEmpty());
+    assertTrue(GarminNavState.encodeLanes(new LaneInfo[0]).isEmpty());
+  }
+
+  /**
+   * Lanes must be re-sent when they empty out, or the strip would linger after the turn.
+   */
+  @Test
+  public void lanesAreSentWhenTheyAppearAndWhenTheyClear()
+  {
+    final GarminNavState none = withLanes(List.of());
+    final GarminNavState some = withLanes(List.of(3, 6 | GarminNavState.LANE_ACTIVE_FLAG));
+
+    assertEquals(some.lanes, some.toMessage(none).get(GarminNavState.KEY_LANES));
+    assertEquals(none.lanes, none.toMessage(some).get(GarminNavState.KEY_LANES));
+    assertFalse(some.toMessage(some).containsKey(GarminNavState.KEY_LANES));
+  }
+
+  private static GarminNavState withLanes(List<Integer> lanes)
+  {
+    return new GarminNavState(5, 0, "250 m", 250, "High Street", "5.2 km", 900, lanes);
+  }
+
+  /**
+   * The watch buzzes based on metres, so imperial users must not get feet treated as metres.
+   */
+  @Test
+  public void distancesConvertToMeters()
+  {
+    assertEquals(250, GarminNavState.toMeters(new Distance(250.0, "250", unitIndex(Distance.Units.Meters))));
+    assertEquals(5200, GarminNavState.toMeters(new Distance(5.2, "5.2", unitIndex(Distance.Units.Kilometers))));
+    assertEquals(152, GarminNavState.toMeters(new Distance(500.0, "500", unitIndex(Distance.Units.Feet))));
+    assertEquals(1609, GarminNavState.toMeters(new Distance(1.0, "1", unitIndex(Distance.Units.Miles))));
+  }
+
+  @Test
+  public void invalidDistanceConvertsToZeroMeters()
+  {
+    assertEquals(0, GarminNavState.toMeters(new Distance(-1.0, "", unitIndex(Distance.Units.Meters))));
+  }
+
+  private static byte unitIndex(Distance.Units units)
+  {
+    return (byte) units.ordinal();
+  }
+}
diff --git a/android/libs/garmin/src/test/java/app/organicmaps/garmin/GarminSenderTest.java b/android/libs/garmin/src/test/java/app/organicmaps/garmin/GarminSenderTest.java
new file mode 100644
index 0000000000..629f724c69
--- /dev/null
+++ b/android/libs/garmin/src/test/java/app/organicmaps/garmin/GarminSenderTest.java
@@ -0,0 +1,344 @@
+package app.organicmaps.garmin;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotEquals;
+import static org.junit.Assert.assertTrue;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import org.junit.Before;
+import org.junit.Test;
+
+public class GarminSenderTest
+{
+  private final List<Map<String, Object>> mSent = new ArrayList<>();
+  private final List<Long> mTokens = new ArrayList<>();
+  private GarminSender mSender;
+
+  @Before
+  public void setUp()
+  {
+    mSender = new GarminSender((message, token) -> {
+      mSent.add(message);
+      mTokens.add(token);
+    });
+  }
+
+  private long lastToken()
+  {
+    return mTokens.get(mTokens.size() - 1);
+  }
+
+  private static GarminNavState state(int meters, int arrivalMinute)
+  {
+    return new GarminNavState(5, 0, meters + " m", meters, "High Street", "5.2 km", arrivalMinute, List.of());
+  }
+
+  private Map<String, Object> lastSent()
+  {
+    return mSent.get(mSent.size() - 1);
+  }
+
+  @Test
+  public void firstOfferIsSentImmediately()
+  {
+    mSender.offer(state(250, 900), 1000);
+
+    assertEquals(1, mSent.size());
+    assertEquals(250, lastSent().get(GarminNavState.KEY_DIST_TO_TURN_M));
+    assertTrue(mSender.isSending());
+  }
+
+  /**
+   * Garmin caps concurrent transfers, so nothing else may go out until the current one is done.
+   */
+  @Test
+  public void onlyOneTransferIsInFlight()
+  {
+    mSender.offer(state(250, 900), 1000);
+    mSender.offer(state(240, 900), 3000);
+    mSender.offer(state(230, 900), 5000);
+
+    assertEquals(1, mSent.size());
+  }
+
+  /**
+   * The pending slot holds the newest state, not a backlog, so the watch skips straight to now.
+   */
+  @Test
+  public void completionFlushesOnlyTheNewestPendingState()
+  {
+    mSender.offer(state(250, 900), 1000);
+    mSender.offer(state(240, 900), 2000);
+    mSender.offer(state(230, 900), 3000);
+
+    mSender.onSendFinished(lastToken(), true, 3000);
+
+    assertEquals(2, mSent.size());
+    assertEquals(230, lastSent().get(GarminNavState.KEY_DIST_TO_TURN_M));
+    assertTrue(mSender.isSending());
+  }
+
+  @Test
+  public void nothingIsSentWhenStateHasNotChanged()
+  {
+    mSender.offer(state(250, 900), 1000);
+    mSender.onSendFinished(lastToken(), true, 2000);
+    mSender.offer(state(250, 900), 4000);
+
+    assertEquals(1, mSent.size());
+  }
+
+  @Test
+  public void updatesWithinTheMinimumIntervalAreHeldBack()
+  {
+    mSender.offer(state(250, 900), 1000);
+    mSender.onSendFinished(lastToken(), true, 1100);
+
+    // Well inside MIN_INTERVAL_MS of the send at t=1000.
+    mSender.offer(state(240, 900), 1200);
+    assertEquals(1, mSent.size());
+
+    // Once the interval has elapsed the held-back state goes out, carrying the newest value.
+    mSender.offer(state(220, 900), 1000 + GarminSender.MIN_INTERVAL_MS);
+    assertEquals(2, mSent.size());
+    assertEquals(220, lastSent().get(GarminNavState.KEY_DIST_TO_TURN_M));
+  }
+
+  @Test
+  public void heldBackUpdatesAreCounted()
+  {
+    mSender.offer(state(250, 900), 1000);
+    mSender.onSendFinished(lastToken(), true, 1100);
+    mSender.offer(state(240, 900), 1200);
+
+    assertEquals(1, mSender.getDroppedCount());
+  }
+
+  /**
+   * A message lost in transit must not leave the watch permanently out of date, so a failed send
+   * does not advance what we believe the watch knows.
+   */
+  @Test
+  public void afterAFailedSendTheNextMessageCarriesEverythingAgain()
+  {
+    mSender.offer(state(250, 900), 1000);
+    mSender.onSendFinished(lastToken(), false, 1000 + GarminSender.MIN_INTERVAL_MS);
+
+    mSender.offer(state(240, 900), 2 * (1000 + GarminSender.MIN_INTERVAL_MS));
+
+    assertEquals(2, mSent.size());
+    assertTrue(lastSent().containsKey(GarminNavState.KEY_NEXT_STREET));
+    assertTrue(lastSent().containsKey(GarminNavState.KEY_ARRIVAL_MINUTE));
+  }
+
+  @Test
+  public void successfulSendsOmitUnchangedFields()
+  {
+    mSender.offer(state(250, 900), 1000);
+    mSender.onSendFinished(lastToken(), true, 1000 + GarminSender.MIN_INTERVAL_MS);
+    mSender.offer(state(240, 900), 1000 + GarminSender.MIN_INTERVAL_MS);
+
+    assertEquals(2, mSent.size());
+    assertFalse(lastSent().containsKey(GarminNavState.KEY_NEXT_STREET));
+    assertFalse(lastSent().containsKey(GarminNavState.KEY_ARRIVAL_MINUTE));
+  }
+
+  /**
+   * The arrival time must survive a long run of messages that do not carry it. An earlier version
+   * gated it on how far it had drifted from the last state sent, which was updated even by messages
+   * that left the arrival time out, so the reference crept along with the estimate, the tolerance was
+   * never crossed and the watch kept its first value for the whole route.
+   */
+  @Test
+  public void arrivalTimeChangesAreDeliveredHoweverManyMessagesPrecedeThem()
+  {
+    long now = 1000;
+    mSender.offer(state(1000, 900), now);
+    mSender.onSendFinished(lastToken(), true, now);
+
+    // Two minutes of driving to a schedule: the arrival time holds, the distance keeps falling.
+    for (int meters = 990; meters > 950; --meters)
+    {
+      now += GarminSender.MIN_INTERVAL_MS;
+      mSender.offer(state(meters, 900), now);
+      mSender.onSendFinished(lastToken(), true, now);
+      assertFalse(lastSent().containsKey(GarminNavState.KEY_ARRIVAL_MINUTE));
+    }
+
+    // Traffic: arrival slips by a minute, and the watch has to hear about it.
+    now += GarminSender.MIN_INTERVAL_MS;
+    mSender.offer(state(950, 901), now);
+    assertEquals(901, lastSent().get(GarminNavState.KEY_ARRIVAL_MINUTE));
+  }
+
+  /**
+   * When the watch app restarts its screen is blank, so it needs the whole picture again.
+   */
+  @Test
+  public void resetSentStateResendsEverything()
+  {
+    mSender.offer(state(250, 900), 1000);
+    mSender.onSendFinished(lastToken(), true, 1000 + GarminSender.MIN_INTERVAL_MS);
+
+    mSender.resetSentState();
+    mSender.offer(state(250, 900), 1000 + GarminSender.MIN_INTERVAL_MS);
+
+    assertEquals(2, mSent.size());
+    assertEquals(8, lastSent().size());
+  }
+
+  /**
+   * The watch app restarting mid-transfer is the common case, not a rare one: an update goes out on
+   * every location fix while a single transfer takes seconds. The transfer already on the wire was
+   * serialised against a baseline the watch has just discarded, so acknowledging it must not count
+   * as the watch knowing that state.
+   */
+  @Test
+  public void resetSentStateDuringATransferStillResendsEverything()
+  {
+    mSender.offer(state(250, 900), 1000);
+    mSender.onSendFinished(lastToken(), true, 1000);
+    // A diff: only the distance fields move.
+    mSender.offer(state(240, 900), 1000 + GarminSender.MIN_INTERVAL_MS);
+    assertEquals(2, lastSent().size());
+
+    // The watch app comes up blank and says hello while that diff is still in flight.
+    mSender.resetSentState();
+    mSender.offer(state(240, 900), 1000 + GarminSender.MIN_INTERVAL_MS);
+    assertEquals(2, mSent.size());
+
+    mSender.onSendFinished(lastToken(), true, 1000 + 2 * GarminSender.MIN_INTERVAL_MS);
+
+    assertEquals(3, mSent.size());
+    assertEquals(8, lastSent().size());
+  }
+
+  /**
+   * The resync is only over once a complete message has actually landed; a failure in between must
+   * not let the next update fall back to a diff.
+   */
+  @Test
+  public void aFailedResyncIsRetriedInFull()
+  {
+    mSender.offer(state(250, 900), 1000);
+    mSender.onSendFinished(lastToken(), true, 1000);
+
+    mSender.resetSentState();
+    mSender.offer(state(240, 900), 1000 + GarminSender.MIN_INTERVAL_MS);
+    assertEquals(8, lastSent().size());
+    mSender.onSendFinished(lastToken(), false, 1000 + GarminSender.MIN_INTERVAL_MS);
+
+    mSender.offer(state(230, 900), 1000 + 2 * GarminSender.MIN_INTERVAL_MS);
+
+    assertEquals(3, mSent.size());
+    assertEquals(8, lastSent().size());
+  }
+
+  /**
+   * Once the full picture has landed the link goes back to diffs, otherwise every update would pay
+   * for fields the watch already has.
+   */
+  @Test
+  public void diffsResumeAfterACompletedResync()
+  {
+    mSender.offer(state(250, 900), 1000);
+    mSender.onSendFinished(lastToken(), true, 1000);
+
+    mSender.resetSentState();
+    mSender.offer(state(240, 900), 1000 + GarminSender.MIN_INTERVAL_MS);
+    mSender.onSendFinished(lastToken(), true, 1000 + GarminSender.MIN_INTERVAL_MS);
+
+    mSender.offer(state(230, 900), 1000 + 2 * GarminSender.MIN_INTERVAL_MS);
+
+    assertEquals(3, mSent.size());
+    assertEquals(2, lastSent().size());
+    assertEquals(230, lastSent().get(GarminNavState.KEY_DIST_TO_TURN_M));
+  }
+
+  /**
+   * Observed on real hardware: when the watch drops off Bluetooth mid-transfer the SDK reports
+   * neither success nor failure. Before the timeout existed this deadlocked the single in-flight slot
+   * on the very first message and the watch never received another update for the whole route.
+   */
+  @Test
+  public void aTransferTheSdkNeverReportsIsAbandonedSoUpdatesResume()
+  {
+    mSender.offer(state(250, 900), 1000);
+    assertEquals(1, mSent.size());
+
+    // No onSendFinished ever arrives. Updates keep coming and stay blocked until the timeout.
+    mSender.offer(state(240, 900), 1000 + GarminSender.SEND_TIMEOUT_MS - 1);
+    assertEquals(1, mSent.size());
+    assertEquals(0, mSender.getAbandonedCount());
+
+    mSender.offer(state(230, 900), 1000 + GarminSender.SEND_TIMEOUT_MS);
+    assertEquals(2, mSent.size());
+    assertEquals(1, mSender.getAbandonedCount());
+    assertEquals(230, lastSent().get(GarminNavState.KEY_DIST_TO_TURN_M));
+  }
+
+  /**
+   * An abandoned transfer was never acknowledged, so the watch may have missed all of it.
+   */
+  @Test
+  public void theMessageAfterAnAbandonedTransferCarriesEverythingAgain()
+  {
+    mSender.offer(state(250, 900), 1000);
+    mSender.offer(state(240, 900), 1000 + GarminSender.SEND_TIMEOUT_MS);
+
+    assertEquals(2, mSent.size());
+    assertEquals(8, lastSent().size());
+  }
+
+  /**
+   * A late outcome must not be applied to whichever transfer happens to be in flight by then, or the
+   * watch would be recorded as having received a message that is still on its way.
+   */
+  @Test
+  public void anOutcomeArrivingAfterItsTransferWasAbandonedIsIgnored()
+  {
+    mSender.offer(state(250, 900), 1000);
+    final long staleToken = lastToken();
+
+    mSender.offer(state(240, 900), 1000 + GarminSender.SEND_TIMEOUT_MS);
+    assertEquals(2, mSent.size());
+
+    // The first transfer finally reports in, long after it was given up on.
+    mSender.onSendFinished(staleToken, true, 2000 + GarminSender.SEND_TIMEOUT_MS);
+
+    // The second transfer is still in flight, and its state was not credited to the watch.
+    assertTrue(mSender.isSending());
+    mSender.offer(state(230, 900), 3000 + GarminSender.SEND_TIMEOUT_MS);
+    assertEquals(2, mSent.size());
+  }
+
+  @Test
+  public void tokensAreUniquePerTransfer()
+  {
+    mSender.offer(state(250, 900), 1000);
+    final long first = lastToken();
+    mSender.onSendFinished(first, true, 1000 + GarminSender.MIN_INTERVAL_MS);
+    mSender.offer(state(240, 900), 1000 + GarminSender.MIN_INTERVAL_MS);
+
+    assertEquals(2, mSent.size());
+    assertNotEquals(first, lastToken());
+  }
+
+  @Test
+  public void resetClearsEverythingForANewSession()
+  {
+    mSender.offer(state(250, 900), 1000);
+    mSender.offer(state(240, 900), 1000);
+
+    mSender.reset();
+    assertFalse(mSender.isSending());
+    assertEquals(0, mSender.getDroppedCount());
+
+    mSender.offer(state(240, 900), 1000);
+    assertEquals(2, mSent.size());
+    assertEquals(8, lastSent().size());
+  }
+}
