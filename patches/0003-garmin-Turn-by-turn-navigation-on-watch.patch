@@ -0,0 +1,32 @@
+package app.organicmaps.routing;
+
+import androidx.annotation.NonNull;
+import app.organicmaps.sdk.routing.RoutingInfo;
+
+/**
+ * Receives live navigation state from {@link NavigationService} so it can be mirrored somewhere
+ * outside the app, e.g. onto a wearable.
+ * <p>
+ * Register an implementation with {@link NavigationService#setNavigationConsumer}. All methods are
+ * called on the UI thread, and any exception thrown is caught and logged rather than allowed to
+ * interrupt navigation, so implementations must not assume they will be retried.
+ */
+public interface NavigationConsumer
+{
+  /**
+   * Navigation has started. Acquire any resources needed to mirror the state.
+   */
+  void onNavigationStarted();
+
+  /**
+   * Called for every location update while navigating, so roughly once per GPS fix.
+   */
+  void onRoutingInfo(@NonNull RoutingInfo info);
+
+  /**
+   * Navigation has stopped. Release resources.
+   *
+   * @param arrived true if the route ran to its end, false if it was cancelled or reset part way.
+   */
+  void onNavigationStopped(boolean arrived);
+}
