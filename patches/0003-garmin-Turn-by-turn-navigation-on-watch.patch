diff --git a/garmin/om-nav/source/NavState.mc b/garmin/om-nav/source/NavState.mc
new file mode 100644
index 0000000000..7f8415ed25
--- /dev/null
+++ b/garmin/om-nav/source/NavState.mc
@@ -0,0 +1,120 @@
+import Toybox.Lang;
+import Toybox.System;
+
+//! Navigation state as most recently reported by the phone.
+//!
+//! The phone only sends fields that have changed since the last message it managed to deliver, so
+//! this merges each message into what is already here rather than replacing it. See GarminNavState
+//! in android/libs/garmin for the other half of this contract.
+module NavState {
+  // Wire keys. Single characters because the Bluetooth link to the phone carries well under
+  // 1 KB/s and every byte costs latency.
+  const KEY_TURN = "t";
+  const KEY_EXIT = "x";
+  const KEY_DIST_TO_TURN = "d";
+  const KEY_DIST_TO_TURN_M = "m";
+  const KEY_NEXT_STREET = "s";
+  const KEY_DIST_REMAINING = "r";
+  const KEY_ARRIVAL_MINUTE = "a";
+  const KEY_LANES = "l";
+  const KEY_FINISHED = "f";
+  // Values of KEY_FINISHED, mirroring GarminNavState on the phone.
+  const FINISHED_ARRIVED = 1;
+  const FINISHED_CANCELLED = 2;
+  //! Value of KEY_ARRIVAL_MINUTE while the phone has no estimate.
+  const ARRIVAL_UNKNOWN = -1;
+
+  //! Beyond this long without a message the phone has probably lost the link, so the display is
+  //! dimmed rather than left looking authoritative.
+  const STALE_MS = 12000;
+
+  var hasData as Boolean = false;
+  var finished as Boolean = false;
+
+  var turn as Number? = null;
+  var exitNum as Number = 0;
+  var distToTurn as String = "";
+  var distToTurnMetres as Number = 0;
+  var nextStreet as String = "";
+  var distToTarget as String = "";
+  //! Clock time of arrival, in minutes since local midnight. The phone works this out so that this
+  //! stays correct however long it is between messages; a remaining time would not.
+  var arrivalMinute as Number = ARRIVAL_UNKNOWN;
+  //! One entry per lane, left to right. Empty except in the run up to a turn.
+  var lanes as Array<Number> = [];
+
+  var updatedAtMs as Number = 0;
+
+  function reset() as Void {
+    hasData = false;
+    finished = false;
+    turn = null;
+    exitNum = 0;
+    distToTurn = "";
+    distToTurnMetres = 0;
+    nextStreet = "";
+    distToTarget = "";
+    arrivalMinute = ARRIVAL_UNKNOWN;
+    lanes = [];
+    updatedAtMs = 0;
+  }
+
+  function merge(data as Object?) as Void {
+    if (!(data instanceof Dictionary)) {
+      return;
+    }
+
+    var message = data as Dictionary<String, Object>;
+
+    updatedAtMs = System.getTimer();
+    hasData = true;
+
+    if (message.hasKey(KEY_FINISHED)) {
+      // Arriving earns an arrival screen. Cancelling a route half way through does not, so the watch
+      // just goes back to idle rather than claiming you got there.
+      if (message[KEY_FINISHED] == FINISHED_ARRIVED) {
+        finished = true;
+      } else {
+        reset();
+      }
+      return;
+    }
+
+    finished = false;
+
+    if (message.hasKey(KEY_TURN)) {
+      turn = message[KEY_TURN] as Number;
+    }
+    if (message.hasKey(KEY_EXIT)) {
+      exitNum = message[KEY_EXIT] as Number;
+    }
+    if (message.hasKey(KEY_DIST_TO_TURN)) {
+      distToTurn = message[KEY_DIST_TO_TURN] as String;
+    }
+    if (message.hasKey(KEY_DIST_TO_TURN_M)) {
+      distToTurnMetres = message[KEY_DIST_TO_TURN_M] as Number;
+    }
+    if (message.hasKey(KEY_NEXT_STREET)) {
+      nextStreet = message[KEY_NEXT_STREET] as String;
+    }
+    if (message.hasKey(KEY_DIST_REMAINING)) {
+      distToTarget = message[KEY_DIST_REMAINING] as String;
+    }
+    if (message.hasKey(KEY_ARRIVAL_MINUTE)) {
+      arrivalMinute = message[KEY_ARRIVAL_MINUTE] as Number;
+    }
+    if (message.hasKey(KEY_LANES)) {
+      // An empty list clears the strip once the turn is behind us. Anything that is not a list is
+      // treated the same way rather than trusted, since a bad value would crash the draw.
+      var raw = message[KEY_LANES];
+      lanes = (raw instanceof Array) ? raw as Array<Number> : [];
+    }
+  }
+
+  function isStale() as Boolean {
+    if (!hasData) {
+      return false;
+    }
+    return System.getTimer() - updatedAtMs > STALE_MS;
+  }
+}
diff --git a/garmin/om-nav/source/OmNavApp.mc b/garmin/om-nav/source/OmNavApp.mc
new file mode 100644
index 0000000000..b09026ba85
--- /dev/null
+++ b/garmin/om-nav/source/OmNavApp.mc
@@ -0,0 +1,50 @@
+import Toybox.Application;
+import Toybox.Communications;
+import Toybox.Lang;
+import Toybox.WatchUi;
+
+//! Displays turn-by-turn navigation pushed from Organic Maps on the phone.
+class OmNavApp extends Application.AppBase {
+  function initialize() {
+    AppBase.initialize();
+  }
+
+  function onStart(state as Dictionary?) as Void {
+    NavState.reset();
+    TurnAlerts.reset();
+    Communications.registerForPhoneAppMessages(method(:onPhoneMessage));
+    sayHello();
+  }
+
+  function onStop(state as Dictionary?) as Void {
+    Communications.registerForPhoneAppMessages(null);
+  }
+
+  function getInitialView() as [Views] or [Views, InputDelegates] {
+    return [new OmNavView()];
+  }
+
+  function onPhoneMessage(message as Communications.PhoneAppMessage) as Void {
+    NavState.merge(message.data);
+    TurnAlerts.update();
+    WatchUi.requestUpdate();
+  }
+
+  //! Announces this app to the phone. The phone leaves out fields that have not changed, so it needs
+  //! telling that the screen has just come up empty and the full state is wanted.
+  hidden function sayHello() as Void {
+    Communications.transmit("hello", null, new HelloListener());
+  }
+}
+
+//! Nothing useful can be done about a failed hello: the next turn update arrives regardless, and if
+//! the phone never heard us it still resends everything when it reopens the app.
+class HelloListener extends Communications.ConnectionListener {
+  function initialize() {
+    ConnectionListener.initialize();
+  }
+
+  function onComplete() as Void {}
+
+  function onError() as Void {}
+}
diff --git a/garmin/om-nav/source/OmNavView.mc b/garmin/om-nav/source/OmNavView.mc
new file mode 100644
index 0000000000..1a32689edd
--- /dev/null
+++ b/garmin/om-nav/source/OmNavView.mc
@@ -0,0 +1,225 @@
+import Toybox.Graphics;
+import Toybox.Lang;
+import Toybox.System;
+import Toybox.Timer;
+import Toybox.WatchUi;
+
+//! The navigation screen: the time now across the top, then the turn arrow, the distance to that
+//! turn, the street being turned onto, and how far and how long is left overall.
+//!
+//! Dark on white rather than the other way round. The Forerunner's display is memory-in-pixel, which
+//! reflects light instead of emitting it, so a white background is at its most legible in exactly the
+//! bright sunlight where a black one washes out.
+class OmNavView extends WatchUi.View {
+  hidden const BACKGROUND = Graphics.COLOR_WHITE;
+  hidden const FOREGROUND = Graphics.COLOR_BLACK;
+  //! For everything once the phone has gone quiet.
+  hidden const MUTED = Graphics.COLOR_DK_GRAY;
+  //! Lanes you are not being directed into.
+  hidden const LANE_INACTIVE = Graphics.COLOR_LT_GRAY;
+
+  hidden var mTimer as Timer.Timer?;
+  hidden var mWasStale as Boolean = false;
+
+  function initialize() {
+    View.initialize();
+  }
+
+  function onShow() as Void {
+    var timer = new Timer.Timer();
+    timer.start(method(:onTick), 2000, true);
+    mTimer = timer;
+  }
+
+  function onHide() as Void {
+    var timer = mTimer;
+    if (timer != null) {
+      timer.stop();
+      mTimer = null;
+    }
+  }
+
+  //! Redraws when the connection to the phone starts or stops looking healthy, and once a minute so
+  //! the clock stays honest. Turn updates request their own redraw.
+  function onTick() as Void {
+    var stale = NavState.isStale();
+    if (stale != mWasStale) {
+      mWasStale = stale;
+      WatchUi.requestUpdate();
+      return;
+    }
+
+    if (System.getClockTime().sec < 2) {
+      WatchUi.requestUpdate();
+    }
+  }
+
+  function onUpdate(dc as Dc) as Void {
+    var width = dc.getWidth();
+    var height = dc.getHeight();
+    var centreX = width / 2;
+
+    dc.setColor(FOREGROUND, BACKGROUND);
+    dc.clear();
+
+    // Drawn first, unconditionally, and never faded: the watch always knows the time, whatever the
+    // phone is or is not doing.
+    dc.setColor(FOREGROUND, Graphics.COLOR_TRANSPARENT);
+    dc.drawText(centreX, height * 6 / 100, Graphics.FONT_TINY, currentTime(), Graphics.TEXT_JUSTIFY_CENTER);
+
+    if (!NavState.hasData) {
+      drawCentredMessage(dc, WatchUi.loadResource(Rez.Strings.WaitingForPhone) as String);
+      return;
+    }
+
+    if (NavState.finished) {
+      TurnGlyphs.draw(dc, centreX, height * 45 / 100, height / 8, FOREGROUND, TurnGlyphs.REACHED_DESTINATION, 0);
+      dc.setColor(FOREGROUND, Graphics.COLOR_TRANSPARENT);
+      dc.drawText(centreX, height * 64 / 100, Graphics.FONT_MEDIUM,
+                  WatchUi.loadResource(Rez.Strings.Arrived) as String, Graphics.TEXT_JUSTIFY_CENTER);
+      return;
+    }
+
+    // Faded rather than blanked when the phone goes quiet: a stale distance is still better than
+    // nothing, as long as it does not look live.
+    var colour = NavState.isStale() ? MUTED : FOREGROUND;
+
+    // Lane guidance takes the arrow's place rather than stacking below it. The lanes you are being
+    // directed into already point the way you are going, so a separate arrow mostly repeated them,
+    // and giving the strip the whole band makes it bigger and leaves the text its full space.
+    if (NavState.lanes.size() > 0) {
+      drawLanes(dc, centreX, height * 30 / 100, height / 9, width - 20, colour);
+    } else {
+      TurnGlyphs.draw(dc, centreX, height * 30 / 100, height / 9, colour, NavState.turn, NavState.exitNum);
+    }
+
+    dc.setColor(colour, Graphics.COLOR_TRANSPARENT);
+    // A general-purpose font, not one of the FONT_NUMBER_* faces: those carry digits only and would
+    // drop the unit off "250 m".
+    dc.drawText(centreX, height * 43 / 100, Graphics.FONT_LARGE, NavState.distToTurn, Graphics.TEXT_JUSTIFY_CENTER);
+
+    drawStreet(dc, centreX, height * 60 / 100, width - 40, colour);
+
+    dc.setColor(colour, Graphics.COLOR_TRANSPARENT);
+    dc.drawText(centreX, height * 83 / 100, Graphics.FONT_TINY, footer(), Graphics.TEXT_JUSTIFY_CENTER);
+  }
+
+  //! A row of lane arrows centred on (centreX, centreY), the ones to be in picked out in the
+  //! foreground colour and the rest left pale so you can count across to yours.
+  hidden function drawLanes(dc as Dc, centreX as Number, centreY as Number, maxRadius as Number,
+                            maxWidth as Number, colour as Number) as Void {
+    var lanes = NavState.lanes;
+    var count = lanes.size();
+    if (count == 0) {
+      return;
+    }
+
+    // Whichever is tighter: the width each lane gets, or the height the band has to spare. Floored so
+    // six or seven lanes stay legible rather than shrinking away to nothing.
+    var slot = maxWidth / count;
+    var radius = (slot * 0.42).toNumber();
+    if (radius > maxRadius) {
+      radius = maxRadius;
+    }
+    if (radius < 8) {
+      radius = 8;
+    }
+    if (slot > 46) {
+      slot = 46;
+    }
+
+    var left = centreX - (slot * count) / 2 + slot / 2;
+    for (var i = 0; i < count; i++) {
+      var lane = lanes[i];
+      var laneColour = TurnGlyphs.isLaneActive(lane) ? colour : LANE_INACTIVE;
+      TurnGlyphs.drawLane(dc, left + i * slot, centreY, radius, laneColour, lane);
+    }
+  }
+
+  hidden function drawCentredMessage(dc as Dc, text as String) as Void {
+    dc.setColor(FOREGROUND, Graphics.COLOR_TRANSPARENT);
+    dc.drawText(dc.getWidth() / 2, dc.getHeight() / 2 - dc.getFontHeight(Graphics.FONT_SMALL) / 2,
+                Graphics.FONT_SMALL, text, Graphics.TEXT_JUSTIFY_CENTER);
+  }
+
+  hidden function drawStreet(dc as Dc, centreX as Number, y as Number, maxWidth as Number,
+                             colour as Number) as Void {
+    var text = NavState.nextStreet;
+    if (text.length() == 0) {
+      return;
+    }
+
+    var font = Graphics.FONT_SMALL;
+    dc.setColor(colour, Graphics.COLOR_TRANSPARENT);
+
+    if (dc.getTextWidthInPixels(text, font) <= maxWidth) {
+      dc.drawText(centreX, y, font, text, Graphics.TEXT_JUSTIFY_CENTER);
+      return;
+    }
+
+    // Two lines is the most that fits between the distance and the footer. A name too long for even
+    // that gets clipped, which beats shrinking the font past legibility.
+    var lines = splitToFit(dc, text, font, maxWidth);
+    dc.drawText(centreX, y, font, lines[0], Graphics.TEXT_JUSTIFY_CENTER);
+    dc.drawText(centreX, y + dc.getFontHeight(font), font, lines[1], Graphics.TEXT_JUSTIFY_CENTER);
+  }
+
+  //! Breaks text at the last space whose leading part still fits.
+  hidden function splitToFit(dc as Dc, text as String, font as FontType,
+                             maxWidth as Number) as Array<String> {
+    var characters = text.toCharArray();
+    var breakAt = -1;
+
+    for (var i = 0; i < characters.size(); i++) {
+      if (characters[i] != ' ') {
+        continue;
+      }
+      if (dc.getTextWidthInPixels(text.substring(0, i) as String, font) > maxWidth) {
+        break;
+      }
+      breakAt = i;
+    }
+
+    if (breakAt < 0) {
+      return [text, ""];
+    }
+    return [text.substring(0, breakAt) as String, text.substring(breakAt + 1, text.length()) as String];
+  }
+
+  hidden function footer() as String {
+    var arrival = arrivalTime();
+    if (arrival.length() == 0) {
+      return NavState.distToTarget;
+    }
+    if (NavState.distToTarget.length() == 0) {
+      return arrival;
+    }
+    return NavState.distToTarget + "   " + arrival;
+  }
+
+  hidden function currentTime() as String {
+    var now = System.getClockTime();
+    return formatClock(now.hour, now.min);
+  }
+
+  //! Clock time of arrival, as worked out by the phone and matching what it shows in its own
+  //! navigation menu.
+  hidden function arrivalTime() as String {
+    if (NavState.arrivalMinute == NavState.ARRIVAL_UNKNOWN) {
+      return "";
+    }
+
+    return formatClock(NavState.arrivalMinute / 60, NavState.arrivalMinute % 60);
+  }
+
+  hidden function formatClock(hour as Number, minute as Number) as String {
+    var displayHour = hour;
+    if (!System.getDeviceSettings().is24Hour) {
+      displayHour = hour % 12;
+      if (displayHour == 0) {
+        displayHour = 12;
+      }
+    }
+    return Lang.format("$1$:$2$", [displayHour, minute.format("%02d")]);
+  }
+}
diff --git a/garmin/om-nav/source/TurnAlerts.mc b/garmin/om-nav/source/TurnAlerts.mc
new file mode 100644
index 0000000000..4d43447a1b
--- /dev/null
+++ b/garmin/om-nav/source/TurnAlerts.mc
@@ -0,0 +1,96 @@
+import Toybox.Attention;
+import Toybox.Lang;
+import Toybox.System;
+
+//! Buzzes as a turn approaches, so the screen does not have to be watched.
+//!
+//! The decision is made here rather than on the phone because the link adds seconds of latency: the
+//! phone reports how far away the turn is, and the watch decides when that is close enough.
+module TurnAlerts {
+  const NEAR_METRES = 80;
+  const FAR_METRES = 300;
+
+  // Deliberately as gentle as Connect IQ allows: a single short tap at 25% duty cycle, which reads as
+  // a nudge rather than an alarm. Duty cycle runs 1-100, so raise DUTY to make these more insistent.
+  const DUTY = 25;
+  const TAP_MS = 80;
+  const ARRIVAL_MS = 200;
+
+  var turnKey as String? = null;
+  // How far through the escalation this turn has got: 0 nothing yet, 1 approaching, 2 imminent.
+  var level as Number = 0;
+  var arrivalAlerted as Boolean = false;
+
+  function reset() as Void {
+    turnKey = null;
+    level = 0;
+    arrivalAlerted = false;
+  }
+
+  //! Call after every state change from the phone.
+  function update() as Void {
+    if (NavState.finished) {
+      if (!arrivalAlerted) {
+        arrivalAlerted = true;
+        vibrate([new Attention.VibeProfile(DUTY, ARRIVAL_MS)]);
+      }
+      return;
+    }
+
+    arrivalAlerted = false;
+
+    var turn = NavState.turn;
+    if (!NavState.hasData || turn == null) {
+      return;
+    }
+    if (turn == TurnGlyphs.NO_TURN || turn == TurnGlyphs.GO_STRAIGHT) {
+      return;
+    }
+
+    // Identity of the turn currently being announced. Anything about it changing means we have moved
+    // on to the next one and the escalation starts again.
+    var key = turn.toString() + ":" + NavState.exitNum.toString() + ":" + NavState.nextStreet;
+    if (!key.equals(turnKey)) {
+      turnKey = key;
+      level = 0;
+    }
+
+    var metres = NavState.distToTurnMetres;
+    if (metres <= 0) {
+      return;
+    }
+
+    var reached = 0;
+    if (metres <= NEAR_METRES) {
+      reached = 2;
+    } else if (metres <= FAR_METRES) {
+      reached = 1;
+    }
+
+    // Only ever escalates, so backing away from a turn and closing on it again does not re-buzz.
+    if (reached > level) {
+      level = reached;
+      // Two taps when the turn is imminent, one when it is merely approaching: still subtle, but
+      // distinguishable without looking at the watch.
+      if (reached == 2) {
+        vibrate([new Attention.VibeProfile(DUTY, TAP_MS), new Attention.VibeProfile(0, 120),
+                 new Attention.VibeProfile(DUTY, TAP_MS)]);
+      } else {
+        vibrate([new Attention.VibeProfile(DUTY, TAP_MS)]);
+      }
+    }
+  }
+
+  function vibrate(profile as Array<VibeProfile>) as Void {
+    if (!(Toybox has :Attention) || !(Attention has :vibrate)) {
+      return;
+    }
+
+    var settings = System.getDeviceSettings();
+    if (settings has :vibrateOn && !settings.vibrateOn) {
+      return;
+    }
+
+    Attention.vibrate(profile);
+  }
+}
diff --git a/garmin/om-nav/source/TurnGlyphs.mc b/garmin/om-nav/source/TurnGlyphs.mc
new file mode 100644
index 0000000000..b7d0955446
--- /dev/null
+++ b/garmin/om-nav/source/TurnGlyphs.mc
@@ -0,0 +1,208 @@
+import Toybox.Graphics;
+import Toybox.Lang;
+import Toybox.Math;
+
+//! Draws turn arrows.
+//!
+//! Everything is drawn with primitives rather than shipped as bitmaps: the phone's turn icons are
+//! rasters sized for phone screens, and re-rendering seventeen of them for a 240x240 64-colour
+//! memory-in-pixel display would bloat the app for a worse result.
+module TurnGlyphs {
+  // CarDirection ordinals from android/sdk/src/main/java/app/organicmaps/sdk/routing/CarDirection.java.
+  // GarminNavStateTest pins these values, so they cannot drift without the Android build failing.
+  const NO_TURN = 0;
+  const GO_STRAIGHT = 1;
+  const TURN_RIGHT = 2;
+  const TURN_SHARP_RIGHT = 3;
+  const TURN_SLIGHT_RIGHT = 4;
+  const TURN_LEFT = 5;
+  const TURN_SHARP_LEFT = 6;
+  const TURN_SLIGHT_LEFT = 7;
+  const U_TURN_LEFT = 8;
+  const U_TURN_RIGHT = 9;
+  const ENTER_ROUNDABOUT = 10;
+  const LEAVE_ROUNDABOUT = 11;
+  const STAY_ON_ROUNDABOUT = 12;
+  const START_AT_END_OF_STREET = 13;
+  const REACHED_DESTINATION = 14;
+  const EXIT_HIGHWAY_LEFT = 15;
+  const EXIT_HIGHWAY_RIGHT = 16;
+
+  // Lane guidance, mirroring GarminNavState on the phone: the low four bits of each lane are a
+  // LaneWay ordinal and LANE_ACTIVE_FLAG marks the lanes to be in.
+  const LANE_ACTIVE_FLAG = 16;
+  const LANE_WAY_MASK = 15;
+
+  function isLaneActive(lane as Number) as Boolean {
+    return (lane & LANE_ACTIVE_FLAG) != 0;
+  }
+
+  //! Draws one lane's arrow. Deliberately the same arrow shape as the main turn glyph, just smaller,
+  //! so a lane pointing the way you are going is recognisably the same symbol.
+  function drawLane(dc as Dc, cx as Number, cy as Number, r as Number, colour as Number, lane as Number) as Void {
+    dc.setColor(colour, Graphics.COLOR_TRANSPARENT);
+    drawArrow(dc, cx, cy, r, laneAngleFor(lane & LANE_WAY_MASK));
+  }
+
+  //! LaneWay ordinals from android/sdk/src/main/java/app/organicmaps/sdk/routing/LaneWay.java.
+  function laneAngleFor(way as Number) as Number {
+    switch (way) {
+      case 1:  // ReverseLeft
+        return -160;
+      case 2:  // SharpLeft
+        return -125;
+      case 3:  // Left
+        return -80;
+      case 4:  // MergeToLeft
+      case 5:  // SlightLeft
+        return -35;
+      case 7:  // SlightRight
+      case 8:  // MergeToRight
+        return 35;
+      case 9:  // Right
+        return 80;
+      case 10:  // SharpRight
+        return 125;
+      case 11:  // ReverseRight
+        return 160;
+      default:  // None, Through
+        return 0;
+    }
+  }
+
+  //! Draws the glyph for a turn, centred on (cx, cy) and fitting within a radius of r.
+  function draw(dc as Dc, cx as Number, cy as Number, r as Number, colour as Number, turn as Number?,
+                exitNum as Number) as Void {
+    if (turn == null) {
+      return;
+    }
+
+    dc.setColor(colour, Graphics.COLOR_TRANSPARENT);
+
+    if (turn == ENTER_ROUNDABOUT || turn == LEAVE_ROUNDABOUT || turn == STAY_ON_ROUNDABOUT) {
+      drawRoundabout(dc, cx, cy, r, exitNum);
+    } else if (turn == U_TURN_LEFT) {
+      drawUTurn(dc, cx, cy, r, -1);
+    } else if (turn == U_TURN_RIGHT) {
+      drawUTurn(dc, cx, cy, r, 1);
+    } else if (turn == REACHED_DESTINATION) {
+      drawDestination(dc, cx, cy, r);
+    } else if (turn == EXIT_HIGHWAY_LEFT) {
+      drawHighwayExit(dc, cx, cy, r, -35);
+    } else if (turn == EXIT_HIGHWAY_RIGHT) {
+      drawHighwayExit(dc, cx, cy, r, 35);
+    } else {
+      drawArrow(dc, cx, cy, r, angleFor(turn));
+    }
+  }
+
+  //! How far to rotate the arrow, clockwise from straight up.
+  function angleFor(turn as Number) as Number {
+    if (turn == TURN_SLIGHT_RIGHT) {
+      return 35;
+    }
+    if (turn == TURN_RIGHT) {
+      return 80;
+    }
+    if (turn == TURN_SHARP_RIGHT) {
+      return 125;
+    }
+    if (turn == TURN_SLIGHT_LEFT) {
+      return -35;
+    }
+    if (turn == TURN_LEFT) {
+      return -80;
+    }
+    if (turn == TURN_SHARP_LEFT) {
+      return -125;
+    }
+    // NO_TURN, GO_STRAIGHT and START_AT_END_OF_STREET all just mean carry on.
+    return 0;
+  }
+
+  function drawArrow(dc as Dc, cx as Number, cy as Number, r as Number, degrees as Number) as Void {
+    var radians = Math.toRadians(degrees);
+    var sin = Math.sin(radians);
+    var cos = Math.cos(radians);
+
+    var tipY = -r.toFloat();
+    var barbY = -r * 0.5;
+    var barbX = r * 0.62;
+    var stemX = r * 0.2;
+    var tailY = r * 0.9;
+
+    // A solid arrow pointing up in local coordinates, rotated into place vertex by vertex. The
+    // vertices are spelled out as literal pairs rather than built by a helper because fillPolygon
+    // requires fixed-length two-element arrays, a type no function return can be declared as.
+    dc.fillPolygon([
+      [rotateX(cx, 0.0, tipY, sin, cos), rotateY(cy, 0.0, tipY, sin, cos)],
+      [rotateX(cx, barbX, barbY, sin, cos), rotateY(cy, barbX, barbY, sin, cos)],
+      [rotateX(cx, stemX, barbY, sin, cos), rotateY(cy, stemX, barbY, sin, cos)],
+      [rotateX(cx, stemX, tailY, sin, cos), rotateY(cy, stemX, tailY, sin, cos)],
+      [rotateX(cx, -stemX, tailY, sin, cos), rotateY(cy, -stemX, tailY, sin, cos)],
+      [rotateX(cx, -stemX, barbY, sin, cos), rotateY(cy, -stemX, barbY, sin, cos)],
+      [rotateX(cx, -barbX, barbY, sin, cos), rotateY(cy, -barbX, barbY, sin, cos)]
+    ]);
+  }
+
+  //! Rotates an offset about a centre. Screen coordinates grow downwards, so a positive angle turns
+  //! clockwise and "up" becomes "right", which is what angleFor assumes.
+  function rotateX(cx as Number, x as Float, y as Float, sin as Numeric, cos as Numeric) as Number {
+    return (cx + (x * cos - y * sin)).toNumber();
+  }
+
+  function rotateY(cy as Number, x as Float, y as Float, sin as Numeric, cos as Numeric) as Number {
+    return (cy + (x * sin + y * cos)).toNumber();
+  }
+
+  function drawUTurn(dc as Dc, cx as Number, cy as Number, r as Number, direction as Number) as Void {
+    var arcR = (r * 0.5).toNumber();
+    var top = (cy - r * 0.3).toNumber();
+    var upLegX = cx - direction * arcR;
+    var downLegX = cx + direction * arcR;
+    var headY = (cy + r * 0.4).toNumber();
+
+    dc.setPenWidth(5);
+    // The turn itself: a half circle joining the leg we came up to the leg heading back down.
+    dc.drawArc(cx, top, arcR, Graphics.ARC_COUNTER_CLOCKWISE, 0, 180);
+    dc.drawLine(upLegX, top, upLegX, (cy + r).toNumber());
+    dc.drawLine(downLegX, top, downLegX, headY);
+    dc.setPenWidth(1);
+
+    var half = (r * 0.3).toNumber();
+    dc.fillPolygon([[downLegX - half, headY], [downLegX + half, headY], [downLegX, headY + half + 4]]);
+  }
+
+  function drawRoundabout(dc as Dc, cx as Number, cy as Number, r as Number, exitNum as Number) as Void {
+    var ringR = (r * 0.7).toNumber();
+
+    dc.setPenWidth(4);
+    dc.drawCircle(cx, cy, ringR);
+    // The road we arrive on.
+    dc.drawLine(cx, cy + ringR, cx, (cy + r).toNumber());
+    dc.setPenWidth(1);
+
+    if (exitNum > 0) {
+      dc.drawText(cx, (cy - r * 0.5).toNumber(), Graphics.FONT_XTINY, exitNum.toString(),
+                  Graphics.TEXT_JUSTIFY_CENTER);
+    }
+  }
+
+  function drawDestination(dc as Dc, cx as Number, cy as Number, r as Number) as Void {
+    dc.setPenWidth(4);
+    dc.drawCircle(cx, cy, (r * 0.8).toNumber());
+    dc.setPenWidth(1);
+    dc.fillCircle(cx, cy, (r * 0.35).toNumber());
+  }
+
+  //! An angled arrow for the ramp, alongside a bar standing for the road that carries straight on.
+  function drawHighwayExit(dc as Dc, cx as Number, cy as Number, r as Number, degrees as Number) as Void {
+    var side = degrees > 0 ? -1 : 1;
+    drawArrow(dc, (cx + side * r * 0.2).toNumber(), cy, (r * 0.8).toNumber(), degrees);
+
+    var barX = (cx + side * r * 0.8).toNumber();
+    dc.setPenWidth(4);
+    dc.drawLine(barX, (cy - r).toNumber(), barX, (cy + r).toNumber());
+    dc.setPenWidth(1);
+  }
+}
diff --git a/garmin/tools/make_launcher_icon.py b/garmin/tools/make_launcher_icon.py
new file mode 100644
index 0000000000..b89bb14eda
--- /dev/null
+++ b/garmin/tools/make_launcher_icon.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+"""Generates the Connect IQ launcher icon for the om-nav watch app.
+
+Kept as a script rather than a checked-in binary blob nobody can edit: the icon is a plain
+right-turn arrow, and regenerating it is a one-liner.
+
+Usage: python3 garmin/tools/make_launcher_icon.py
+"""
+
+import os
+import struct
+import zlib
+
+SIZE = 40
+# Organic Maps' accent green, so the launcher entry is recognisable next to the phone app.
+ARROW = (74, 174, 76, 255)
+TRANSPARENT = (0, 0, 0, 0)
+
+OUTPUT = os.path.join(os.path.dirname(__file__), os.pardir, "om-nav", "resources", "drawables", "launcher_icon.png")
+
+
+def inside_arrow(x, y):
+    """A right-turn arrow: a vertical stem that bends right into an arrowhead."""
+    # Stem, running up the lower-left.
+    if 13 <= x <= 20 and 20 <= y <= 34:
+        return True
+    # Horizontal run into the head.
+    if 13 <= x <= 25 and 14 <= y <= 21:
+        return True
+    # Arrowhead, a triangle pointing right with its apex at (34, 17).
+    if 25 <= x <= 34:
+        half = 34 - x
+        if abs(y - 17) <= half:
+            return True
+    return False
+
+
+def main():
+    rows = []
+    for y in range(SIZE):
+        row = bytearray([0])  # PNG filter type 0 (none) per scanline.
+        for x in range(SIZE):
+            row += bytes(ARROW if inside_arrow(x, y) else TRANSPARENT)
+        rows.append(bytes(row))
+    raw = b"".join(rows)
+
+    def chunk(tag, data):
+        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
+
+    png = b"\x89PNG\r\n\x1a\n"
+    # Bit depth 8, colour type 6 (RGBA), no interlace.
+    png += chunk(b"IHDR", struct.pack(">IIBBBBB", SIZE, SIZE, 8, 6, 0, 0, 0))
+    png += chunk(b"IDAT", zlib.compress(raw, 9))
+    png += chunk(b"IEND", b"")
+
+    path = os.path.normpath(OUTPUT)
+    with open(path, "wb") as f:
+        f.write(png)
+    print("wrote %s (%d bytes)" % (path, len(png)))
+
+
+if __name__ == "__main__":
+    main()
