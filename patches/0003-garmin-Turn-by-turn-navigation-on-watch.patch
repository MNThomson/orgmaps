@@ -54,6 +54,14 @@ public class NavigationService extends Service implements LocationListener
   private static NotificationCompat.Extender sCarNotificationExtender;
   @Nullable
   private static PendingIntent sOpenAppPendingIntent;
+  @Nullable
+  private static NavigationConsumer sNavigationConsumer;
+
+  // Whether sNavigationConsumer has been told navigation started, so it is stopped exactly once.
+  private boolean mConsumerStarted;
+  // Whether the route ran to its end, as opposed to being cancelled. Only known here, because by the
+  // time the service is destroyed the routing state has already been torn down.
+  private boolean mRouteFinished;
 
   @SuppressWarnings("NotNullFieldNotInitialized")
   @NonNull
@@ -83,6 +91,65 @@ public class NavigationService extends Service implements LocationListener
     sOpenAppPendingIntent = openAppPendingIntent;
   }
 
+  /**
+   * Mirrors live navigation state outside the app, e.g. onto a wearable. Optional.
+   */
+  public static void setNavigationConsumer(@Nullable NavigationConsumer consumer)
+  {
+    sNavigationConsumer = consumer;
+  }
+
+  private void startConsumer()
+  {
+    final NavigationConsumer consumer = sNavigationConsumer;
+    if (consumer == null || mConsumerStarted)
+      return;
+
+    mConsumerStarted = true;
+    mRouteFinished = false;
+    try
+    {
+      consumer.onNavigationStarted();
+    }
+    catch (Exception e)
+    {
+      Logger.e(TAG, "NavigationConsumer failed to start", e);
+    }
+  }
+
+  private void updateConsumer(@NonNull RoutingInfo routingInfo)
+  {
+    final NavigationConsumer consumer = sNavigationConsumer;
+    if (consumer == null || !mConsumerStarted)
+      return;
+
+    try
+    {
+      consumer.onRoutingInfo(routingInfo);
+    }
+    catch (Exception e)
+    {
+      Logger.e(TAG, "NavigationConsumer failed to consume routing info", e);
+    }
+  }
+
+  private void stopConsumer()
+  {
+    final NavigationConsumer consumer = sNavigationConsumer;
+    if (consumer == null || !mConsumerStarted)
+      return;
+
+    mConsumerStarted = false;
+    try
+    {
+      consumer.onNavigationStopped(mRouteFinished);
+    }
+    catch (Exception e)
+    {
+      Logger.e(TAG, "NavigationConsumer failed to stop", e);
+    }
+  }
+
