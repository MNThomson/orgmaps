diff --git a/android/libs/garmin/src/main/java/app/organicmaps/garmin/GarminNavBridge.java b/android/libs/garmin/src/main/java/app/organicmaps/garmin/GarminNavBridge.java
new file mode 100644
index 0000000000..028be3a6c5
--- /dev/null
+++ b/android/libs/garmin/src/main/java/app/organicmaps/garmin/GarminNavBridge.java
@@ -0,0 +1,382 @@
+package app.organicmaps.garmin;
+
+import android.content.Context;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.annotation.UiThread;
+import app.organicmaps.routing.NavigationConsumer;
+import app.organicmaps.sdk.routing.RoutingInfo;
+import app.organicmaps.sdk.util.log.Logger;
+import com.garmin.android.connectiq.ConnectIQ;
+import com.garmin.android.connectiq.IQApp;
+import com.garmin.android.connectiq.IQDevice;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Mirrors turn-by-turn navigation onto a Garmin wearable running the companion Connect IQ watch app
+ * in {@code garmin/om-nav}.
+ * <p>
+ * The Connect IQ SDK talks to the watch through the Garmin Connect app, which relays messages over
+ * Bluetooth Low Energy. Every step of that chain can fail — Garmin Connect may not be installed, the
+ * watch may be out of range, the watch app may not be running — so nothing here is allowed to
+ * propagate an error back into navigation. Failures are logged and the phone carries on.
+ * <p>
+ * The SDK is only initialised while navigating, so there is no cost the rest of the time.
+ */
+@UiThread
+public final class GarminNavBridge implements NavigationConsumer, GarminSender.Transport
+{
+  private static final String TAG = GarminNavBridge.class.getSimpleName();
+
+  /**
+   * Identifier of the watch app. Must match the {@code id} attribute in
+   * {@code garmin/om-nav/manifest.xml} or messages go nowhere.
+   */
+  public static final String WATCH_APP_ID = "ccd878c4caac4a24860ad3dde1f95af7";
+
+  /**
+   * How long to leave the SDK up after navigation ends, so the final "arrived" message has a chance
+   * to reach the watch before the connection is torn down. Sends take seconds over BLE.
+   */
+  private static final long SHUTDOWN_DELAY_MS = 3000;
+
+  /**
+   * How often to look again when no watch was available at the start of a route. A watch that is
+   * asleep or out of range at that moment would otherwise never be picked up.
+   */
+  private static final long DEVICE_RETRY_MS = 10000;
+
+  @NonNull
+  private final Context mContext;
+  @NonNull
+  private final Handler mHandler = new Handler(Looper.getMainLooper());
+  @NonNull
+  private final GarminSender mSender = new GarminSender(this);
+  @NonNull
+  private final IQApp mWatchApp = new IQApp(WATCH_APP_ID);
+
+  @Nullable
+  private ConnectIQ mConnectIQ;
+  // The watch we are sending to. Null unless it is actually connected.
+  @Nullable
+  private IQDevice mDevice;
+  // The watch whose events we are subscribed to, connected or not.
+  @Nullable
+  private IQDevice mRegisteredDevice;
+  @Nullable
+  private GarminNavState mLastState;
+  private boolean mActive;
+  // Whether the watch is reachable. Driven by device events and by the watch answering, never by
+  // IQDevice.getStatus(), which reports UNKNOWN for a known device even while it is connected.
+  private boolean mConnected;
+  private boolean mLoggedFirstSend;
+  // Whether the watch has already been asked to open the app on this connection. Asking prompts the
+  // user on the watch, so it must happen once per connection rather than on every retry or event.
+  private boolean mOpenRequested;
+
+  public GarminNavBridge(@NonNull Context context)
+  {
+    // Deliberately cheap: no SDK work until navigation actually starts.
+    mContext = context.getApplicationContext();
+  }
+
+  @Override
+  public void onNavigationStarted()
+  {
+    Logger.i(TAG, "Starting Garmin bridge");
+
+    // Cancels a shutdown still pending from the previous route.
+    mHandler.removeCallbacksAndMessages(null);
+    mActive = true;
+    mLastState = null;
+    mConnected = false;
+    mLoggedFirstSend = false;
+    mOpenRequested = false;
+    mSender.reset();
+
+    if (mConnectIQ != null)
+    {
+      // Navigation restarted before the previous session's shutdown ran, so the SDK is still up.
+      // Initializing it twice is not allowed; just find the watch again.
+      selectDevice();
+      return;
+    }
+
+    try
+    {
+      mConnectIQ = ConnectIQ.getInstance(mContext, ConnectIQ.IQConnectType.WIRELESS);
+      // autoUI is off: the SDK's error dialogs cannot be shown from a Service, and a missing Garmin
+      // Connect app is not worth interrupting navigation over.
+      mConnectIQ.initialize(mContext, false, mSdkListener);
+    }
+    catch (Exception e)
+    {
+      Logger.e(TAG, "Failed to initialize Connect IQ", e);
+      mConnectIQ = null;
+    }
+  }
+
+  @Override
+  public void onRoutingInfo(@NonNull RoutingInfo info)
+  {
+    if (!mActive)
+      return;
+
+    mLastState = GarminNavState.from(mContext, info);
+    if (mConnected)
+      mSender.offer(mLastState, SystemClock.elapsedRealtime());
+  }
+
+  @Override
+  public void onNavigationStopped(boolean arrived)
+  {
+    Logger.i(TAG, "Stopping Garmin bridge, " + (arrived ? "arrived" : "cancelled") + ", dropped "
+                      + mSender.getDroppedCount() + " updates, abandoned " + mSender.getAbandonedCount()
+                      + " transfers");
+
+    mActive = false;
+    mLastState = null;
+
+    // Tell the watch the route is over so it stops showing a frozen countdown. Sent directly rather
+    // than through GarminSender, which throttles and may be mid-transfer. Token 0 is never issued by
+    // the sender, so its outcome is correctly ignored there.
+    sendMessage(GarminNavState.finished(arrived), 0);
+
+    // Give that message time to land before pulling the connection down.
+    mHandler.postDelayed(this::shutdown, SHUTDOWN_DELAY_MS);
+  }
+
+  @Override
+  public void send(@NonNull Map<String, Object> message, long token)
+  {
+    if (!sendMessage(message, token))
+      mHandler.post(() -> mSender.onSendFinished(token, false, SystemClock.elapsedRealtime()));
+  }
+
+  private boolean sendMessage(@NonNull Map<String, Object> message, long token)
+  {
+    final ConnectIQ connectIQ = mConnectIQ;
+    final IQDevice device = mDevice;
+    if (connectIQ == null || device == null || !mConnected)
+      return false;
+
+    if (!mLoggedFirstSend)
+      Logger.i(TAG, "Sending first update to the watch: " + message);
+
+    try
+    {
+      // A listener per send so the outcome can be matched to the transfer it belongs to. Without
+      // that, an outcome arriving after its transfer was timed out would be applied to whichever
+      // transfer happened to be in flight by then.
+      connectIQ.sendMessage(device, mWatchApp, message, (d, a, status) -> mHandler.post(() -> {
+        final boolean success = status == ConnectIQ.IQMessageStatus.SUCCESS;
+        if (!success)
+          Logger.w(TAG, "Send to watch failed: " + status);
+        else if (!mLoggedFirstSend)
+        {
+          mLoggedFirstSend = true;
+          Logger.i(TAG, "First update reached the watch");
+        }
+        mSender.onSendFinished(token, success, SystemClock.elapsedRealtime());
+      }));
+      return true;
+    }
+    catch (Exception e)
+    {
+      Logger.w(TAG, "Failed to send message to watch", e);
+      return false;
+    }
+  }
+
+  private void shutdown()
+  {
+    final ConnectIQ connectIQ = mConnectIQ;
+    final IQDevice device = mRegisteredDevice;
+    mConnectIQ = null;
+    mDevice = null;
+    mRegisteredDevice = null;
+    mSender.reset();
+
+    if (connectIQ == null)
+      return;
+
+    try
+    {
+      if (device != null)
+        connectIQ.unregisterForEvents(device);
+      connectIQ.shutdown(mContext);
+    }
+    catch (Exception e)
+    {
+      Logger.w(TAG, "Failed to shut down Connect IQ", e);
+    }
+  }
+
+  /**
+   * Picks a watch to talk to, preferring one that is already connected. If none is, the first known
+   * device is watched instead so that plugging in or waking a watch mid-route still works.
+   */
+  private void selectDevice()
+  {
+    mHandler.removeCallbacks(mSelectDevice);
+
+    final ConnectIQ connectIQ = mConnectIQ;
+    if (connectIQ == null || !mActive)
+      return;
+
+    try
+    {
+      IQDevice device = firstConnected(connectIQ.getConnectedDevices());
+      if (device == null)
+      {
+        final List<IQDevice> known = connectIQ.getKnownDevices();
+        device = known == null || known.isEmpty() ? null : known.get(0);
+      }
+
+      if (device == null)
+      {
+        Logger.w(TAG, "No Garmin device available, retrying in " + DEVICE_RETRY_MS + "ms");
+        mHandler.postDelayed(mSelectDevice, DEVICE_RETRY_MS);
+        return;
+      }
+
+      // Registered whatever its status, so a watch that wakes or comes back into range reports in.
+      if (mRegisteredDevice == null || mRegisteredDevice.getDeviceIdentifier() != device.getDeviceIdentifier())
+      {
+        connectIQ.registerForEvents(device, mDeviceListener, mWatchApp, mAppListener);
+        mRegisteredDevice = device;
+      }
+
+      Logger.i(TAG, "Garmin device " + device.getFriendlyName() + " reports " + device.getStatus());
+      mDevice = device;
+      // Only ever upgrades. A queried status of UNKNOWN does not mean the watch is unreachable, so it
+      // must not clear a connection that an event or a reply has already established.
+      mConnected = mConnected || device.getStatus() == IQDevice.IQDeviceStatus.CONNECTED;
+
+      // Doubles as a reachability test: any reply means Garmin Connect got through to the watch,
+      // which is far more dependable than the status it reports for a known device.
+      openWatchApp();
+
+      if (!mConnected)
+        mHandler.postDelayed(mSelectDevice, DEVICE_RETRY_MS);
+    }
+    catch (Exception e)
+    {
+      Logger.e(TAG, "Failed to select a Garmin device", e);
+      mHandler.postDelayed(mSelectDevice, DEVICE_RETRY_MS);
+    }
+  }
+
+  private final Runnable mSelectDevice = this::selectDevice;
+
+  private void openWatchApp()
+  {
+    final ConnectIQ connectIQ = mConnectIQ;
+    final IQDevice device = mDevice;
+    if (connectIQ == null || device == null || mOpenRequested)
+      return;
+
+    mOpenRequested = true;
+    try
+    {
+      connectIQ.openApplication(device, mWatchApp, mOpenListener);
+    }
+    catch (Exception e)
+    {
+      Logger.w(TAG, "Failed to open the watch app", e);
+    }
+  }
+
+  @Nullable
+  private static IQDevice firstConnected(@Nullable List<IQDevice> devices)
+  {
+    if (devices == null)
+      return null;
+
+    for (final IQDevice device : devices)
+      if (device.getStatus() == IQDevice.IQDeviceStatus.CONNECTED)
+        return device;
+    return null;
+  }
+
+  /**
+   * Sends the whole state again. The watch merges each message into what it already has, so it needs
+   * a complete picture whenever its screen has been reset.
+   */
+  private void resynchronise()
+  {
+    mSender.resetSentState();
+    if (mLastState != null)
+      mSender.offer(mLastState, SystemClock.elapsedRealtime());
+  }
+
+  private final ConnectIQ.ConnectIQListener mSdkListener = new ConnectIQ.ConnectIQListener() {
+    @Override
+    public void onSdkReady()
+    {
+      Logger.i(TAG, "Connect IQ ready");
+      mHandler.post(GarminNavBridge.this::selectDevice);
+    }
+
+    @Override
+    public void onInitializeError(ConnectIQ.IQSdkErrorStatus status)
+    {
+      // Most likely Garmin Connect is missing or too old. Navigation is unaffected.
+      Logger.w(TAG, "Connect IQ unavailable: " + status);
+      mConnectIQ = null;
+    }
+
+    @Override
+    public void onSdkShutDown()
+    {
+      Logger.i(TAG, "Connect IQ shut down");
+      mDevice = null;
+    }
+  };
+
+  private final ConnectIQ.IQDeviceEventListener mDeviceListener = (device, status) -> mHandler.post(() -> {
+    Logger.i(TAG, "Garmin device status " + status);
+    // Events are authoritative about the connection, unlike IQDevice.getStatus().
+    mConnected = status == IQDevice.IQDeviceStatus.CONNECTED;
+    if (mConnected)
+    {
+      mDevice = device;
+      mHandler.removeCallbacks(mSelectDevice);
+      // The watch app is not running after a reconnect, so bring it back up.
+      openWatchApp();
+    }
+    else
+    {
+      // A fresh connection may need the app opening again, so allow one more request.
+      mOpenRequested = false;
+    }
+  });
+
+  private final ConnectIQ.IQOpenApplicationListener mOpenListener = (device, app, status) -> mHandler.post(() -> {
+    Logger.i(TAG, "Open watch app: " + status);
+    // PROMPT_NOT_SHOWN_ON_DEVICE is the case where the watch launched the app without asking, which
+    // is what a remembered "Always" looks like. It counts as reached, not as a failure.
+    if (status == ConnectIQ.IQOpenApplicationStatus.PROMPT_SHOWN_ON_DEVICE
+        || status == ConnectIQ.IQOpenApplicationStatus.PROMPT_NOT_SHOWN_ON_DEVICE
+        || status == ConnectIQ.IQOpenApplicationStatus.APP_IS_ALREADY_RUNNING)
+    {
+      // The watch answered, so it is reachable no matter what status was reported for it.
+      mConnected = true;
+      mHandler.removeCallbacks(mSelectDevice);
+      resynchronise();
+    }
+  });
+
+  private final ConnectIQ.IQApplicationEventListener mAppListener =
+      (device, app, messages, status) -> mHandler.post(() -> {
+    // The watch app says hello when it starts, which is our cue that its screen is blank.
+    Logger.i(TAG, "Watch app sent " + (messages == null ? 0 : messages.size()) + " message(s), status " + status);
+    mConnected = true;
+    mHandler.removeCallbacks(mSelectDevice);
+    resynchronise();
+  });
+}
